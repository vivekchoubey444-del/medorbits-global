
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#641e35">
  <meta name="description" content="Continue securely to the MedOrbits password-change page.">
  <meta http-equiv="refresh" content="0; url=/account/change-password.html">
  <meta name="robots" content="noindex, follow">

  <title>Change Password | MedOrbits</title>

  <link rel="canonical" href="https://medorbits.in/account/change-password.html">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: light;
      --brand-burgundy: #641e35;
      --brand-burgundy-dark: #421323;
      --brand-gold: #c9a66b;
      --surface: #f4e8e3;
      --surface-card: #fff8f1;
      --text: #30242a;
      --muted: #65565c;
      --border: #e5cfc5;
      --shadow: 0 24px 70px rgb(65 30 45 / 14%);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      min-height: 100%;
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      min-height: 100svh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 24px;
      overflow-x: hidden;
      background:
        radial-gradient(ellipse at 12% 10%, rgb(201 166 107 / 22%), transparent 38%),
        radial-gradient(ellipse at 90% 88%, rgb(100 30 53 / 12%), transparent 36%),
        linear-gradient(135deg, #f8f0eb 0%, var(--surface) 48%, #ead9d1 100%);
      color: var(--text);
      font-family: "DM Sans", Arial, sans-serif;
      line-height: 1.7;
    }

    .page-shell {
      width: 100%;
      max-width: 560px;
      animation: enter 650ms ease-out both;
    }

    .brand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 11px;
      margin-bottom: 22px;
      color: var(--brand-burgundy);
      font-size: 1.12rem;
      font-weight: 700;
      letter-spacing: 0.07em;
    }

    .brand-mark {
      display: grid;
      width: 42px;
      height: 42px;
      place-items: center;
      border: 1px solid rgb(201 166 107 / 65%);
      border-radius: 13px;
      background: linear-gradient(145deg, var(--brand-burgundy), var(--brand-burgundy-dark));
      color: #f5dba9;
      font-family: "Playfair Display", Georgia, serif;
      font-size: 1.55rem;
      box-shadow: 0 7px 18px rgb(65 30 45 / 18%);
    }

    main {
      position: relative;
      padding: clamp(28px, 7vw, 46px);
      overflow: hidden;
      text-align: center;
      background: rgb(255 248 241 / 94%);
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(12px);
    }

    main::before {
      position: absolute;
      top: 0;
      left: 12%;
      width: 76%;
      height: 3px;
      content: "";
      background: linear-gradient(90deg, transparent, var(--brand-gold), transparent);
    }

    .icon-wrap {
      display: grid;
      width: 76px;
      height: 76px;
      place-items: center;
      margin: 0 auto 24px;
      border: 1px solid #e5d0b1;
      border-radius: 24px;
      background: linear-gradient(145deg, #f6e9d5, #f0d9bd);
      color: var(--brand-burgundy);
    }

    .icon-wrap svg {
      width: 34px;
      height: 34px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.8;
    }

    .eyebrow {
      margin: 0 0 8px;
      color: #896b46;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0 0 14px;
      color: var(--brand-burgundy);
      font-family: "Playfair Display", Georgia, serif;
      font-size: clamp(1.85rem, 6vw, 2.6rem);
      font-weight: 600;
      line-height: 1.2;
      text-wrap: balance;
    }

    p {
      margin: 0 auto 25px;
      max-width: 410px;
      color: var(--muted);
      font-size: 0.97rem;
    }

    .progress {
      width: 100%;
      height: 4px;
      margin: 0 auto 24px;
      overflow: hidden;
      border-radius: 99px;
      background: #eadbd3;
    }

    .progress-bar {
      width: 35%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--brand-burgundy), var(--brand-gold));
      animation: progress 1.6s ease-in-out infinite;
    }

    .continue-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 50px;
      padding: 13px 23px;
      border: 1px solid var(--brand-burgundy);
      border-radius: 10px;
      background: linear-gradient(135deg, var(--brand-burgundy), var(--brand-burgundy-dark));
      color: #fff8f1;
      font-size: 0.94rem;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 8px 20px rgb(65 19 35 / 16%);
      transition: transform 180ms ease, box-shadow 180ms ease;
    }

    .continue-link svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 2;
    }

    .continue-link:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgb(65 19 35 / 23%);
    }

    .continue-link:focus-visible {
      outline: 3px solid var(--brand-gold);
      outline-offset: 4px;
    }

    .security-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 25px;
      color: #76665e;
      font-size: 0.79rem;
    }

    .security-note svg {
      width: 16px;
      height: 16px;
      flex: 0 0 auto;
      fill: none;
      stroke: #806344;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.7;
    }

    footer {
      padding: 20px 8px 0;
      color: #78666c;
      font-size: 0.78rem;
      text-align: center;
    }

    footer a {
      color: var(--brand-burgundy);
      font-weight: 600;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    @keyframes enter {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes progress {
      0% { transform: translateX(-120%); }
      100% { transform: translateX(390%); }
    }

    @media (max-width: 420px) {
      body {
        padding: 16px;
      }

      main {
        border-radius: 19px;
      }

      .icon-wrap {
        width: 66px;
        height: 66px;
        border-radius: 20px;
      }

      .continue-link {
        width: 100%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation: none !important;
        scroll-behavior: auto !important;
        transition: none !important;
      }
    }
  </style>
</head>

<body>
  <div class="page-shell">
    <div class="brand" aria-label="MedOrbits">
      <span class="brand-mark" aria-hidden="true">M</span>
      <span>MEDORBITS</span>
    </div>

    <main>
      <div class="icon-wrap" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <rect x="4" y="10" width="16" height="11" rx="2"></rect>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
          <path d="M12 14v3"></path>
        </svg>
      </div>

      <p class="eyebrow">Account security</p>
      <h1>Change Your Password</h1>

      <p>
        You are being redirected to the secure MedOrbits password-change
        page. If the page does not open automatically, use the button below.
      </p>

      <div class="progress" aria-hidden="true">
        <div class="progress-bar"></div>
      </div>

      <a class="continue-link" href="/account/change-password.html">
        Continue securely
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>

      <div class="security-note">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        Secure account access
      </div>
    </main>

    <footer>
      Need help?
      <a href="/contact.html">Contact MedOrbits Support</a>
    </footer>
  </div>
</body>
</html>
