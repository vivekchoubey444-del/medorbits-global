
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <meta
    http-equiv="refresh"
    content="0; url=/account/change-password.html"
  >

  <title>Change Password | MedOrbits</title>

  <meta
    name="description"
    content="Continue to the MedOrbits password-change page."
  >

  <link
    rel="canonical"
    href="https://medorbits.in/account/change-password.html"
  >

  <meta name="robots" content="noindex, follow">

  <style>
    :root {
      color-scheme: light;
      --brand-burgundy: #641e35;
      --brand-gold: #c9a66b;
      --surface: #f8f1ed;
      --text: #30242a;
      --muted: #65565c;
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 24px;
      background: var(--surface);
      color: var(--text);
      font-family: "DM Sans", Arial, sans-serif;
      line-height: 1.6;
    }

    main {
      width: 100%;
      max-width: 520px;
      padding: 36px 28px;
      text-align: center;
      background: #fffaf6;
      border: 1px solid #e8d8d0;
      border-radius: 18px;
      box-shadow: 0 12px 36px rgb(65 30 45 / 8%);
    }

    h1 {
      margin: 0 0 12px;
      color: var(--brand-burgundy);
      font-family: "Playfair Display", Georgia, serif;
      font-size: clamp(1.7rem, 5vw, 2.2rem);
      line-height: 1.2;
    }

    p {
      margin: 0 0 22px;
      color: var(--muted);
    }

    a {
      display: inline-block;
      padding: 12px 22px;
      border-radius: 8px;
      background: var(--brand-burgundy);
      color: #fff;
      font-weight: 600;
      text-decoration: none;
    }

    a:hover {
      background: #4d1729;
    }

    a:focus-visible {
      outline: 3px solid var(--brand-gold);
      outline-offset: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>

<body>
  <main>
    <h1>Change Your Password</h1>

    <p>
      You are being redirected to the MedOrbits password-change page.
      If you are not redirected automatically, continue using the link below.
    </p>

    <a href="/account/change-password.html">
      Continue to Change Password
    </a>
  </main>
</body>
</html>
