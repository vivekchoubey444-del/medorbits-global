
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": "MedOrbits",
  "runtime": {
    "platform": "Node.js",
    "minimumNodeVersion": "20.19.0",
    "versionSource": [
      "package.json:engines.node",
      ".nvmrc"
    ],
    "packageManager": "npm",
    "packageManifest": "package.json",
    "lockfile": "package-lock.json",
    "nodeVersionFile": ".nvmrc",
    "environmentTemplate": ".env.example",
    "entryPoints": {
      "server": {
        "path": "server.js",
        "purpose": "Production HTTP server bootstrap",
        "status": "planned"
      },
      "application": {
        "path": "src/app.js",
        "purpose": "Express application construction and middleware/route registration",
        "status": "planned"
      },
      "frontend": {
        "path": "index.html",
        "purpose": "Public website entry page",
        "status": "planned"
      }
    },
    "startupPolicy": {
      "singleDocumentedProductionCommand": true,
      "entryPointMustBeVerified": true,
      "frontendServingStrategyMustBeDocumented": true,
      "environmentVariablesMustBeValidated": true,
      "runtimeVersionMustMatchDeployment": true,
      "lockfileMustMatchPackageManifest": true,
      "productionDependenciesMustBeDeclared": true,
      "secretsMustNotBeCommitted": true,
      "startupMustFailOnInvalidConfiguration": true
    },
    "verification": {
      "checkNodeVersion": "node --version",
      "checkNpmVersion": "npm --version",
      "installDependencies": "npm ci",
      "runTests": "npm test",
      "productionStart": "npm start"
    }
  }
}
