# Netlify headers file template.
# Copy to the published site root as `_headers` only if Netlify serves this site.
# Replace paths/origins and test CSP in report-only mode before enforcement.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

# Enable HSTS only after confirming HTTPS on every covered hostname.
# Strict-Transport-Security: max-age=86400

# CSP REPORT-ONLY STARTER — replace example origins and test before enabling.
# Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' https:; connect-src 'self' https://YOUR-API-HOST; upgrade-insecure-requests
