
# ==============================================================================
# MedOrbits -- HTTP Headers and Security Policy
# File: /__headers
# Format: Netlify-compatible headers configuration
# Release: 2.1.1
# ==============================================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  X-XSS-Protection: 0

# ------------------------------------------------------------------------------
# Root route
# ------------------------------------------------------------------------------

/
  Cache-Control: no-cache
  X-Robots-Tag: index, follow

# ------------------------------------------------------------------------------
# Static assets
# Use immutable only for content-hashed filenames.
# ------------------------------------------------------------------------------

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/assets/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# ------------------------------------------------------------------------------
# HTML pages
# ------------------------------------------------------------------------------

/*.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Robots-Tag: index, follow

/**/*.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Robots-Tag: index, follow

# ------------------------------------------------------------------------------
# Public static JSON only
# Never publish secrets or private user data in static JSON files.
# ------------------------------------------------------------------------------

/*.json
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/**/*.json
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# ------------------------------------------------------------------------------
# API endpoints
# ------------------------------------------------------------------------------

/api/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

# ------------------------------------------------------------------------------
# Sitemap and crawler directives
# ------------------------------------------------------------------------------

/sitemap.xml
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/robots.txt
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# ------------------------------------------------------------------------------
# Error and offline pages
# ------------------------------------------------------------------------------

/404.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow

/offline.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow
