
# ==============================================================================
# MedOrbits -- HTTP Headers and Security Policy
# File: /__headers
# Format: Netlify-compatible headers configuration
# Release: 2.1.0
#
# Purpose:
#   Apply baseline security headers, route-specific cache controls,
#   and crawler directives for static content.
#
# Deployment:
#   Ensure this file is deployed at the published site root.
# ==============================================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  X-XSS-Protection: 0

# ------------------------------------------------------------------------------
# Root route
# ------------------------------------------------------------------------------

/
  Cache-Control: no-cache
  X-Robots-Tag: index, follow

# ------------------------------------------------------------------------------
# Static assets
# Use shorter caching unless filenames are content-fingerprinted.
# ------------------------------------------------------------------------------

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/assets/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# ------------------------------------------------------------------------------
# HTML pages
# ------------------------------------------------------------------------------

/*.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Robots-Tag: index, follow

/**/*.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Robots-Tag: index, follow

# ------------------------------------------------------------------------------
# JSON data
# These rules are for public static JSON, not private application data.
# ------------------------------------------------------------------------------

/*.json
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/**/*.json
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# ------------------------------------------------------------------------------
# API endpoints
# ------------------------------------------------------------------------------

/api/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

# ------------------------------------------------------------------------------
# Sitemap and crawler directives
# ------------------------------------------------------------------------------

/sitemap.xml
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/robots.txt
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# ------------------------------------------------------------------------------
# Error pages
# ------------------------------------------------------------------------------

/404.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow

/offline.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow
