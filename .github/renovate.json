
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "MedOrbits dependency automation and supply-chain maintenance",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separateMajorReleases",
    ":enablePreCommit"
  ],
  "timezone": "Asia/Kolkata",
  "schedule": [
    "* 3-5 * * 1"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 8,
  "branchConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "labels": [
    "dependencies",
    "automated"
  ],
  "assigneesFromCodeOwners": true,
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "MedOrbits Dependency Dashboard",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "dependencies"
    ],
    "assignees": [],
    "automerge": false,
    "vulnerabilityFixStrategy": "lowest",
    "prConcurrentLimit": 5,
    "commitMessageSuffix": "[SECURITY]"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 4-5 * * 1"
    ],
    "automerge": false,
    "labels": [
      "dependencies",
      "lockfile"
    ]
  },
  "packageRules": [
    {
      "description": "Group non-major root npm production updates",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "package.json",
        "package-lock.json"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "root npm production dependencies",
      "addLabels": [
        "javascript",
        "production"
      ]
    },
    {
      "description": "Group non-major root npm development updates",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "package.json",
        "package-lock.json"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "root npm development dependencies",
      "addLabels": [
        "javascript",
        "development"
      ]
    },
    {
      "description": "Group non-major backend npm production updates",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "server/package.json",
        "server/package-lock.json"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "backend npm production dependencies",
      "addLabels": [
        "backend",
        "production"
      ]
    },
    {
      "description": "Group non-major backend npm development updates",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "server/package.json",
        "server/package-lock.json"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "backend npm development dependencies",
      "addLabels": [
        "backend",
        "development"
      ]
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "GitHub Actions",
      "addLabels": [
        "github-actions",
        "ci"
      ]
    },
    {
      "description": "Group Python dependency updates",
      "matchManagers": [
        "pip_requirements",
        "pep621",
        "poetry",
        "pipenv",
        "pip_setup",
        "setup-cfg"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Python dependencies",
      "addLabels": [
        "python"
      ]
    },
    {
      "description": "Group Dockerfile and Docker Compose image updates",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "Docker dependencies",
      "addLabels": [
        "docker"
      ]
    },
    {
      "description": "Keep major updates separate for careful review",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "addLabels": [
        "breaking-change",
        "review-required"
      ],
      "automerge": false
    },
    {
      "description": "Never automatically merge dependency updates",
      "matchManagers": [
        "npm",
        "github-actions",
        "pip_requirements",
        "pep621",
        "poetry",
        "pipenv",
        "pip_setup",
        "setup-cfg",
        "dockerfile",
        "docker-compose"
      ],
      "automerge": false
    }
  ]
}
