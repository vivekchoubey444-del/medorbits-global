
{
  "metadata": {
    "schemaVersion": "1.1.0",
    "dataset": "jobs",
    "description": "Official recruitment destinations, government employment portals, institutional career pages and verified-source career discovery routes for India. Portal records do not imply that vacancies are currently open.",
    "defaultCountryCode": "IN",
    "currency": "INR",
    "dateFormat": "YYYY-MM-DD",
    "generatedOn": "2026-10-24",
    "verificationPolicy": "Verify portal ownership, current recruitment notifications, application URLs, eligibility, deadlines and fees against the relevant official source before publication or reliance.",
    "recordPolicy": {
      "vacancyStatus": "Portal references must not be presented as live vacancies.",
      "deadline": "Use null unless a specific recruitment notice establishes the deadline.",
      "salaryINR": "Use null unless a specific official notice establishes the salary or pay scale.",
      "verificationStatus": "official-portal-reference means the destination is intended as an official source; it does not mean a live vacancy or every linked page has been independently verified.",
      "lastVerified": "Date on which the portal or specific notice was actually checked. Use null when verification has not been performed.",
      "applicationUrl": "Use the official recruitment page where known, otherwise the official organizational portal.",
      "vacancyNoticeUrl": "Use only for an individually verified recruitment notification."
    },
    "notes": [
      "These records are recruitment destinations, not individual job advertisements.",
      "Do not invent vacancy counts, job titles, eligibility, salaries, application fees or deadlines.",
      "Check recruitment notices for qualifications, age limits, reservations, experience and selection procedures.",
      "Use null for unavailable or unverified information.",
      "External URLs must be checked before being published as application destinations.",
      "Never imply that MedOrbits is affiliated with a government department or recruiting organization unless formally authorized.",
      "Warn applicants to avoid fraudulent recruitment websites, unofficial payment requests and forged appointment letters."
    ],
    "categories": [
      "general-employment",
      "central-government",
      "medical-healthcare",
      "education-research",
      "banking-finance",
      "railways",
      "defence",
      "public-sector",
      "technical-engineering",
      "state-government",
      "employment-services"
    ]
  },
