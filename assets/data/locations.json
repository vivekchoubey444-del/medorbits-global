
{
  "metadata": {
    "schemaVersion": "1.1.0",
    "dataset": "locations",
    "description": "Indian education, healthcare, employment, technology, government recruitment and professional destination cities for MedOrbits directory filters and location-based discovery.",
    "defaultCountryCode": "IN",
    "currency": "INR",
    "dateFormat": "YYYY-MM-DD",
    "generatedOn": "2026-10-24",
    "verificationPolicy": "Verify institution addresses, recruitment locations, campus locations and time-sensitive destination details against official sources before relying on them.",
    "notes": [
      "Records represent cities and urban destinations, not guaranteed availability of colleges, courses, jobs or services.",
      "State and union territory names are provided for directory filtering and geographic grouping.",
      "Region labels are broad geographic groupings for navigation and are not administrative divisions.",
      "Unique lowercase hyphenated IDs are intended for URLs, JSON relationships and frontend filters.",
      "Do not interpret a city record as proof that a particular institution or employer has a campus or vacancy there.",
      "Use official institution, employer and government records to verify individual addresses and opportunities.",
      "Additional cities can be added without changing the existing record structure."
    ],
    "supportedFilters": [
      "city",
      "state",
      "countryCode",
      "region"
    ],
    "regions": [
      "North India",
      "South India",
      "East India",
      "West India",
      "Central India",
      "North-East India"
    ]
  },
