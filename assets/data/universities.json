
{
  "metadata": {
    "schemaVersion": "1.1.0",
    "dataset": "universities",
    "description": "Indian and international university references for MedOrbits course discovery, college discovery, admissions guidance, and study-abroad research.",
    "defaultCountryCode": "IN",
    "currency": "INR",
    "dateFormat": "YYYY-MM-DD",
    "generatedOn": "2026-10-24",
    "verificationPolicy": "Verify current legal recognition, campus status, course availability, admission requirements, fees, and delivery mode through official university and relevant government or accreditation sources.",
    "notes": [
      "This is a curated reference directory, not a complete list of all universities worldwide.",
      "A university listing does not confirm that a particular course is offered or that admissions are open.",
      "For Indian institutions, verify current status using the UGC directory and the relevant professional regulator where applicable.",
      "For medical courses, verify current recognition and permitted intake with the National Medical Commission or relevant regulator.",
      "For engineering, pharmacy, nursing, law, teacher education, and other regulated courses, check the applicable professional regulator.",
      "For international institutions, verify recognition through the relevant national education authority and check qualification recognition requirements in India when applicable.",
      "Distance-learning and online programmes may require separate programme-level approval.",
      "International records use ISO 3166-1 alpha-2 country codes; state represents a state, province, territory, or region where applicable."
    ],
    "directorySources": {
      "ugcUniversityDirectory": "https://www.ugc.gov.in/universitydetails",
      "ugcDeemedUniversities": "https://deemed.ugc.ac.in/Home/ListOfDeemedToBeUniversity",
      "ntaCuetUniversities": "https://cuet.nta.nic.in/participating-universities/",
      "nmc": "https://www.nmc.org.in/",
      "internationalHigherEducationDirectory": "https://iau.global/World-Higher-Education-Database-WHED"
    }
  },
