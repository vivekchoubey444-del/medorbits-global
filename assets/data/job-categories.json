
{
  "metadata": {
    "schemaVersion": "1.1.0",
    "dataset": "job-categories",
    "description": "Career category taxonomy for MedOrbits education, healthcare, technology, recruitment and employment discovery, with an explicit display priority ranking.",
    "defaultCountryCode": "IN",
    "currency": "INR",
    "dateFormat": "YYYY-MM-DD",
    "generatedOn": "2026-10-24",
    "verificationPolicy": "Verify professional registration requirements, qualifications, licensing rules and official reference URLs against the relevant authority before relying on them.",
    "priorityPolicy": {
      "field": "priority",
      "direction": "ascending",
      "meaning": "Directory display order only; lower values appear first.",
      "notAnIndicatorOf": [
        "salary",
        "job-demand",
        "vacancy-count",
        "employment-probability",
        "career-prestige"
      ],
      "range": "1-35",
      "uniqueValues": true
    },
    "notes": [
      "Priority reflects the suggested MedOrbits directory order and is not a labour-market ranking.",
      "regulated is true when a category generally involves regulated professional practice, false when it generally does not, or a descriptive string when requirements depend on the role.",
      "Examples are illustrative job titles and do not indicate current vacancies.",
      "Qualification and registration requirements vary by role, employer, jurisdiction and applicable law.",
      "Official reference URLs are starting points for verification and do not guarantee that a particular job is available.",
      "Do not publish invented salary ranges, vacancy counts or eligibility requirements.",
      "Add new categories with unique IDs and priorities, and update the priority range when the dataset grows."
    ]
  },
