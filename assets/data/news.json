  "dataRules": [
    "Every news item must have a unique id and slug.",
    "title, summary, category, newsType and source are required.",
    "An item may be set to published only when it has an officialNoticeUrl or sourceUrl, and for official_notice items verificationStatus must be verified.",
    "Write summaries in original wording; do not copy or closely paraphrase articles, and keep any quotation short and attributed.",
    "Never invent dates, deadlines, results, eligibility or notice numbers; use null when unknown.",
    "Dates must use YYYY-MM-DD; publishedAt and expiresAt use ISO 8601 with offset; expiresAt must not precede publishedAt.",
    "deadlineDate must not precede effectiveFrom when both are set.",
    "All referenced ids (stateIds, examIds, courseIds, institutionIds, admissionIds, relatedNewsIds, supersedesId) must exist.",
    "When a notice is revised or a date changes, create a new item with supersedesId and mark the old item outdated rather than silently editing it.",
    "Rumours, unconfirmed reports and social media claims must not be published as news; if included for context, label them clearly as unconfirmed.",
    "Never present news as official guidance when it comes from a non-official source; state the source type.",
    "Items past deadlineDate or expiresAt must be reviewed or archived before being shown as current.",
    "Images require alt text and must be licensed for use.",
    "The active field controls display only; it does not indicate that anything is open or in force.",
    "feedSources entries are source endpoints for a future/manual feed workflow; they are not news items and do not imply automated ingestion."
  ],
  "displayRules": {
    "defaultSort": [
      "isPinned desc",
      "priority desc",
      "publishedAt desc"
    ],
    "hideFromPublicWhen": [
      "active == false",
      "publicationStatus in ['draft','in_review','retracted']",
      "verificationStatus == 'rejected'"
    ],
    "showStaleWarningWhen": [
      "deadlineDate < today",
      "expiresAt < now",
      "verificationStatus == 'outdated'",
      "reviewDueAt < today"
    ],
    "alwaysShow": [
      "source.name",
      "publishedAt",
      "verificationStatus"
    ],
    "unverifiedLabel": "Unverified - check the official source before acting on this update.",
    "disclaimer": "MedOrbits shares informational updates and does not replace official notices. Always confirm dates, eligibility and instructions on the official website of the relevant authority."
  },
