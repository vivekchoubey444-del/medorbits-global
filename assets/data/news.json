  "metadata": {
    "title": "MedOrbits News and Notifications",
    "description": "News, official notices and updates about exams, admissions, counselling, courses, policy, study abroad and jobs. Items are published only after a traceable source and editorial review.",
    "defaultCountryCode": "IN",
    "defaultLanguage": "en",
    "dateFormat": "YYYY-MM-DD",
    "datetimeFormat": "ISO 8601 with UTC offset",
    "timezonePolicy": "Store publishedAt in ISO 8601 with offset; use the issuing authority's timezone for notice dates.",
    "editorialPolicy": "Summarise in original wording. Link to the official notice. Do not copy articles, and do not publish rumours or unverified claims as fact.",
    "feedRegistryNote": "feedSources is a source directory only. It does not mean that these sites have been scraped or that any listed notice is current."
  },
