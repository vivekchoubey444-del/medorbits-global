    "currency": "INR",
    "dateFormat": "YYYY-MM-DD",
    "generatedOn": "2026-10-24",
    "verificationPolicy": "Verify each institution and course against the current NMC college and course database, the institution's official website and the relevant counselling authority before publication as verified information.",
