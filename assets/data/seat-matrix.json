
{
  "metadata": {
    "schemaVersion": "1.1.0",
    "dataset": "seat-matrix",
    "description": "Institution references for Indian MBBS seat-matrix workflows across states and national counselling. Seat counts remain null until imported and verified from the relevant official current-cycle matrix.",
    "defaultCountryCode": "IN",
    "currency": "INR",
    "dateFormat": "YYYY-MM-DD",
    "generatedOn": "2026-10-24",
    "verificationPolicy": "Verify institution recognition and approved intake against the latest NMC MBBS matrix. Verify quota, category, round, and actual counselling availability against the relevant official counselling authority's current-cycle matrix.",
    "officialSources": {
      "nmcApprovedIntake": "https://www.nmc.org.in/whats-new/",
      "mccNationalCounselling": "https://mcc.nic.in/current-events-ug/",
      "westBengalCounselling": "https://wbmcc.nic.in/ug-medical-dental-counselling/",
      "admissionsPortal": "https://admissions.nic.in/"
    },
    "notes": [
      "A null seatCount means the count has not been verified for this record.",
      "NMC-approved annual intake is not the same as the number of seats available in a particular counselling round.",
      "Quota and category-specific seats must be imported from the applicable official seat matrix.",
      "National Institute of Importance seats may require separate counselling-source verification.",
      "Do not infer a college's recognition, annual intake, quota eligibility, or current-round availability from this reference list alone.",
      "Refresh official matrices whenever a new counselling round or revised intake notification is published."
    ]
  },
