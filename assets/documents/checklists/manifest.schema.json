
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/schemas/checklists-manifest.schema.json",
  "title": "MedOrbits Checklists Manifest",
  "description": "Validation schema for assets/documents/checklists/MANIFEST.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "manifestVersion",
    "metadata",
    "categories",
    "publicationPolicy",
    "resources"
  ],
  "properties": {
    "$schema": {
      "const": "./manifest.schema.json"
    },
    "schemaVersion": {
      "$ref": "#/$defs/version"
    },
    "manifestVersion": {
      "$ref": "#/$defs/version"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "brand",
        "designSystem",
        "directory",
        "classification",
        "access",
        "maintainedBy",
        "language",
        "defaultFormat",
        "lastReviewedAt",
        "disclaimer"
      ],
      "properties": {
        "name": {
          "const": "MedOrbits Checklists Library"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "brand": {
          "const": "MedOrbits"
        },
        "designSystem": {
          "const": "Royal Burgundy and Champagne Gold"
        },
        "directory": {
          "const": "assets/documents/checklists/"
        },
        "classification": {
          "const": "public-frontend-assets"
        },
        "access": {
          "const": "public"
        },
        "maintainedBy": {
          "const": "MedOrbits"
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "defaultFormat": {
          "const": "application/pdf"
        },
        "lastReviewedAt": {
          "$ref": "#/$defs/nullableDate"
        },
        "disclaimer": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/category"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "admissions"
              }
            },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "applications"
              }
            },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "career"
              }
            },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "education"
              }
            },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "examinations"
              }
            },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "general"
              }
            },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "study-abroad"
              }
            },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "publicationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedStatuses",
        "allowedVerificationStatuses",
        "publicDownloadStatuses",
        "requirements"
      ],
      "properties": {
        "allowedStatuses": {
          "type": "array",
          "uniqueItems": true,
          "contains": {
            "const": "published"
          },
          "items": {
            "enum": [
              "draft",
              "in_review",
              "approved",
              "published",
              "under_review",
              "outdated",
              "archived",
              "withdrawn"
            ]
          }
        },
        "allowedVerificationStatuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "not_verified",
              "content_reviewed",
              "official_sources_checked",
              "officially_verified"
            ]
          }
        },
        "publicDownloadStatuses": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "published"
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 10,
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "nullableDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "categoryId": {
      "enum": [
        "admissions",
        "applications",
        "career",
        "education",
        "examinations",
        "general",
        "study-abroad"
      ]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "path",
        "readme",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/categoryId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path": {
          "type": "string",
          "pattern": "^(admissions|applications|career|education|examinations|general|study-abroad)/$"
        },
        "readme": {
          "type": "string",
          "pattern": "^(admissions|applications|career|education|examinations|general|study-abroad)/README\\.md$"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "admissions"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "admissions/"
              },
              "readme": {
                "const": "admissions/README.md"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "applications"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "applications/"
              },
              "readme": {
                "const": "applications/README.md"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "career"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "career/"
              },
              "readme": {
                "const": "career/README.md"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "education"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "education/"
              },
              "readme": {
                "const": "education/README.md"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "examinations"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "examinations/"
              },
              "readme": {
                "const": "examinations/README.md"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "general"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "general/"
              },
              "readme": {
                "const": "general/README.md"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "study-abroad"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path": {
                "const": "study-abroad/"
              },
              "readme": {
                "const": "study-abroad/README.md"
              }
            }
          }
        }
      ]
    },
    "resourceStatus": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "under_review",
        "outdated",
        "archived",
        "withdrawn"
      ]
    },
    "verificationStatus": {
      "enum": [
        "not_verified",
        "content_reviewed",
        "official_sources_checked",
        "officially_verified"
      ]
    },
    "safePdfPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(admissions|applications|career|education|examinations|general|study-abroad)/[a-z0-9]+(?:-[a-z0-9]+)*\\.pdf$",
      "not": {
        "pattern": "(^/|(^|/)\\.\\.(/|$)|\\\\|[?#])"
      }
    },
    "officialSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "checkedAt"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "checkedAt": {
          "$ref": "#/$defs/nullableDate"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "path",
        "format",
        "description",
        "intendedUse",
        "status",
        "verificationStatus",
        "version",
        "language",
        "keywords",
        "officialSources",
        "lastReviewedAt",
        "reviewDueAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "category": {
          "$ref": "#/$defs/categoryId"
        },
        "path": {
          "$ref": "#/$defs/safePdfPath"
        },
        "format": {
          "const": "application/pdf"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "intendedUse": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "$ref": "#/$defs/resourceStatus"
        },
        "verificationStatus": {
          "$ref": "#/$defs/verificationStatus"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "officialSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/officialSource"
          }
        },
        "lastReviewedAt": {
          "$ref": "#/$defs/nullableDate"
        },
        "reviewDueAt": {
          "$ref": "#/$defs/nullableDate"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "verificationStatus": {
                "enum": [
                  "official_sources_checked",
                  "officially_verified"
                ]
              },
              "lastReviewedAt": {
                "type": "string",
                "format": "date"
              },
              "reviewDueAt": {
                "type": "string",
                "format": "date"
              },
              "officialSources": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verificationStatus": {
                "const": "officially_verified"
              }
            },
            "required": ["verificationStatus"]
          },
          "then": {
            "properties": {
              "officialSources": {
                "minItems": 1
              },
              "lastReviewedAt": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ]
    }
  }
}
