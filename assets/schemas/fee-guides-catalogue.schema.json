
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/schemas/fee-guides-catalogue.schema.json",
  "title": "MedOrbits Fee Guides Application Catalogue",
  "description": "Validated application-facing catalogue generated from the authoritative MedOrbits Fee Guides manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatedFrom",
    "package",
    "updatedAt",
    "categories",
    "documents"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/fee-guides-catalogue.schema.json"
    },
    "schemaVersion": {
      "$ref": "#/$defs/version"
    },
    "generatedFrom": {
      "type": "string",
      "const": "assets/documents/fee-guides/MANIFEST.json"
    },
    "package": {
      "type": "string",
      "const": "MedOrbits Fee Guides"
    },
    "updatedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "dateTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*\\s$).+$",
      "description": "Repository-relative POSIX path. Absolute paths, drive prefixes, backslashes, traversal segments, empty segments, and trailing whitespace are not permitted."
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*[A-Za-z0-9]$|^[A-Za-z0-9]$",
      "description": "A plain filename without path separators, leading dots, or trailing spaces or dots."
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "documentStatus": {
      "type": "string",
      "enum": [
        "planned",
        "draft",
        "in_review",
        "verified",
        "published",
        "under_review",
        "outdated",
        "archived",
        "withdrawn"
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "filename",
        "path",
        "category",
        "description",
        "keywords",
        "programmes",
        "audience",
        "countryCodes",
        "academicYear",
        "status",
        "sizeBytes",
        "lastVerified",
        "featured",
        "relatedDocumentIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "filename": {
          "$ref": "#/$defs/filename"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "category": {
          "$ref": "#/$defs/slug"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "programmes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "students",
              "parents",
              "applicants",
              "graduates",
              "international-students",
              "education-counsellors",
              "institutions",
              "general-public"
            ]
          }
        },
        "countryCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/countryCode"
          }
        },
        "academicYear": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20,
          "pattern": "^(?:\\d{4}(?:-\\d{2,4})?)$"
        },
        "status": {
          "$ref": "#/$defs/documentStatus"
        },
        "sizeBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "lastVerified": {
          "$ref": "#/$defs/date"
        },
        "featured": {
          "type": "boolean"
        },
        "relatedDocumentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              },
              "lastVerified": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      ]
    }
  }
}
