
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/schemas/fee-guides.schema.json",
  "title": "MedOrbits Fee Guides Manifest Schema",
  "description": "Production validation schema for the MedOrbits Fee Guides package, including document metadata, publication workflows, official-source verification, file integrity, discovery, security, privacy and maintenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "package",
    "manifestVersion",
    "packageVersion",
    "schemaVersion",
    "directory",
    "purpose",
    "brand",
    "metadata",
    "access",
    "publicationPolicy",
    "filePolicy",
    "discovery",
    "categories",
    "documents",
    "accuracyPolicy",
    "verificationPolicy",
    "contentStandards",
    "securityPolicy",
    "privacy",
    "publishingChecklist",
    "maintenance",
    "disclaimer"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../schemas/fee-guides.schema.json"
    },
    "package": {
      "type": "string",
      "const": "MedOrbits Fee Guides"
    },
    "manifestVersion": {
      "$ref": "#/$defs/version"
    },
    "packageVersion": {
      "$ref": "#/$defs/version"
    },
    "schemaVersion": {
      "$ref": "#/$defs/version"
    },
    "directory": {
      "type": "string",
      "const": "assets/documents/fee-guides/"
    },
    "purpose": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "brand": {
      "$ref": "#/$defs/brand"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "access": {
      "$ref": "#/$defs/accessPolicy"
    },
    "publicationPolicy": {
      "$ref": "#/$defs/publicationPolicy"
    },
    "filePolicy": {
      "$ref": "#/$defs/filePolicy"
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "accuracyPolicy": {
      "$ref": "#/$defs/accuracyPolicy"
    },
    "verificationPolicy": {
      "$ref": "#/$defs/verificationPolicy"
    },
    "contentStandards": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "securityPolicy": {
      "$ref": "#/$defs/securityPolicy"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "publishingChecklist": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "maintenance": {
      "$ref": "#/$defs/maintenance"
    },
    "disclaimer": {
      "$ref": "#/$defs/disclaimer"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "nullableDateTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "designDirection",
        "documentStyle"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "MedOrbits"
        },
        "designDirection": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "documentStyle": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "language",
        "defaultCountryCode",
        "defaultCurrency",
        "contentType",
        "maintainedBy",
        "readme",
        "academicYear",
        "createdAt",
        "updatedAt",
        "lastReviewed"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "defaultCountryCode": {
          "$ref": "#/$defs/countryCode"
        },
        "defaultCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "contentType": {
          "type": "string",
          "const": "application/pdf"
        },
        "maintainedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "readme": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "academicYear": {
          "$ref": "#/$defs/nullableString"
        },
        "createdAt": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "lastReviewed": {
          "$ref": "#/$defs/nullableDate"
        }
      }
    },
    "accessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "visibility",
        "authenticationRequired",
        "subscriptionRequired",
        "downloadRequiresPublishedStatus",
        "downloadRequiresExistingFile"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "const": "public-frontend-assets"
        },
        "visibility": {
          "type": "string",
          "const": "public"
        },
        "authenticationRequired": {
          "type": "boolean",
          "const": false
        },
        "subscriptionRequired": {
          "type": "boolean",
          "const": false
        },
        "downloadRequiresPublishedStatus": {
          "type": "boolean",
          "const": true
        },
        "downloadRequiresExistingFile": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "documentStatus": {
      "type": "string",
      "enum": [
        "planned",
        "draft",
        "in_review",
        "verified",
        "published",
        "under_review",
        "outdated",
        "archived",
        "withdrawn"
      ]
    },
    "publicationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialStatus",
        "allowedStatuses",
        "publicStatuses",
        "downloadableStatuses",
        "requireFileValidation",
        "requireContentReview",
        "requireVerificationBeforePublication",
        "requireOfficialSourcesWhenApplicable",
        "requireAcademicYearWhenApplicable",
        "requireVerificationDateForTimeSensitiveInformation",
        "blockUnverifiedOfficialClaims",
        "blockMissingFiles",
        "blockExpiredDocuments",
        "requireApprovalBeforeRepublishing"
      ],
      "properties": {
        "initialStatus": {
          "$ref": "#/$defs/documentStatus"
        },
        "allowedStatuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/documentStatus"
          }
        },
        "publicStatuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "const": "published"
          },
          "contains": {
            "const": "published"
          }
        },
        "downloadableStatuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "const": "published"
          },
          "contains": {
            "const": "published"
          }
        },
        "requireFileValidation": {
          "type": "boolean"
        },
        "requireContentReview": {
          "type": "boolean"
        },
        "requireVerificationBeforePublication": {
          "type": "boolean"
        },
        "requireOfficialSourcesWhenApplicable": {
          "type": "boolean"
        },
        "requireAcademicYearWhenApplicable": {
          "type": "boolean"
        },
        "requireVerificationDateForTimeSensitiveInformation": {
          "type": "boolean"
        },
        "blockUnverifiedOfficialClaims": {
          "type": "boolean"
        },
        "blockMissingFiles": {
          "type": "boolean"
        },
        "blockExpiredDocuments": {
          "type": "boolean"
        },
        "requireApprovalBeforeRepublishing": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "properties": {
            "initialStatus": {
              "not": {
                "const": "published"
              }
            }
          }
        },
        {
          "properties": {
            "allowedStatuses": {
              "contains": {
                "const": "published"
              }
            }
          }
        }
      ]
    },
    "filePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension",
        "mimeType",
        "maximumFileSizeMB",
        "requireNonEmptyFile",
        "requireValidPdf",
        "requireReadableText",
        "requireAccessibilityReview",
        "requireMetadataReview",
        "requireMalwareScan",
        "requireUniqueFilenames",
        "requireChecksumForPublishedFiles",
        "checksumAlgorithm",
        "allowExternalFilePaths",
        "pathBase"
      ],
      "properties": {
        "extension": {
          "type": "string",
          "const": ".pdf"
        },
        "mimeType": {
          "type": "string",
          "const": "application/pdf"
        },
        "maximumFileSizeMB": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requireNonEmptyFile": {
          "type": "boolean"
        },
        "requireValidPdf": {
          "type": "boolean"
        },
        "requireReadableText": {
          "type": "boolean"
        },
        "requireAccessibilityReview": {
          "type": "boolean"
        },
        "requireMetadataReview": {
          "type": "boolean"
        },
        "requireMalwareScan": {
          "type": "boolean"
        },
        "requireUniqueFilenames": {
          "type": "boolean"
        },
        "requireChecksumForPublishedFiles": {
          "type": "boolean"
        },
        "checksumAlgorithm": {
          "type": "string",
          "const": "SHA-256"
        },
        "allowExternalFilePaths": {
          "type": "boolean",
          "const": false
        },
        "pathBase": {
          "type": "string",
          "const": "site-root"
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "searchEnabled",
        "categoryFilteringEnabled",
        "keywordSearchEnabled",
        "academicYearFilteringEnabled",
        "countryFilteringEnabled",
        "defaultSort",
        "supportedSortOptions",
        "showDescription",
        "showCategory",
        "showAcademicYear",
        "showLastVerified",
        "showFileSize",
        "showDownloadButtonForPublishedOnly",
        "showPublicationStatusToPublic",
        "showRelatedGuides",
        "emptyStateMessage",
        "unavailableMessage"
      ],
      "properties": {
        "searchEnabled": {
          "type": "boolean"
        },
        "categoryFilteringEnabled": {
          "type": "boolean"
        },
        "keywordSearchEnabled": {
          "type": "boolean"
        },
        "academicYearFilteringEnabled": {
          "type": "boolean"
        },
        "countryFilteringEnabled": {
          "type": "boolean"
        },
        "defaultSort": {
          "type": "string",
          "enum": [
            "title-ascending",
            "title-descending",
            "category",
            "recently-reviewed"
          ]
        },
        "supportedSortOptions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "title-ascending",
              "title-descending",
              "category",
              "recently-reviewed"
            ]
          }
        },
        "showDescription": {
          "type": "boolean"
        },
        "showCategory": {
          "type": "boolean"
        },
        "showAcademicYear": {
          "type": "boolean"
        },
        "showLastVerified": {
          "type": "boolean"
        },
        "showFileSize": {
          "type": "boolean"
        },
        "showDownloadButtonForPublishedOnly": {
          "type": "boolean",
          "const": true
        },
        "showPublicationStatusToPublic": {
          "type": "boolean"
        },
        "showRelatedGuides": {
          "type": "boolean"
        },
        "emptyStateMessage": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "unavailableMessage": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        }
      }
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*\\s$).+$",
      "description": "Repository-relative POSIX path. Must not contain absolute paths, drive prefixes, backslashes, traversal segments, empty path segments or trailing whitespace."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "sourceType"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "government",
            "regulator",
            "institution",
            "counselling-authority",
            "lender",
            "scholarship-provider",
            "other-official"
          ]
        },
        "accessedAt": {
          "$ref": "#/$defs/nullableDate"
        }
      }
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "not_verified",
        "in_progress",
        "verified",
        "needs_reverification"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "lastVerified",
        "officialSources",
        "reviewDueAt"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/verificationStatus"
        },
        "lastVerified": {
          "$ref": "#/$defs/nullableDate"
        },
        "officialSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "reviewDueAt": {
          "$ref": "#/$defs/nullableDate"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishedAt",
        "featured",
        "relatedDocumentIds"
      ],
      "properties": {
        "publishedAt": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "featured": {
          "type": "boolean"
        },
        "relatedDocumentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "title",
        "category",
        "status",
        "description",
        "keywords",
        "programmes",
        "audience",
        "countryCodes",
        "academicYear",
        "path",
        "mimeType",
        "sizeBytes",
        "checksum",
        "version",
        "verification",
        "publication"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "filename": {
          "type": "string",
          "minLength": 5,
          "maxLength": 255,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.pdf$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "category": {
          "$ref": "#/$defs/slug"
        },
        "status": {
          "$ref": "#/$defs/documentStatus"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "programmes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "audience": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "students",
              "parents",
              "applicants",
              "graduates",
              "international-students",
              "education-counsellors",
              "institutions",
              "general-public"
            ]
          }
        },
        "countryCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/countryCode"
          }
        },
        "academicYear": {
          "$ref": "#/$defs/nullableString"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^assets/documents/fee-guides/(?:[a-z0-9]+(?:-[a-z0-9]+)*/)*[a-z0-9]+(?:-[a-z0-9]+)*\\.pdf$"
        },
        "mimeType": {
          "type": "string",
          "const": "application/pdf"
        },
        "sizeBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "checksum": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[a-fA-F0-9]{64})?$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "publication": {
          "$ref": "#/$defs/publication"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "published"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "verification": {
                "properties": {
                  "status": {
                    "const": "verified"
                  },
                  "lastVerified": {
                    "type": "string",
                    "format": "date"
                  },
                  "officialSources": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sizeBytes": {
                "type": "integer",
                "minimum": 1
              },
              "checksum": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "publication": {
                "properties": {
                  "publishedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "verification": {
                "properties": {
                  "status": {
                    "const": "verified"
                  },
                  "lastVerified": {
                    "type": "string",
                    "format": "date"
                  },
                  "officialSources": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "accuracyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avoidUnverifiedCurrentFeeAmounts",
        "verifyAgainstOfficialSources",
        "officialNotificationsTakePrecedence",
        "verifyRefundAndCancellationTermsInWriting",
        "verifyLoanAndScholarshipConditions",
        "warnAgainstPaymentsToUnverifiedPersonalAccounts",
        "distinguishOfficialAmountsFromEstimates",
        "neverInventFeesOrSourceUrls",
        "financialAdvice",
        "legalAdvice"
      ],
      "properties": {
        "avoidUnverifiedCurrentFeeAmounts": {
          "type": "boolean"
        },
        "verifyAgainstOfficialSources": {
          "type": "boolean"
        },
        "officialNotificationsTakePrecedence": {
          "type": "boolean"
        },
        "verifyRefundAndCancellationTermsInWriting": {
          "type": "boolean"
        },
        "verifyLoanAndScholarshipConditions": {
          "type": "boolean"
        },
        "warnAgainstPaymentsToUnverifiedPersonalAccounts": {
          "type": "boolean"
        },
        "distinguishOfficialAmountsFromEstimates": {
          "type": "boolean"
        },
        "neverInventFeesOrSourceUrls": {
          "type": "boolean"
        },
        "financialAdvice": {
          "type": "boolean",
          "const": false
        },
        "legalAdvice": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "verificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "officialSourcesRequired",
        "verificationDateRequiredForTimeSensitiveInformation",
        "academicYearRequiredWhenApplicable",
        "currencyAndPaymentPeriodRequiredForFeeAmounts",
        "institutionAndProgrammeRequiredForInstitutionSpecificClaims",
        "recordCampusAndStudentCategoryWhenRelevant",
        "recordSourceUrlAndReviewDate"
      ],
      "properties": {
        "officialSourcesRequired": {
          "type": "boolean"
        },
        "verificationDateRequiredForTimeSensitiveInformation": {
          "type": "boolean"
        },
        "academicYearRequiredWhenApplicable": {
          "type": "boolean"
        },
        "currencyAndPaymentPeriodRequiredForFeeAmounts": {
          "type": "boolean"
        },
        "institutionAndProgrammeRequiredForInstitutionSpecificClaims": {
          "type": "boolean"
        },
        "recordCampusAndStudentCategoryWhenRelevant": {
          "type": "boolean"
        },
        "recordSourceUrlAndReviewDate": {
          "type": "boolean"
        }
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 1000
      }
    },
    "securityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicResourcesOnly",
        "prohibitPersonalFinancialRecords",
        "inspectPdfMetadata",
        "inspectEmbeddedContent",
        "validateFileTypeByContent",
        "requireMalwareScanning",
        "rejectPathTraversal",
