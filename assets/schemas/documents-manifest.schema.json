
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/schemas/documents-manifest.schema.json",
  "title": "MedOrbits Document Library Manifest Schema",
  "description": "Shared validation schema for standard MedOrbits document registries and specialised document-package manifests.",
  "oneOf": [
    {
      "$ref": "#/$defs/standardManifest"
    },
    {
      "$ref": "#/$defs/specialisedManifest"
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "dateTime": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*\\s$).+$",
      "description": "Repository-relative POSIX path. Rejects absolute paths, drive-prefixed paths, backslashes, dot-directory traversal, empty path segments, and trailing whitespace."
    },
    "documentDirectory": {
      "type": "string",
      "minLength": 16,
      "maxLength": 300,
      "pattern": "^assets/documents/(?:[a-z0-9]+(?:-[a-z0-9]+)*/)*$",
      "description": "MedOrbits document directory. Must begin with assets/documents/ and end with a slash."
    },
    "publicationStatus": {
      "type": "string",
      "enum": [
        "planned",
        "draft",
        "in_review",
        "approved",
        "published",
        "under_review",
        "outdated",
        "archived",
        "withdrawn"
      ]
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "not_verified",
        "content_reviewed",
        "official_sources_checked",
        "officially_verified"
      ]
    },
    "access": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "restricted"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "public-frontend-assets",
        "internal",
        "restricted"
      ]
    },
    "brand": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "designDirection": {
              "type": "string",
              "minLength": 1
            },
            "designSystem": {
              "type": "string",
              "minLength": 1
            },
            "primaryColour": {
              "type": "string",
              "minLength": 1
            },
            "secondaryColour": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "description",
        "directory",
        "classification",
        "access",
        "maintainedBy"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "designSystem": {
          "type": "string",
          "minLength": 1
        },
        "directory": {
          "$ref": "#/$defs/documentDirectory"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "maintainedBy": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "defaultFormat": {
          "type": "string",
          "minLength": 1
        },
        "academicYear": {
          "type": ["string", "null"]
        },
        "updatedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "lastReviewedAt": {
          "$ref": "#/$defs/date"
        },
        "readme": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "category": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "directory": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "readme": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "officialSource": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "checkedAt": {
          "$ref": "#/$defs/date"
        },
        "lastCheckedAt": {
          "$ref": "#/$defs/date"
        }
      },
      "additionalProperties": true
    },
    "checksum": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(sha256:[a-fA-F0-9]{64})?$"
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*$",
      "description": "A plain filename without directory separators. Must begin with an alphanumeric character."
    },
    "documentFields": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "category": {
          "$ref": "#/$defs/slug"
        },
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "filename": {
          "$ref": "#/$defs/filename"
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "intendedUse": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "$ref": "#/$defs/publicationStatus"
        },
        "verificationStatus": {
          "$ref": "#/$defs/verificationStatus"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "academicYear": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "officialSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/officialSource"
          }
        },
        "lastReviewedAt": {
          "$ref": "#/$defs/date"
        },
        "lastVerifiedAt": {
          "$ref": "#/$defs/date"
        },
        "lastReviewed": {
          "$ref": "#/$defs/date"
        },
        "lastVerified": {
          "$ref": "#/$defs/date"
        },
        "reviewDueAt": {
          "$ref": "#/$defs/date"
        },
        "publishedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "sizeBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        },
        "relatedResources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "relatedDocuments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "audiences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "destinationCountries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/countryCode"
          }
        }
      },
      "additionalProperties": true
    },
    "resource": {
      "allOf": [
        {
          "$ref": "#/$defs/documentFields"
        },
        {
          "required": [
            "id",
            "title",
            "path",
            "format",
            "description"
          ]
        }
      ]
    },
    "document": {
      "allOf": [
        {
          "$ref": "#/$defs/documentFields"
        },
        {
          "required": [
            "id",
            "title",
            "filename",
            "description"
          ]
        }
      ]
    },
    "publicationPolicy": {
      "type": "object",
      "properties": {
        "allowedStatuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/publicationStatus"
          }
        },
        "allowedVerificationStatuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/verificationStatus"
          }
        },
        "publicDownloadStatuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "const": "published"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "verificationPolicy": {
      "type": "object",
      "properties": {
        "allowedStatuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/verificationStatus"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "standardManifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "manifestVersion",
        "metadata",
        "resources"
      ],
      "properties": {
        "$schema": {
          "const": "https://medorbits.in/schemas/documents-manifest.schema.json"
        },
        "schemaVersion": {
          "$ref": "#/$defs/version"
        },
        "manifestVersion": {
          "$ref": "#/$defs/version"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          }
        },
        "publicationPolicy": {
          "$ref": "#/$defs/publicationPolicy"
        },
        "verificationPolicy": {
          "$ref": "#/$defs/verificationPolicy"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        }
      },
      "not": {
        "required": [
          "package",
          "documents"
        ]
      },
      "additionalProperties": true
    },
    "specialisedManifest": {
      "type": "object",
      "required": [
        "package",
        "manifestVersion",
        "directory",
        "purpose",
        "brand",
        "access",
        "documents"
      ],
      "properties": {
        "$schema": {
          "const": "https://medorbits.in/schemas/documents-manifest.schema.json"
        },
        "schemaVersion": {
          "$ref": "#/$defs/version"
        },
        "manifestVersion": {
          "$ref": "#/$defs/version"
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "directory": {
          "$ref": "#/$defs/documentDirectory"
        },
        "baseDirectory": {
          "$ref": "#/$defs/documentDirectory"
        },
        "brand": {
          "$ref": "#/$defs/brand"
        },
        "designSystem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "maintainedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "defaultFormat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "academicYear": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "updatedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "lastReviewedAt": {
          "$ref": "#/$defs/date"
        },
        "readme": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          }
        },
        "publicationPolicy": {
          "$ref": "#/$defs/publicationPolicy"
        },
        "verificationPolicy": {
          "$ref": "#/$defs/verificationPolicy"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        }
      },
      "not": {
        "required": [
          "metadata",
          "resources"
        ]
      },
      "additionalProperties": true
    }
  }
}
