
# ==============================================================================
# MedOrbits -- Docker Build Context Exclusions
# File: /.dockerignore
# Release: 2.1.0
#
# Purpose:
#   Reduce Docker build context size and prevent accidental inclusion
#   of local secrets, development artifacts, and repository metadata.
#
# Security:
#   This file does not replace secret management, .gitignore, or image scanning.
# ==============================================================================

# ------------------------------------------------------------------------------
# Git metadata and repository configuration
# ------------------------------------------------------------------------------

.git
.git/**
.gitignore
.gitattributes
.gitmodules

# ------------------------------------------------------------------------------
# GitHub workflows and internal repository tooling
# ------------------------------------------------------------------------------

.github
.github/**
tools/repository-reports
tools/repository-reports/**

# ------------------------------------------------------------------------------
# Environment files and secrets
# Keep explicitly approved environment templates only.
# ------------------------------------------------------------------------------

.env
.env.*
!.env.example
!.env.sample
!.env.template

**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# ------------------------------------------------------------------------------
# Private keys, certificates, credentials, and secret material
# ------------------------------------------------------------------------------

**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*_rsa
**/*_ed25519
**/id_rsa
**/id_ed25519
**/credentials.json
**/service-account*.json
**/secrets.*
**/*secret*
**/*credential*

# ------------------------------------------------------------------------------
# Dependencies
# Install production dependencies inside the Docker build.
# ------------------------------------------------------------------------------

node_modules
node_modules/**
**/node_modules
**/node_modules/**

# ------------------------------------------------------------------------------
# Package manager caches
# ------------------------------------------------------------------------------

.npm
.pnpm-store
.yarn/cache
.yarn/unplugged

# ------------------------------------------------------------------------------
# Logs and temporary files
# ------------------------------------------------------------------------------

*.log
logs
logs/**
tmp
tmp/**
temp
temp/**
*.tmp
*.temp
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Operating system and editor files
# ------------------------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini
.idea
.vscode
.history

# ------------------------------------------------------------------------------
# Test output and coverage
# ------------------------------------------------------------------------------

coverage
coverage/**
.nyc_output
.nyc_output/**
playwright-report
playwright-report/**
test-results
test-results/**
__screenshots__
__screenshots__/**

# ------------------------------------------------------------------------------
# Local caches
# ------------------------------------------------------------------------------

.cache
.cache/**
.parcel-cache
.parcel-cache/**
.eslintcache
.stylelintcache
.turbo
.turbo/**

# ------------------------------------------------------------------------------
# Build output
# Uncomment only when these directories are not required by the Docker build.
# ------------------------------------------------------------------------------

# dist
# build
# .next
# out

# ------------------------------------------------------------------------------
# Local databases and database dumps
# ------------------------------------------------------------------------------

*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# ------------------------------------------------------------------------------
# Backups and editor recovery files
# ------------------------------------------------------------------------------

*.bak
*.backup
*.old
*.orig
*.rej
*~

# ------------------------------------------------------------------------------
# Python artifacts
# ------------------------------------------------------------------------------

__pycache__
__pycache__/**
*.py[cod]
.venv
venv
.pytest_cache
.mypy_cache

# ------------------------------------------------------------------------------
# Documentation and repository-only files
# Remove these only if the application does not need them at build time.
# ------------------------------------------------------------------------------

CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md

# ------------------------------------------------------------------------------
# Docker development overrides
# ------------------------------------------------------------------------------

docker-compose.override.yml
compose.override.yaml

# ------------------------------------------------------------------------------
# Keep required application inputs available.
#
# Do not ignore:
#   - Dockerfile and required build scripts
#   - package.json and package-lock.json
#   - pnpm-lock.yaml or yarn.lock when used by the project
#   - application source and required public assets
#   - required runtime configuration templates
#
# Docker ignore rules are evaluated in order; review exceptions carefully.
# ==============================================================================
