      "priority": "medium"
    },
    {
      "id": "PAGE-007",
      "name": "Dead-end page detection",
      "description": "Identify pages without meaningful outgoing navigation or next-step actions.",
      "priority": "high"
    },
    {
      "id": "PAGE-008",
      "name": "Broken internal destination",
