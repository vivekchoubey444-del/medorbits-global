
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "report": {
    "name": "MedOrbits Unresolved References Report",
    "version": "1.0.0",
    "project": "MedOrbits",
    "generatedAt": null,
    "generator": "tools/repository-reports",
    "status": "baseline",
    "description": "Repository-wide tracking of references that cannot be resolved, verified, or mapped to an existing target."
  },
  "summary": {
    "filesScanned": 0,
    "totalReferences": 0,
    "unresolvedReferences": 0,
