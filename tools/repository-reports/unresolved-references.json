  "scanner": {
    "enabled": true,
    "mode": "read-only",
    "preserveExistingFindings": true,
    "stableReferenceIds": true,
    "deduplicate": true,
    "includeGeneratedFiles": false,
    "includeBinaryFiles": false,
    "generateCsv": true,
    "csvOutput": "tools/repository-reports/unresolved-references.csv",
    "jsonOutput": "tools/repository-reports/unresolved-references.json",
    "exitOnCritical": true,
    "exitOnHigh": false
