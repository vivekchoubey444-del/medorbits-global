  "resolutionCategories": [
    "correct-path",
    "restore-missing-file",
    "correct-import",
    "register-api-route",
    "declare-environment-variable",
    "correct-configuration",
    "apply-database-migration",
    "install-dependency",
    "correct-external-url",
    "document-intentional-reference",
    "manual-investigation"
