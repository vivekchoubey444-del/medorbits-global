    "critical": 0,
    "high": 0,
    "medium": 0,
    "low": 0
  },
  "scanConfiguration": {
    "repositoryRoot": ".",
    "recursive": true,
    "includeHidden": true,
    "followSymbolicLinks": false,
    "scanTrackedFiles": true,
    "scanUntrackedFiles": true,
    "scanJavaScriptImports": true,
    "scanPythonImports": true,
    "scanHtmlReferences": true,
    "scanCssReferences": true,
    "scanJsonReferences": true,
    "scanApiReferences": true,
    "scanEnvironmentVariables": true,
    "scanConfigurationKeys": true,
    "scanDatabaseReferences": true,
    "scanExternalIntegrations": true,
    "checkExternalUrls": false,
    "maximumFileSizeMB": 25,
    "ignoreDirectories": [
      ".git",
      "node_modules",
      ".venv",
      "venv",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      "coverage",
      "dist",
      "build"
    ],
    "ignorePatterns": [
      "*.min.js",
      "*.map",
      "*.lock"
    ]
  },
  "referenceTypes": [
    "file",
    "directory",
    "javascript-module",
    "python-module",
    "html-link",
    "html-asset",
    "css-import",
    "css-asset",
    "json-reference",
    "api-endpoint",
    "environment-variable",
    "configuration-key",
    "database-table",
    "database-column",
    "database-query",
    "external-package",
    "external-service",
    "github-action",
    "workflow-reference",
    "document",
    "image",
    "font",
    "unknown"
  ],
  "severityLevels": {
    "critical": {
      "priority": 1,
      "description": "Unresolved references affecting startup, authentication, authorization, secrets, database connectivity, or critical application functionality."
    },
    "high": {
      "priority": 2,
      "description": "Unresolved references affecting API routes, application services, admissions, recruitment, documents, or essential integrations."
    },
    "medium": {
      "priority": 3,
      "description": "Unresolved references affecting secondary functionality, supporting modules, or documentation."
    },
    "low": {
      "priority": 4,
      "description": "Unresolved optional, cosmetic, archived, or nonessential references."
    }
  },
  "statusDefinitions": {
    "open": "Reference has been detected but remains unresolved.",
    "resolved": "Target has been located and verified.",
    "unverified": "Reference has not been conclusively checked.",
    "ignored": "Reference is intentionally excluded with a documented reason.",
    "false-positive": "The detected reference is not genuinely unresolved.",
    "blocked": "Resolution requires an unavailable external resource, permission, or configuration."
  },
  "references": [],
