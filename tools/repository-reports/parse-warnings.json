
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "reportType": "repository-parse-warnings",
  "reportVersion": "1.0.0",
  "project": "MedOrbits",
  "reportPath": "/tools/repository-reports/parse-warnings.json",
  "description": "Repository-wide parsing, syntax, formatting, and configuration warnings.",
  "metadata": {
    "status": "not-scanned",
    "generatedAt": null,
    "lastScannedAt": null,
    "scannerVersion": "1.0.0",
    "verifiedAgainstRepository": false,
    "readOnly": true,
    "notes": [
      "This file is a report template, not evidence that the repository has been scanned.",
      "Empty findings do not mean that the repository is free of parsing errors.",
      "Warnings must be generated from actual file contents."
    ]
  },
  "summary": {
    "filesScanned": 0,
    "filesSkipped": 0,
    "filesWithWarnings": 0,
    "totalWarnings": 0,
    "errors": 0,
    "warnings": 0,
    "informational": 0,
    "unsupportedFiles": 0,
    "parseFailures": 0,
    "configurationFailures": 0,
    "autofixCandidates": 0,
    "autofixed": 0,
    "remaining": 0
  },
  "severityLevels": {
    "critical": {
      "description": "Parsing failure that can prevent application startup, execution, or deployment."
    },
    "high": {
      "description": "Invalid or incompatible configuration that can break an important workflow."
    },
    "medium": {
      "description": "Potential parsing, compatibility, or validation issue requiring review."
    },
    "low": {
      "description": "Non-blocking formatting or consistency issue."
    },
    "info": {
      "description": "Informational observation that does not indicate a confirmed defect."
    }
  },
  "supportedFileTypes": [
    {
      "extension": ".json",
      "parser": "JSON parser",
      "checks": [
        "valid JSON syntax",
        "duplicate object keys",
        "invalid trailing commas",
        "invalid escape sequences",
        "unexpected data types"
      ]
    },
    {
      "extension": ".js",
      "parser": "Node.js syntax checker",
      "checks": [
        "JavaScript syntax",
        "module syntax",
        "unsupported language features",
        "invalid imports"
      ]
    },
    {
      "extension": ".mjs",
      "parser": "Node.js syntax checker",
      "checks": [
        "ES module syntax",
        "invalid imports",
        "top-level syntax errors"
      ]
    },
    {
      "extension": ".cjs",
      "parser": "Node.js syntax checker",
      "checks": [
        "CommonJS syntax",
        "invalid require statements",
        "top-level syntax errors"
      ]
    },
    {
      "extension": ".ts",
      "parser": "TypeScript compiler",
      "checks": [
        "TypeScript syntax",
        "type declaration syntax",
        "module resolution"
      ]
    },
    {
      "extension": ".tsx",
      "parser": "TypeScript compiler",
      "checks": [
        "TypeScript syntax",
        "JSX syntax",
        "type declaration syntax"
      ]
    },
    {
      "extension": ".py",
      "parser": "Python AST parser",
      "checks": [
        "Python syntax",
        "indentation",
        "invalid expressions",
        "invalid imports"
      ]
    },
    {
      "extension": ".html",
      "parser": "HTML validator",
      "checks": [
        "malformed markup",
        "unclosed elements",
        "invalid nesting",
        "invalid attributes"
      ]
    },
    {
      "extension": ".css",
      "parser": "CSS parser",
      "checks": [
        "invalid declarations",
        "unclosed blocks",
        "invalid selectors",
        "malformed at-rules"
      ]
    },
    {
      "extension": ".yml",
      "parser": "YAML parser",
      "checks": [
        "indentation",
        "invalid mappings",
        "invalid sequences",
        "duplicate keys"
      ]
    },
    {
      "extension": ".yaml",
      "parser": "YAML parser",
      "checks": [
        "indentation",
        "invalid mappings",
        "invalid sequences",
        "duplicate keys"
      ]
    },
    {
      "extension": ".toml",
      "parser": "TOML parser",
      "checks": [
        "invalid tables",
        "invalid key-value pairs",
        "invalid strings",
        "duplicate keys"
      ]
    },
    {
      "extension": ".sh",
      "parser": "Bash syntax checker",
      "checks": [
        "shell syntax",
        "unclosed quotes",
        "invalid conditional expressions",
        "unclosed blocks"
      ]
    },
    {
      "extension": ".xml",
      "parser": "XML parser",
      "checks": [
        "malformed XML",
        "unclosed elements",
        "invalid attributes",
        "invalid nesting"
      ]
    },
    {
      "extension": ".md",
      "parser": "Markdown validator",
      "checks": [
        "malformed front matter",
        "broken code fences",
        "invalid embedded metadata"
      ]
    }
  ],
  "scanConfiguration": {
    "rootDirectory": ".",
    "recursive": true,
    "followSymbolicLinks": false,
    "includeHiddenFiles": true,
    "includeExtensions": [
      ".json",
      ".js",
      ".mjs",
      ".cjs",
      ".ts",
      ".tsx",
      ".py",
      ".html",
      ".css",
      ".yml",
      ".yaml",
      ".toml",
      ".sh",
      ".xml",
      ".md"
    ],
    "excludeDirectories": [
      ".git",
      "node_modules",
      ".venv",
      "venv",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      "coverage",
      "dist",
      "build",
      ".next",
      ".cache"
    ],
    "excludePatterns": [
      "*.min.js",
      "*.min.css",
      "*.map",
      "*.lock",
      "*.log",
      "*.generated.*"
    ],
    "maximumFileSizeBytes": 5242880,
    "checkDuplicateKeys": true,
    "checkEncoding": true,
    "checkLineEndings": true,
    "checkTrailingWhitespace": true,
    "checkFinalNewline": true,
    "checkUnexpectedByteOrderMark": true,
    "strictMode": false,
    "failOnWarnings": false,
    "failOnErrors": true
  },
  "warningCategories": [
    "syntax-error",
    "parse-error",
    "invalid-encoding",
    "duplicate-key",
    "invalid-configuration",
    "invalid-module-syntax",
    "invalid-import-syntax",
    "invalid-indentation",
    "malformed-markup",
    "invalid-css",
    "invalid-yaml",
    "invalid-toml",
    "invalid-shell-syntax",
    "broken-front-matter",
    "trailing-whitespace",
    "missing-final-newline",
    "unexpected-bom",
    "unsupported-syntax",
    "parser-unavailable",
    "file-too-large",
    "unknown"
  ],
  "warnings": [],
  "errors": [],
  "filesSkipped": [],
  "autofixCandidates": [],
  "autofixPolicy": {
    "enabled": false,
    "automaticExecutionAllowed": false,
    "requireBackup": true,
    "requireExplicitApproval": true,
    "preserveOriginalEncoding": true,
    "preserveLineEndings": true,
    "preserveFilePermissions": true,
    "neverModify": [
      ".env",
      ".env.*",
      "*.lock",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "*.pem",
      "*.key",
      "*.crt",
      "*.p12",
      "*.pfx",
      "*.db",
      "*.sqlite",
      "*.sqlite3",
      "*.min.js",
      "*.min.css"
    ],
    "allowedOperations": [
      "suggest-correction",
      "generate-patch",
      "validate-corrected-copy"
    ],
    "forbiddenOperations": [
      "blind-replacement",
      "automatic-file-deletion",
      "automatic-file-renaming",
      "credential-modification",
      "lockfile-regeneration-without-approval",
      "unreviewed-source-overwrite"
    ]
  },
  "validationTools": {
    "javascript": {
      "command": "node --check",
      "required": false
    },
    "typescript": {
      "command": "npx tsc --noEmit",
      "required": false
    },
    "python": {
      "command": "python -m compileall -q",
      "required": false
    },
    "json": {
      "command": "python -m json.tool",
      "required": true
    },
    "yaml": {
      "command": "yamllint",
      "required": false
    },
    "shell": {
      "command": "bash -n",
      "required": false
    },
    "html": {
      "command": "html-validate",
      "required": false
    },
    "css": {
      "command": "stylelint",
      "required": false
    }
  },
  "integration": {
    "consumedBy": [
      "/tools/repository-reports/summary.json",
      "/tools/repository-reports/file-inventory.json",
      "/tools/repository-reports/unresolved-references.json"
    ],
    "relatedReports": [
      "/tools/repository-reports/broken-references.json",
      "/tools/repository-reports/conflict-markers.json",
      "/tools/repository-reports/duplicate-findings.json"
    ],
    "updateSummaryAfterScan": true,
    "preserveHistoricalResults": true
  },
  "outputs": {
    "jsonReport": "/tools/repository-reports/parse-warnings.json",
    "csvReport": "/tools/repository-reports/parse-warnings.csv",
    "logFile": "/tools/repository-reports/logs/parse-warnings.log",
    "patchDirectory": "/tools/repository-reports/patches/parse-warnings"
  },
  "exitPolicy": {
    "success": 0,
    "warningsFound": 0,
    "parseErrorsFound": 1,
    "scannerFailure": 2,
    "strictModeWarnings": 3,
    "forceMode": "Continue scanning after individual file failures, but preserve non-zero final status when errors remain."
  }
}
