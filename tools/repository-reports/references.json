
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "reportType": "repository-references",
  "reportVersion": "1.0.0",
  "project": "MedOrbits",
  "reportPath": "/tools/repository-reports/references.json",
  "description": "Central inventory and validation report for references across the MedOrbits repository.",
  "metadata": {
    "status": "not-scanned",
    "generatedAt": null,
    "lastScannedAt": null,
    "scannerVersion": "1.0.0",
    "verifiedAgainstRepository": false,
    "readOnly": true,
    "notes": [
      "This file is a baseline report template.",
      "No reference is considered verified until scanned against the actual repository.",
      "Empty reference collections do not indicate that all references are valid.",
      "Dynamic references may require runtime analysis."
    ]
  },
  "summary": {
    "totalReferences": 0,
    "verifiedReferences": 0,
    "unverifiedReferences": 0,
    "resolvedReferences": 0,
    "unresolvedReferences": 0,
    "brokenReferences": 0,
    "externalReferences": 0,
    "dynamicReferences": 0,
    "deprecatedReferences": 0,
    "duplicateReferences": 0,
    "referencesWithWarnings": 0,
    "filesScanned": 0,
    "filesSkipped": 0
  },
  "referenceTypes": [
    "file",
    "directory",
    "javascript-import",
    "python-import",
    "html-link",
    "html-script",
    "html-stylesheet",
    "css-import",
    "css-asset",
    "image-asset",
    "font-asset",
    "media-asset",
    "api-endpoint",
    "api-client",
    "route",
    "navigation",
    "environment-variable",
    "configuration-key",
    "database-table",
    "database-column",
    "database-migration",
    "package-dependency",
    "package-script",
    "workflow",
    "github-action",
    "service",
    "controller",
    "model",
    "middleware",
    "schema",
    "template",
    "documentation-link",
    "external-url",
    "dynamic-reference",
    "unknown"
  ],
  "referenceStatuses": [
    "verified",
    "resolved",
    "unresolved",
    "broken",
    "external",
    "dynamic",
    "deprecated",
    "duplicate",
    "ignored",
    "not-scanned"
  ],
  "references": [],
  "referenceGroups": {
    "files": [],
    "directories": [],
    "imports": [],
    "routes": [],
    "navigation": [],
    "assets": [],
    "apiEndpoints": [],
    "environmentVariables": [],
    "configurationKeys": [],
    "databaseObjects": [],
    "dependencies": [],
    "workflows": [],
    "externalUrls": [],
    "dynamicReferences": [],
    "other": []
  },
  "referenceRecordSchema": {
    "id": "REF-000001",
    "type": "file",
    "status": "not-scanned",
    "source": {
      "file": null,
      "line": null,
      "column": null,
      "symbol": null
    },
    "target": {
      "value": null,
      "normalizedValue": null,
      "resolvedPath": null,
      "external": false
    },
    "resolution": {
      "attempted": false,
      "resolved": false,
      "caseSensitiveMatch": null,
      "exists": null,
      "resolutionMethod": null,
      "checkedAt": null
    },
    "classification": {
      "severity": "info",
      "category": "unverified",
      "confidence": "unknown"
    },
    "relationship": {
      "parentReference": null,
      "relatedReferences": [],
      "dependencyDirection": "source-to-target"
    },
    "details": {
      "description": null,
      "evidence": null,
      "warning": null,
      "suggestedAction": null
    },
    "metadata": {
      "discoveredBy": null,
      "verifiedBy": null,
      "verifiedAt": null,
      "tags": []
    }
  },
  "scanConfiguration": {
    "rootDirectory": ".",
    "recursive": true,
    "followSymbolicLinks": false,
    "includeHiddenFiles": true,
    "resolveRelativePaths": true,
    "normalizePathSeparators": true,
    "checkPathCaseSensitivity": true,
    "checkExternalUrls": false,
    "checkDynamicReferences": true,
    "checkImports": true,
    "checkHtmlLinks": true,
    "checkCssAssets": true,
    "checkApiRoutes": true,
    "checkEnvironmentVariables": true,
    "checkDatabaseReferences": true,
    "checkWorkflowReferences": true,
    "excludeDirectories": [
      ".git",
      "node_modules",
      ".venv",
      "venv",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      "coverage",
      "dist",
      "build",
      ".next",
      ".cache"
    ],
    "excludePatterns": [
      "*.min.js",
      "*.min.css",
      "*.map",
      "*.lock",
      "*.log"
    ],
    "maximumFileSizeBytes": 5242880,
    "ignorePatterns": [
      "data:image/",
      "javascript:void(0)",
      "#",
      "mailto:",
      "tel:"
    ]
  },
  "resolutionRules": {
    "relativePaths": {
      "enabled": true,
      "resolveFromSourceDirectory": true,
      "normalizeDotSegments": true,
      "checkFileAndDirectoryTargets": true
    },
    "javascriptImports": {
      "enabled": true,
      "extensions": [
        ".js",
        ".mjs",
        ".cjs",
        ".json",
        ".ts",
        ".tsx"
      ],
      "checkPackageImports": true,
      "checkAliases": true
    },
    "pythonImports": {
      "enabled": true,
      "checkLocalModules": true,
      "checkPackages": true,
      "respectPackageRoots": true
    },
    "htmlReferences": {
      "enabled": true,
      "attributes": [
        "href",
        "src",
        "srcset",
        "action",
        "poster"
      ],
      "checkAnchorTargets": true,
      "checkLocalAssets": true
    },
    "cssReferences": {
      "enabled": true,
      "patterns": [
        "@import",
        "url()"
      ],
      "checkLocalAssets": true
    },
    "apiReferences": {
      "enabled": true,
      "checkFrontendBackendMatches": true,
      "checkRouteMountPrefixes": true,
      "checkHttpMethods": true,
      "checkControllerTargets": true
    },
    "environmentVariables": {
      "enabled": true,
      "compareWithExampleFiles": true,
      "compareWithConfigurationFiles": true,
      "neverExposeSecretValues": true
    },
    "databaseReferences": {
      "enabled": true,
      "checkTables": true,
      "checkColumns": true,
      "checkMigrations": true,
      "checkModelMappings": true
    },
    "externalUrls": {
      "enabled": false,
      "requireExplicitNetworkPermission": true,
      "storeCredentials": false
    }
  },
  "dynamicReferencePolicy": {
    "enabled": true,
    "recognizePatterns": [
      "import()",
      "require()",
      "path.join()",
      "path.resolve()",
      "process.env",
      "template literals",
      "computed property access",
      "runtime route registration",
      "database-generated identifiers"
    ],
    "statusWhenNotProvable": "dynamic",
    "neverAssumeResolution": true,
    "requireRuntimeEvidenceForVerification": true
  },
  "securityRules": {
    "neverStoreSecretValues": true,
    "neverStoreAccessTokens": true,
    "neverStorePasswords": true,
    "neverStorePrivateKeys": true,
    "redactSensitiveQueryParameters": true,
    "redactCredentialsFromUrls": true,
    "flagHardcodedSecretReferences": true,
    "doNotFollowUntrustedExternalReferences": true
  },
  "validationRules": [
    {
      "id": "REF-001",
      "name": "missing-local-target",
      "description": "A local reference points to a file or directory that cannot be resolved.",
      "severity": "high"
    },
    {
      "id": "REF-002",
      "name": "invalid-import",
      "description": "A source file imports a module that cannot be resolved.",
      "severity": "critical"
    },
    {
      "id": "REF-003",
      "name": "broken-navigation",
      "description": "A navigation link points to a missing local page.",
      "severity": "medium"
    },
    {
      "id": "REF-004",
      "name": "missing-asset",
      "description": "An HTML or CSS reference points to a missing asset.",
      "severity": "medium"
    },
    {
      "id": "REF-005",
      "name": "missing-api-endpoint",
      "description": "A frontend API call does not match a registered backend route.",
      "severity": "high"
    },
    {
      "id": "REF-006",
      "name": "missing-environment-variable",
      "description": "A required environment variable has no declared configuration entry.",
      "severity": "high"
    },
    {
      "id": "REF-007",
      "name": "missing-database-object",
      "description": "A database reference cannot be matched to a known schema or migration.",
      "severity": "high"
    },
    {
      "id": "REF-008",
      "name": "unverified-dynamic-reference",
      "description": "A dynamic reference cannot be resolved through static analysis.",
      "severity": "info"
    },
    {
      "id": "REF-009",
      "name": "deprecated-reference",
      "description": "A reference targets a deprecated file, route, module, or configuration key.",
      "severity": "medium"
    },
    {
      "id": "REF-010",
      "name": "duplicate-reference",
      "description": "Equivalent references may create duplicate or conflicting behavior.",
      "severity": "low"
    },
    {
      "id": "REF-011",
      "name": "case-sensitive-path-mismatch",
      "description": "A path works on some filesystems but has incorrect letter casing.",
      "severity": "high"
    },
    {
      "id": "REF-012",
      "name": "unregistered-route",
      "description": "A route file or controller is not connected to the application router.",
      "severity": "high"
    }
  ],
  "findings": [],
  "ignoredReferences": [],
  "deprecatedReferences": [],
  "duplicateReferences": [],
  "scanErrors": [],
  "repairPolicy": {
    "automaticRepairEnabled": false,
    "requireExplicitApproval": true,
    "requireBackup": true,
    "allowedActions": [
      "suggest-correction",
      "generate-patch",
      "validate-proposed-target",
      "produce-reference-map"
    ],
    "forbiddenActions": [
      "blind-path-replacement",
      "automatic-file-deletion",
      "automatic-route-registration",
      "automatic-api-rewriting",
      "automatic-environment-secret-generation",
      "automatic-database-schema-modification",
      "unreviewed-source-overwrite"
    ]
  },
  "integration": {
    "consumedBy": [
      "/tools/repository-reports/summary.json",
      "/tools/repository-reports/unresolved-references.json",
      "/tools/repository-reports/broken-references.json",
      "/tools/repository-reports/dependency-edges.json",
      "/tools/repository-reports/folder-index-map.json",
      "/tools/repository-reports/page-connection-suggestions.json"
    ],
    "updateSummaryAfterScan": true,
    "preserveHistoricalResults": true
  },
  "outputs": {
    "jsonReport": "/tools/repository-reports/references.json",
    "csvReport": "/tools/repository-reports/references.csv",
    "graphReport": "/tools/repository-reports/reference-graph.json",
    "logFile": "/tools/repository-reports/logs/references.log"
  },
  "exitPolicy": {
    "success": 0,
    "unresolvedReferencesFound": 1,
    "scannerFailure": 2,
    "strictModeDynamicReferences": 3,
    "forceMode": "Continue scanning after individual errors while preserving a non-zero final exit status when unresolved critical references remain."
  }
}
