
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "report": {
    "name": "MedOrbits Repository File Inventory",
    "version": "1.0.0",
    "project": "MedOrbits",
    "generatedAt": null,
    "generator": "tools/repository-reports",
    "status": "baseline",
    "description": "Comprehensive inventory of repository files, metadata, checksums, Git tracking information, validation status, and integrity findings."
  },
  "repository": {
    "root": ".",
    "name": "MedOrbits",
    "manifest": "package.json",
    "lockfile": "package-lock.json",
    "entryPoint": "server.js",
    "inventoryScope": "repository",
    "pathFormat": "relative-posix"
  },
  "summary": {
    "totalFiles": 0,
    "totalDirectories": 0,
    "totalSizeBytes": 0,
    "totalSizeMB": 0,
    "trackedFiles": 0,
    "untrackedFiles": 0,
    "ignoredFiles": 0,
    "hiddenFiles": 0,
    "emptyFiles": 0,
    "executableFiles": 0,
    "binaryFiles": 0,
    "textFiles": 0,
    "symlinks": 0,
    "missingFiles": 0,
    "unreadableFiles": 0,
    "duplicateFiles": 0,
    "invalidFiles": 0,
    "unverifiedFiles": 0
  },
  "fileTypes": {
    "javascript": {
      "extensions": [
        ".js",
        ".mjs",
        ".cjs"
      ],
      "count": 0,
      "totalSizeBytes": 0
    },
    "typescript": {
      "extensions": [
        ".ts",
        ".tsx"
      ],
      "count": 0,
      "totalSizeBytes": 0
    },
    "python": {
      "extensions": [
        ".py",
        ".pyi"
      ],
      "count": 0,
      "totalSizeBytes": 0
    },
    "html": {
      "extensions": [
        ".html",
        ".htm"
      ],
      "count": 0,
      "totalSizeBytes": 0
    },
    "stylesheets": {
      "extensions": [
        ".css",
        ".scss",
        ".sass",
        ".less"
      ],
      "count": 0,
      "totalSizeBytes": 0
    },
    "json": {
      "extensions": [
        ".json",
        ".jsonc"
      ],
      "count": 0,
      "totalSizeBytes": 0
    },
    "documentation": {
      "extensions": [
        ".md",
        ".mdx",
        ".rst",
        ".txt"
      ],
      "count": 0,
      "totalSizeBytes": 0
    },
    "configuration": {
      "extensions": [
        ".yml",
        ".yaml",
        ".toml",
        ".ini",
        ".conf",
        ".env.example"
      ],
      "count": 0,
      "totalSizeBytes": 0
    },
    "data": {
      "extensions": [
        ".csv",
        ".xml",
        ".sql",
        ".ndjson"
      ],
      "count": 0,
      "totalSizeBytes": 0
    },
    "images": {
      "extensions": [
        ".png",
        ".jpg",
        ".jpeg",
        ".webp",
        ".gif",
        ".svg",
        ".ico"
      ],
      "count": 0,
      "totalSizeBytes": 0
    },
    "documents": {
      "extensions": [
        ".pdf",
        ".docx",
        ".xlsx",
        ".pptx"
      ],
      "count": 0,
      "totalSizeBytes": 0
    },
    "other": {
      "extensions": [],
      "count": 0,
      "totalSizeBytes": 0
    }
  },
  "scanConfiguration": {
    "recursive": true,
    "includeHidden": true,
    "followSymbolicLinks": false,
    "includeGitTracked": true,
    "includeUntracked": true,
    "includeIgnored": true,
    "includeBinaryFiles": true,
    "calculateSha256": true,
    "calculateLineCount": true,
    "detectEncoding": true,
    "detectEmptyFiles": true,
    "detectExecutableFiles": true,
    "detectDuplicateContent": true,
    "checkFilePermissions": true,
    "checkGitStatus": true,
    "maximumFileSizeMB": 100,
    "ignoreDirectories": [
      ".git",
      "node_modules",
      ".venv",
      "venv",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      "coverage",
      "dist",
      "build"
    ],
    "ignorePatterns": [
      "*.log",
      "*.tmp",
      "*.swp"
    ],
    "hashAlgorithm": "sha256"
  },
  "files": [],
  "fileSchema": {
    "required": [
      "fileId",
      "relativePath",
      "fileName",
      "fileType",
      "sizeBytes",
      "status"
    ],
    "properties": {
      "fileId": {
        "type": "string",
        "description": "Stable unique file identifier."
      },
      "relativePath": {
        "type": "string",
        "description": "Repository-relative POSIX file path."
      },
      "fileName": {
        "type": "string"
      },
      "directory": {
        "type": "string"
      },
      "extension": {
        "type": "string"
      },
      "fileType": {
        "type": "string",
        "enum": [
          "javascript",
          "typescript",
          "python",
          "html",
          "stylesheet",
          "json",
          "documentation",
          "configuration",
          "data",
          "image",
          "document",
          "binary",
          "other"
        ]
      },
      "sizeBytes": {
        "type": "integer",
        "minimum": 0
      },
      "sizeKB": {
        "type": "number",
        "minimum": 0
      },
      "sha256": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-fA-F0-9]{64}$"
      },
      "encoding": {
        "type": [
          "string",
          "null"
        ]
      },
      "lineCount": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      },
      "gitStatus": {
        "type": "string",
        "enum": [
          "added",
          "modified",
          "deleted",
          "untracked",
          "ignored",
          "unchanged",
          "unavailable"
        ]
      },
      "tracked": {
        "type": "boolean"
      },
      "ignored": {
        "type": "boolean"
      },
      "hidden": {
        "type": "boolean"
      },
      "executable": {
        "type": "boolean"
      },
      "empty": {
        "type": "boolean"
      },
      "binary": {
        "type": "boolean"
      },
      "symlink": {
        "type": "boolean"
      },
      "syntaxStatus": {
        "type": "string",
        "enum": [
          "valid",
          "invalid",
          "not-applicable",
          "unverified"
        ]
      },
      "jsonStatus": {
        "type": "string",
        "enum": [
          "valid",
          "invalid",
          "not-applicable",
          "unverified"
        ]
      },
      "referenceStatus": {
        "type": "string",
        "enum": [
          "verified",
          "broken",
          "unresolved",
          "not-applicable",
          "unverified"
        ]
      },
      "duplicateStatus": {
        "type": "string",
        "enum": [
          "unique",
          "duplicate",
          "similar",
          "unverified"
        ]
      },
      "securityStatus": {
        "type": "string",
        "enum": [
          "passed",
          "warning",
          "failed",
          "not-scanned",
          "not-applicable"
        ]
      },
      "lastModified": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "lastScanned": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "detectedBy": {
        "type": [
          "string",
          "null"
        ]
      },
      "notes": {
        "type": "string"
      }
    }
  },
  "git": {
    "enabled": true,
    "branch": null,
    "commit": null,
    "workingTreeStatus": "unknown",
    "includeIgnoredFiles": true,
    "includeUntrackedFiles": true,
    "includeSubmodules": false,
    "detectRenames": true,
    "detectDeletions": true
  },
  "integrity": {
    "verifiedAgainstRepository": false,
    "lastScan": null,
    "scannerVersion": null,
    "filesScanned": 0,
    "directoriesScanned": 0,
    "hashesCalculated": 0,
    "warnings": [
      "This is an initial inventory configuration, not a verified repository listing.",
      "An empty files array does not mean the repository contains no files.",
      "Ignored files and excluded directories must be reported separately.",
      "Symbolic links must not be followed outside the repository root.",
      "File hashes must be calculated from actual file bytes.",
      "Secret values must never be copied into inventory metadata.",
      "Generated reports should not recursively include their own previous output unless explicitly requested."
    ]
  },
  "outputs": {
    "json": "tools/repository-reports/file-inventory.json",
    "csv": "tools/repository-reports/file-inventory.csv",
    "markdown": "tools/repository-reports/file-inventory.md"
  },
  "generation": {
    "automatic": false,
    "stableFileIds": true,
    "preserveHistoricalMetadata": true,
    "preserveGitStatus": true,
    "atomicWrite": true,
    "generateCsv": true,
    "generateMarkdown": true,
    "overwriteExisting": true
  }
}
