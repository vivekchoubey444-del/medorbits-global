# ==============================================================================
# MedOrbits -- Test Environment Example
# File: /.env.test.example
# Release: 3.0.0
# Runtime: Node.js 20+ (prefer a currently supported Node.js LTS release)
# Backend: Express.js
# Database: MySQL
#
# Purpose:
#   Document optional test configuration using synthetic data and isolated
#   infrastructure. This template contains no production credentials.
#
# Usage:
#   cp .env.test.example .env.test
#   Configure unique local test secrets and database credentials.
#   Load .env.test explicitly from the test runner.
#
# SECURITY:
#   Never use production databases, credentials, customer records, or live
#   payment/email/SMS integrations during automated tests.
#   Variables only have an effect if application code consumes them.
# ==============================================================================


# ------------------------------------------------------------------------------
# 01. TEST RUNTIME
# ------------------------------------------------------------------------------

NODE_ENV=test
APP_NAME=MedOrbits
APP_VERSION=3.0.0
APP_ENVIRONMENT=test

HOST=127.0.0.1
PORT=3101
API_PREFIX=/api/v1

APP_URL=http://127.0.0.1:3101
API_PUBLIC_URL=http://127.0.0.1:3101/api/v1
FRONTEND_URL=http://127.0.0.1:3101

DEBUG=false
ENABLE_STACK_TRACES=false
ENABLE_STARTUP_BANNER=false
ENABLE_GRACEFUL_SHUTDOWN=true

SHUTDOWN_TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=10000
HEADERS_TIMEOUT_MS=12000
KEEP_ALIVE_TIMEOUT_MS=1000

# Keep the test runner and application environment aligned.
TEST_MODE=true
ENABLE_TEST_ROUTES=false
ENABLE_DEMO_DATA=false


# ------------------------------------------------------------------------------
# 02. ISOLATED MYSQL DATABASE
# ------------------------------------------------------------------------------

DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medorbits_test
DB_USER=medorbits_test
DB_PASSWORD=

DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=5000
DB_QUEUE_LIMIT=25
DB_CHECK_ON_START=true

DB_ENABLE_KEEP_ALIVE=false
DB_KEEP_ALIVE_INITIAL_DELAY_MS=0
DB_IDLE_TIMEOUT_MS=10000
DB_MAX_IDLE_CONNECTIONS=2

DB_QUERY_TIMEOUT_MS=10000
DB_SLOW_QUERY_THRESHOLD_MS=500
DB_LOG_QUERIES=false
DB_LOG_PARAMETERS=false
DB_MULTIPLE_STATEMENTS=false

DB_DEFAULT_ISOLATION_LEVEL=READ COMMITTED
DB_TRANSACTION_TIMEOUT_MS=15000

DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true

DB_READ_REPLICA_ENABLED=false
DB_AUTO_MIGRATE=false
DB_SEED_ON_START=false

# Optional adapter-supported connection URL.
# Do not populate with production credentials.
# DATABASE_URL=mysql://medorbits_test:LOCAL_TEST_PASSWORD@127.0.0.1:3306/medorbits_test

# Optional dedicated test-runner connection.
# Configure only if the application or test tooling supports these names.
# TEST_DATABASE_URL=
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_NAME=medorbits_test
# TEST_DB_USER=medorbits_test
# TEST_DB_PASSWORD=


# ------------------------------------------------------------------------------
# 03. AUTHENTICATION AND SESSION TESTING
# ------------------------------------------------------------------------------

# Supply unique random local secrets when the application requires them.
# Never reuse production secrets.
SESSION_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_ISSUER=http://127.0.0.1:3101
JWT_AUDIENCE=medorbits-test-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=1h
JWT_ALGORITHM=HS256

JWT_REFRESH_ROTATION=true
JWT_REVOKE_ON_LOGOUT=true
JWT_CLOCK_TOLERANCE_SECONDS=30

PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=false

# Low bcrypt cost is appropriate only for isolated test fixtures.
# Never copy this test value into production configuration.
PASSWORD_BCRYPT_ROUNDS=4

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=60000
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_ALLOW_SELF_REGISTRATION=true
AUTH_REQUIRE_MFA_FOR_ADMIN=false

PASSWORD_RESET_TOKEN_TTL_MINUTES=5
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=1


# ------------------------------------------------------------------------------
# 04. COOKIES AND CSRF
# ------------------------------------------------------------------------------

SESSION_ENABLED=true
SESSION_COOKIE_NAME=medorbits.test.sid
SESSION_TTL_MS=3600000
SESSION_STORE=mysql

COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/
COOKIE_DOMAIN=
COOKIE_PARTITIONED=false

CSRF_PROTECTION_ENABLED=true
CSRF_COOKIE_NAME=medorbits.test.csrf
CSRF_HEADER_NAME=X-CSRF-Token


# ------------------------------------------------------------------------------
# 05. AUTHORIZATION AND RATE LIMITING
# ------------------------------------------------------------------------------

RBAC_ENABLED=true
ADMIN_MFA_REQUIRED=false
ADMIN_SESSION_TTL_MS=1800000
ADMIN_IDLE_TIMEOUT_MS=300000
ADMIN_REQUIRE_VERIFIED_EMAIL=false

# Disabled to simplify isolated tests; add dedicated tests with it enabled.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=100

PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=60000
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=100

UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=100

SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX_REQUESTS=100

RATE_LIMIT_STORE=memory
RATE_LIMIT_KEY_STRATEGY=ip


# ------------------------------------------------------------------------------
# 06. CORS AND SECURITY HEADERS
# ------------------------------------------------------------------------------

ALLOWED_ORIGINS=http://127.0.0.1:3101,http://localhost:3101
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3101,http://localhost:3101
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=60

CORS_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Request-ID,X-Correlation-ID,X-CSRF-Token

ENABLE_SECURITY_HEADERS=true
ENABLE_CSP=false
CROSS_ORIGIN_RESOURCE_POLICY=same-site
REFERRER_POLICY=strict-origin-when-cross-origin
TRUST_PROXY_HOPS=0


# ------------------------------------------------------------------------------
# 07. EMAIL -- DISABLED
# ------------------------------------------------------------------------------

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

EMAIL_FROM_NAME=MedOrbits Test
EMAIL_FROM_ADDRESS=test-no-reply@localhost
EMAIL_REPLY_TO=test-support@localhost

EMAIL_SEND_TIMEOUT_MS=3000
EMAIL_CONNECTION_TIMEOUT_MS=3000
EMAIL_GREETING_TIMEOUT_MS=3000
EMAIL_SOCKET_TIMEOUT_MS=5000

EMAIL_POOLING_ENABLED=false
EMAIL_MAX_CONNECTIONS=1
EMAIL_MAX_MESSAGES=10
EMAIL_RETRY_ENABLED=false
EMAIL_MAX_RETRIES=0

EMAIL_VERIFICATION_ENABLED=false
PASSWORD_RESET_EMAIL_ENABLED=false
APPLICATION_CONFIRMATION_EMAIL_ENABLED=false
JOB_ALERT_EMAIL_ENABLED=false
NEWSLETTER_EMAIL_ENABLED=false


# ------------------------------------------------------------------------------
# 08. FILE UPLOADS AND DOCUMENTS
# ------------------------------------------------------------------------------

UPLOADS_ENABLED=true
UPLOAD_MAX_FILE_SIZE_BYTES=1048576
UPLOAD_MAX_FILES=3
UPLOAD_MAX_TOTAL_SIZE_BYTES=3145728

UPLOAD_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png
UPLOAD_DIRECTORY=storage/test-uploads
UPLOAD_TEMP_DIRECTORY=storage/test-tmp

UPLOAD_FILENAME_STRATEGY=random
UPLOAD_OVERWRITE_EXISTING=false
UPLOAD_PRESERVE_ORIGINAL_FILENAME=false
UPLOAD_VALIDATE_SIGNATURE=true
UPLOAD_SCAN_FOR_MALWARE=false
UPLOAD_REJECT_EXECUTABLES=true

DOCUMENTS_PRIVATE=true
DOCUMENT_DOWNLOAD_AUTH_REQUIRED=true
DOCUMENT_SIGNED_URLS_ENABLED=false
DOCUMENT_SIGNED_URL_TTL_SECONDS=60

OBJECT_STORAGE_ENABLED=false


# ------------------------------------------------------------------------------
# 09. APPLICATIONS AND ADMISSIONS
# ------------------------------------------------------------------------------

APPLICATIONS_ENABLED=true
APPLICATIONS_REQUIRE_AUTH=true
APPLICATIONS_ALLOW_DRAFTS=true
APPLICATIONS_MAX_PER_USER=5
APPLICATIONS_REFERENCE_PREFIX=TEST
APPLICATIONS_REFERENCE_RANDOM_BYTES=4

APPLICATION_DOCUMENTS_ENABLED=true
APPLICATION_DOCUMENT_REVIEW_REQUIRED=true
APPLICATION_DOCUMENT_VERSIONING=true
APPLICATION_DOCUMENT_MAX_VERSIONS=3

APPLICATION_NOTIFY_ON_SUBMISSION=false
APPLICATION_NOTIFY_ON_STATUS_CHANGE=false
APPLICATION_REQUIRE_ADMIN_REVIEW=true

APPLICATION_DATA_RETENTION_DAYS=7
APPLICATION_AUTO_DELETE_EXPIRED=false


# ------------------------------------------------------------------------------
# 10. CAREERS AND RECRUITMENT
# ------------------------------------------------------------------------------

JOBS_ENABLED=true
JOB_APPLICATIONS_ENABLED=true
EMPLOYER_ACCOUNTS_ENABLED=true
RECRUITMENT_SERVICES_ENABLED=true
CAREER_GUIDANCE_ENABLED=true
RESUME_UPLOAD_ENABLED=true

JOB_ALERTS_ENABLED=false
JOB_ALERT_DIGEST_FREQUENCY=daily

JOB_LISTING_DEFAULT_STATUS=pending_review
JOB_LISTING_REQUIRE_MODERATION=true
JOB_LISTING_MAX_ACTIVE_PER_EMPLOYER=10

EXTERNAL_JOB_FEEDS_ENABLED=false
EXTERNAL_JOB_FEED_SYNC_INTERVAL_MINUTES=60


# ------------------------------------------------------------------------------
# 11. AI -- DISABLED
# ------------------------------------------------------------------------------

AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_API_URL=
AI_API_KEY=

AI_REQUEST_TIMEOUT_MS=5000
AI_MAX_RETRIES=0
AI_MAX_OUTPUT_TOKENS=256
AI_TEMPERATURE=0

AI_ADMISSIONS_ASSISTANT_ENABLED=false
AI_CAREER_ASSISTANT_ENABLED=false
AI_RESUME_ASSISTANT_ENABLED=false
AI_DOCUMENT_EXTRACTION_ENABLED=false
AI_CHAT_HISTORY_ENABLED=false

AI_REQUIRE_USER_CONSENT=true
AI_SEND_PERSONAL_DOCUMENTS=false
AI_REDACT_PERSONAL_DATA=true
AI_LOG_PROMPTS=false
AI_LOG_RESPONSES=false


# ------------------------------------------------------------------------------
# 12. PAYMENTS AND SUBSCRIPTIONS -- DISABLED
# ------------------------------------------------------------------------------

PAYMENT_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=INR
PAYMENT_CAPTURE_MODE=automatic
PAYMENT_REQUEST_TIMEOUT_MS=5000
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

PAYMENT_IDEMPOTENCY_ENABLED=true
PAYMENT_REQUIRE_WEBHOOK_SIGNATURE=true
PAYMENT_LOG_SENSITIVE_DATA=false

SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_DEFAULT_CURRENCY=INR
SUBSCRIPTION_GRACE_PERIOD_DAYS=0
SUBSCRIPTION_RENEWAL_REMINDERS_ENABLED=false


# ------------------------------------------------------------------------------
# 13. SMS, OTP, AND PUSH NOTIFICATIONS -- DISABLED
# ------------------------------------------------------------------------------

SMS_ENABLED=false
SMS_PROVIDER=
SMS_DEFAULT_COUNTRY_CODE=+91

OTP_ENABLED=false
OTP_LENGTH=6
OTP_TTL_SECONDS=60
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=5
OTP_HASH_AT_REST=true

PUSH_NOTIFICATIONS_ENABLED=false
WEB_PUSH_ENABLED=false


# ------------------------------------------------------------------------------
# 14. WEBHOOKS -- DISABLED
# ------------------------------------------------------------------------------

WEBHOOKS_ENABLED=false
WEBHOOK_SIGNING_SECRET=
WEBHOOK_MAX_RETRIES=0
WEBHOOK_RETRY_DELAY_MS=100
WEBHOOK_TIMEOUT_MS=2000


# ------------------------------------------------------------------------------
# 15. CACHE AND REDIS
# ------------------------------------------------------------------------------

CACHE_ENABLED=false
CACHE_PROVIDER=memory
CACHE_DEFAULT_TTL_SECONDS=10
CACHE_MAX_ENTRIES=100

REDIS_ENABLED=false
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_KEY_PREFIX=medorbits:test:

DISTRIBUTED_LOCKS_ENABLED=false


# ------------------------------------------------------------------------------
# 16. BACKGROUND JOBS -- DISABLED
# ------------------------------------------------------------------------------

WORKERS_ENABLED=false
SCHEDULER_ENABLED=false

JOB_QUEUE_PROVIDER=database
JOB_QUEUE_MAX_ATTEMPTS=1
JOB_QUEUE_RETRY_DELAY_MS=100
JOB_QUEUE_CONCURRENCY=1
JOB_QUEUE_POLL_INTERVAL_MS=1000

SCHEDULE_EMAIL_DIGESTS=false
SCHEDULE_APPLICATION_REMINDERS=false
SCHEDULE_JOB_FEED_SYNC=false
SCHEDULE_CLEANUP_TASKS=false


# ------------------------------------------------------------------------------
# 17. LOGGING AND AUDITING
# ------------------------------------------------------------------------------

LOG_LEVEL=warn
LOG_FORMAT=text
LOG_REDACT_SENSITIVE=true
LOG_INCLUDE_STACKS=false
LOG_REQUESTS=false
LOG_RESPONSE_BODIES=false
LOG_SQL=false
LOG_SQL_PARAMETERS=false

LOG_MAX_FIELD_LENGTH=200
LOG_RETENTION_DAYS=1

REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID
GENERATE_REQUEST_ID=true

AUDIT_LOG_ENABLED=true
AUDIT_LOG_AUTH_EVENTS=true
AUDIT_LOG_ADMIN_ACTIONS=true
AUDIT_LOG_DOCUMENT_ACCESS=true
AUDIT_LOG_RETENTION_DAYS=7


# ------------------------------------------------------------------------------
# 18. SEARCH AND SEO
# ------------------------------------------------------------------------------

SEARCH_ENABLED=true
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=25
SEARCH_MIN_QUERY_LENGTH=2

SEO_ENABLED=false
SITEMAP_ENABLED=false
ROBOTS_TXT_ENABLED=false

EXTERNAL_SEARCH_ENABLED=false


# ------------------------------------------------------------------------------
# 19. HEALTH, METRICS, AND ERROR TRACKING
# ------------------------------------------------------------------------------

HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live

HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_REDIS=false
HEALTH_CHECK_EMAIL=false

METRICS_ENABLED=false
METRICS_PATH=/metrics
METRICS_REQUIRE_AUTH=true
DETAILED_HEALTH_REQUIRE_AUTH=true

ERROR_TRACKING_ENABLED=false
TRACING_ENABLED=false


# ------------------------------------------------------------------------------
# 20. API DOCUMENTATION AND PAGINATION
# ------------------------------------------------------------------------------

OPENAPI_ENABLED=true
OPENAPI_PATH=/docs
OPENAPI_PUBLIC=false

API_DEPRECATION_HEADERS_ENABLED=true
API_DEFAULT_PAGE_SIZE=10
API_MAX_PAGE_SIZE=25


# ------------------------------------------------------------------------------
# 21. OUTBOUND HTTP CLIENTS
# ------------------------------------------------------------------------------

EXTERNAL_API_TIMEOUT_MS=3000
EXTERNAL_API_MAX_RETRIES=0
EXTERNAL_API_RETRY_DELAY_MS=100

OUTBOUND_HTTP_ALLOW_PRIVATE_IPS=false
OUTBOUND_HTTP_FOLLOW_REDIRECTS=false


# ------------------------------------------------------------------------------
# 22. PRIVACY AND DATA RETENTION
# ------------------------------------------------------------------------------

PRIVACY_CONTACT_EMAIL=test-support@localhost
DATA_EXPORT_ENABLED=true
ACCOUNT_DELETION_ENABLED=true
CONSENT_RECORDING_ENABLED=true

LOG_PERSONAL_DATA=false
STORE_IP_ADDRESSES=false
ANALYTICS_ENABLED=false
ANALYTICS_ANONYMIZE_IP=true

MARKETING_CONSENT_REQUIRED=true
COOKIE_CONSENT_ENABLED=true


# ------------------------------------------------------------------------------
# 23. SEARCHABLE CONTENT AND FEATURE FLAGS
# ------------------------------------------------------------------------------

FEATURE_COURSES=true
FEATURE_COLLEGES=true
FEATURE_UNIVERSITIES=true
FEATURE_SCHOLARSHIPS=true
FEATURE_ADMISSIONS=true
FEATURE_CAREERS=true
FEATURE_RECRUITMENT=true
FEATURE_HOSTELS=true
FEATURE_NEWS=true
FEATURE_TESTIMONIALS=true
FEATURE_CONTACT_FORMS=true

FEATURE_SOCIAL_LOGIN=false
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_PUBLIC_PROFILES=false
FEATURE_NEWSLETTER=false


# ------------------------------------------------------------------------------
# 24. OAUTH -- DISABLED
# ------------------------------------------------------------------------------

OAUTH_ENABLED=false

# Configure only with provider-specific test credentials if needed.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://127.0.0.1:3101/api/v1/auth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://127.0.0.1:3101/api/v1/auth/github/callback


# ------------------------------------------------------------------------------
# 25. BACKUP AND RECOVERY -- DISABLED
# ------------------------------------------------------------------------------

BACKUP_ENABLED=false
BACKUP_ENCRYPTION_REQUIRED=true
BACKUP_RETENTION_DAYS=1


# ------------------------------------------------------------------------------
# 26. OPTIONAL OBSERVABILITY
# ------------------------------------------------------------------------------

# Enable only when the matching integration is implemented and configured.
# SENTRY_DSN=
# ERROR_TRACKING_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=medorbits-test


# ------------------------------------------------------------------------------
# 27. TEST RUNNER INTEGRATION
# ------------------------------------------------------------------------------

# Vitest-specific behavior should primarily be configured in vitest.config.js.
# These variables are optional and only apply if custom test utilities read them.

TEST_TIMEOUT_MS=10000
TEST_HOOK_TIMEOUT_MS=10000
TEST_CLEANUP_ENABLED=true
TEST_PARALLELISM=1
TEST_USE_SYNTHETIC_DATA=true

# Use a dedicated disposable database and test-owned storage paths.
# Never point test cleanup at shared or production resources.


# ------------------------------------------------------------------------------
# 28. PRE-RUN SAFETY CHECKLIST
# ------------------------------------------------------------------------------

# [ ] NODE_ENV is test.
# [ ] The database is a dedicated disposable test database.
# [ ] The database account has only the required test privileges.
# [ ] Credentials and signing secrets are unique to this environment.
# [ ] External email, SMS, AI, payment, and webhook integrations are disabled.
# [ ] Uploaded files are written to test-owned directories.
# [ ] Test fixtures contain synthetic data.
# [ ] Destructive cleanup is restricted to test-owned records.
# [ ] The test runner explicitly loads this file.
# [ ] Application code actually consumes each variable being tested.
#
# This example does not create a database, load environment variables,
# configure integrations, or enforce the values listed above.
# Treat every variable as documentation until verified in application code.
#
# ==============================================================================
# END OF .env.test.example
# ==============================================================================