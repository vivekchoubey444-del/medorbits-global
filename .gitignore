# ------------------------------------------------------------

/uploads-local/
/local-uploads/
/user-uploads-local/
/storage-local/
/media-local/

*.uploading
*.part
*.partial
*.chunk

# Do not globally ignore public/assets/ or public/uploads/.


# ------------------------------------------------------------
