# ------------------------------------------------------------

.vercel/
.netlify/

.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

.serverless/
.aws-sam/
.docker/

.terraform/
*.tfstate
.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local Compose overrides may contain private configuration.
docker-compose.override.yaml
docker-compose.override.yml


# ------------------------------------------------------------
# 18. CLOUD CLI LOCAL STATE
# ------------------------------------------------------------

.aws/
.gcloud/
.azure/

# Review provider-specific rules before adding credential patterns.


# ------------------------------------------------------------
# 19. LOCAL APPLICATION STATE
# ------------------------------------------------------------

.runtime/
/.instance/

.metadata-local/
.project-cache/
.application-cache/

nodemon-debug.log


# ------------------------------------------------------------
# 20. ARCHIVES AND LARGE FILES
# ------------------------------------------------------------

# Intentionally do not ignore these globally:
# *.zip, *.7z, *.rar, *.tar, *.tar.gz
# *.pdf, *.png, *.jpg, *.xlsx
#
# They may be maintained assets, public documents or release files.


# ------------------------------------------------------------
# 21. MACHINE LEARNING AND DATA SCIENCE ARTIFACTS
# ------------------------------------------------------------

.cache/huggingface/
.cache/torch/
.cache/models/

# Enable only if model artifacts should not be tracked:
# *.pt
# *.pth
# *.onnx
# *.safetensors
# *.model

# Optional generated datasets; preserve approved source data.
# /datasets/raw/
# /datasets/processed/
# /data/raw/
# /data/processed/


# ------------------------------------------------------------
# 22. LOCAL TOOL STATE AND PROFILING
# ------------------------------------------------------------

.deno/
.volta-local/
.vscode-test/
.debug/
.debug-cache/
.sessions-local/
.tasks-local/
.worktrees-local/

.prof/
*.prof
*.profraw
*.profdata


# ------------------------------------------------------------
# 23. LOCAL API CLIENT STATE
# ------------------------------------------------------------

.http-client.private.env.json
.rest-client.private.env.json

.api-history/
.http-cache/
.integration-cache/


# ------------------------------------------------------------
# 24. PRIVATE REPORTS AND SECURITY TOOL OUTPUT
# ------------------------------------------------------------

/exports-private/
/reports-private/
/private-reports/
/confidential-exports/
/internal-exports/

.secret-scan-local/
.gitleaks-local/
.trufflehog-local/
.dependency-audit-local/
.security-report-local/


# ------------------------------------------------------------
# 25. OFFICE APPLICATION TEMPORARY FILES
# ------------------------------------------------------------

~$.doc
~$.docx
~$.xls
~$.xlsx
~$.ppt
~$.pptx


# ------------------------------------------------------------
# 26. OPTIONAL GENERATED BUNDLES AND SOURCE MAPS
# ------------------------------------------------------------

# Uncomment only if the repository does not intentionally track builds.
# *.min.js
# *.min.css
# *.map


# ------------------------------------------------------------
# 27. MEDORBITS SOURCE PRESERVATION
# ------------------------------------------------------------

# Keep maintained source, sanitized examples, and required configuration:
# - HTML, CSS, JavaScript, TypeScript and Python source
# - pages/, assets/, public/assets/ and public website files
# - Official public documents, brochures and approved media
# - JSON data, schemas and sanitized test fixtures
# - Tests, test helpers and test configuration
# - README, LICENSE, SECURITY and contribution documentation
# - package.json and dependency lockfiles
# - .github/workflows/ and reviewed CI configuration
# - .husky/ and required hooks
# - Reviewed Dockerfiles and deployment manifests
# - Database migrations, schemas and development fixtures
# - Required runtime files such as .nvmrc
#
# Ignore rules do not add files to Git or restore ignored parent directories.


# ============================================================
# END OF MEDORBITS ROOT .gitignore
# ============================================================
!/.env

