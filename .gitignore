/logs/
/log/

*.log
*.pid
*.pid.lock
*.seed

/pids/
/.pm2/
/.pids/

core
core.*
*.core
*.stackdump

crash.log
error.log
debug.log
trace.log
server-output.log
application-debug.log
request-debug.log
access.log
error-report.log


