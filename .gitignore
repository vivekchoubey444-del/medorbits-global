# ------------------------------------------------------------

*.tmp
*.temp
*.swp
*.swo
*.swn
*.orig
*.rej
*.patch~
*~

/tmp/
/temp/
/.tmp/
/.temp/
/.cache-tmp/

*.lock.tmp
*.pid.tmp

# Do not ignore package lockfiles.


