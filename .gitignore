
# ============================================================
# MedOrbits -- Root Git Ignore Policy
# File: .gitignore
# Policy version: 3.1.1
# Runtime: Node.js >=20
# ============================================================
#
# SECURITY:
# - Never commit .env or real credentials.
# - .gitignore does not untrack committed files.
# - Rotate exposed credentials and assess Git history if secrets leak.
# - Keep sanitized templates such as .env.example tracked.
# ============================================================


# ------------------------------------------------------------
# 01. ENVIRONMENT FILES AND LOCAL CONFIGURATION
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.development.example
!.env.test.example
!.env.production.example
!.env.staging.example

.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local

*.local.env
local.env
development.env
staging.env
production.env

secrets.env
secret.env
credentials.env
credentials.local.*
secrets.local.*

config.local.*
settings.local.*
nodemon.local.json
.envrc.local


# ------------------------------------------------------------
# 02. SECRETS, TOKENS AND CREDENTIALS
# ------------------------------------------------------------

/secrets/
/private-secrets/
/local-secrets/
/credentials/
/private-credentials/

api-key.txt
api-keys.txt
api_key.txt
api_keys.txt
service-account.json
service-account-key.json
google-credentials.json
firebase-adminsdk*.json
application_default_credentials.json
cloud-credentials.json
cloud-service-account.json
deployment-credentials.json

tokens.json
access-token.txt
refresh-token.txt
session-token.txt
auth-token.txt
cookies.txt
cookies.json

*.secret
*.secrets
*.token
*.tokens
*.credential
*.credentials

.auth-cache/
.token-cache/
.local-auth/


# ------------------------------------------------------------
# 03. PRIVATE KEYS AND LOCAL TLS MATERIAL
# ------------------------------------------------------------

*.key
*.p12
*.pfx
*.keystore
*.jks
*.ppk

id_rsa
id_dsa
id_ecdsa
id_ed25519
ssh_host_*

private-key.*
private_key.*
server.key
client.key
tls.key
signing-key.*
signing_key.*

.local-certs/
.dev-certs/
certs/private/
certificates/private/

# Do not globally ignore *.pem, *.crt or *.cer.
# Inspect files before committing them.


# ------------------------------------------------------------
# 04. DATABASES AND LOCAL BACKUPS
# ------------------------------------------------------------

*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
*.sqlite3-journal

/.local-db/
/.local-database/
/database/local/
/database/backups/
/db/backups/
/backups/database/

.pgpass
.pg_service.conf
.my.cnf
.mysql_history

# Do not globally ignore SQL migrations, schemas or sanitized fixtures.


# ------------------------------------------------------------
# 05. PRIVATE USER DATA AND DOCUMENTS
# ------------------------------------------------------------

/private-data/
/private-data-local/
/local-private-data/
/user-data-private/
/private-uploads/
/private-documents/
/private-files/
/private-storage/
/private-records/

.local-data/
.local-uploads/
.local-storage/
.local-documents/

*.personal-data
*.private-export
*.user-export


# ------------------------------------------------------------
# 06. NODE.JS AND PACKAGE MANAGER ARTIFACTS
# ------------------------------------------------------------

node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

.npm/
.npm-cache/
.pnpm-store/

.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

.bun/

# Preserve package.json, package-lock.json and intentional lockfiles.


# ------------------------------------------------------------
# 07. BUILD OUTPUTS AND FRAMEWORK ARTIFACTS
# ------------------------------------------------------------

/dist/
/build/
/out/
/site-build/
/release-build/
/generated-build/

.next/
