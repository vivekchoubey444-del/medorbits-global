
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "manifestVersion": "3.0.0",
  "project": "MedOrbits",
  "description": "Repository architecture, runtime, validation, security and release manifest.",
  "manifestType": "project-manifest",
  "manifestFormat": "json",
  "manifestPath": "/project.manifest.json",
  "lastUpdated": "2026-11-01",

  "package": {
    "name": "medorbits",
    "version": "3.0.0",
    "type": "all-in-one-repository-starter",
    "status": "starter-scaffold",
    "license": "MIT",
    "licenseFile": "LICENSE",
    "supplementaryNotice": "NOTICE"
  },

  "release": {
    "version": "3.0.0",
    "versioningScheme": "semver",
    "releaseChannel": "development",
    "releaseStatus": "pre-release",
    "tagPrefix": "v",
    "tagType": "annotated",
    "automaticCommit": false,
    "automaticPush": false,
    "automaticDeployment": false,
    "cleanWorkingTreeRequired": true,
    "existingTagsMustNotBeOverwritten": true,
    "productionReadinessMustBeVerifiedSeparately": true,
    "releaseUtility": "RELEASE.sh",
    "pushUtility": "PUSH.sh"
  },

  "runtime": {
    "platform": "Node.js",
    "minimumNodeVersion": "22.0.0",
    "versionSource": [
      "package.json:engines.node",
      ".nvmrc"
    ],
    "packageManager": "npm",
    "packageManagerVersion": "10.8.2",
    "packageManifest": "package.json",
    "lockfile": "package-lock.json",
    "nodeVersionFile": ".nvmrc",
    "environmentTemplate": ".env.example",
    "testEnvironmentTemplate": ".env.test.example",
    "moduleSystem": "must-be-verified",
    "moduleSystemPolicy": {
      "packageTypeMustMatchSourceModules": true,
      "esmAndCommonjsInteroperabilityMustBeDocumented": true,
      "serverEntryPointMustMatchModuleSystem": true,
      "noImplicitModuleSystemConversion": true
    },

    "python": {
      "minimumVersion": "3.12",
      "versionTarget": "py312",
      "packageManager": "pip",
      "testRunner": "pytest",
      "lintTool": "ruff",
      "typeChecker": "mypy"
    },

    "entryPoints": {
      "server": {
        "path": "server.js",
        "purpose": "HTTP server bootstrap and application startup",
        "status": "planned",
        "required": true
      },
      "application": {
        "path": "src/app.js",
        "purpose": "Express application construction, middleware and route registration",
        "status": "planned",
        "required": false
      },
      "frontend": {
        "path": "index.html",
        "purpose": "Public website entry page",
        "status": "planned",
        "required": false
      }
    },

    "startupPolicy": {
      "singleDocumentedProductionCommand": true,
      "entryPointMustBeVerified": true,
      "frontendServingStrategyMustBeDocumented": true,
      "environmentVariablesMustBeValidated": true,
      "runtimeVersionMustMatchDeployment": true,
      "lockfileMustMatchPackageManifest": true,
      "productionDependenciesMustBeDeclared": true,
      "secretsMustNotBeCommitted": true,
      "startupMustFailOnInvalidConfiguration": true,
      "databaseConnectionMustBeVerifiedWhenRequired": true,
      "gracefulShutdownMustBeImplemented": true,
      "healthChecksMustReflectApplicationReadiness": true
    },

    "verification": {
      "checkNodeVersion": "node --version",
      "checkNpmVersion": "npm --version",
      "checkPythonVersion": "python --version",
      "installDependencies": "npm ci",
      "validate": "make validate",
      "runTests": "make test",
      "checkDependencies": "make check-dependencies",
      "productionStart": "npm start"
    }
  },

  "repository": {
    "root": ".",

    "configuration": {
      "projectManifest": "project.manifest.json",
      "versionManifest": "VERSION",
      "packageManifest": "package.json",
      "packageLock": "package-lock.json",
      "gitAttributes": ".gitattributes",
      "gitIgnore": ".gitignore",
      "npmIgnore": ".npmignore",
      "prettierIgnore": ".prettierignore",
      "editorConfig": ".editorconfig",
      "prettierConfig": ".prettierrc.json",
      "pytestConfig": "pytest.ini",
      "pythonLintConfig": "ruff.toml",
      "vitestConfig": "vitest.config.js",
      "makefile": "Makefile",
      "environmentTemplate": ".env.example",
      "testEnvironmentTemplate": ".env.test.example"
    },

    "documentation": {
      "readme": "README.md",
      "productionGuide": "README-PRODUCTION.md",
      "packageNotes": "PACKAGE-NOTES.md",
      "changelog": "CHANGELOG.md",
      "contributing": "CONTRIBUTING.md",
      "codeOfConduct": "CODE_OF_CONDUCT.md",
      "security": "SECURITY.md",
      "support": "SUPPORT.md",
      "license": "LICENSE",
      "notice": "NOTICE"
    },

    "scripts": {
      "jsonValidator": "scripts/check-json.mjs",
      "releaseUtility": "RELEASE.sh",
      "pushUtility": "PUSH.sh",
      "verificationUtility": "VERIFY.sh",
      "schemaUtility": "SCHEMA-CHECK.sh",
      "securityUtility": "SECURITY.sh"
    },

    "directories": {
      "api": "api",
      "assets": "assets",
      "documentation": "docs",
      "infrastructure": "infrastructure",
      "python": "python",
      "pythonTests": "python/tests",
      "scripts": "scripts",
      "source": "src",
      "nodeTests": "tests",
      "tools": "tools",
      "publicDocuments": "assets/documents"
    },

    "fileStatusPolicy": {
      "allowedValues": [
        "planned",
        "implemented",
        "verified",
        "deprecated",
        "not-applicable"
      ],
      "requireEvidenceForVerifiedStatus": true,
      "missingRequiredFilesMustFailValidation": true,
      "plannedFilesMustNotBeReportedAsImplemented": true,
      "implementedFilesMustNotAutomaticallyBeReportedAsVerified": true,
      "verificationEvidenceMustIncludeDate": true,
      "verificationEvidenceMustIdentifyTheCheck": true
    }
  },

  "validation": {
    "commands": {
      "syntax": "make check-syntax",
      "json": "make check-json",
      "strictJson": "make check-json-strict",
      "pythonTests": "make test",
      "pythonLint": "make lint-python",
      "pythonFormat": "make format-check",
      "pythonTypes": "make typecheck-python",
      "all": "make validate",
      "strict": "make validate-strict",
      "dependencies": "make check-dependencies",
      "pythonDependencies": "make check-python-dependencies",
      "pythonSecurity": "make audit-python",
      "npmSecurity": "make audit-npm",
      "releaseValidation": "make release-validate"
    },

    "policy": {
      "commandsMustExistBeforeDocumentation": true,
      "missingRequiredScriptsFailValidation": true,
      "validationMustReturnNonZeroOnFailure": true,
      "generatedFilesMustBeHandledExplicitly": true,
      "validationMustNotDeleteUserData": true,
      "networkChecksMustBeExplicit": true,
      "productionServicesMustNotBeUsedForDestructiveTests": true,
      "skippedChecksMustNotBeReportedAsPassed": true,
      "validationEvidenceMustBeRecordedForVerifiedStatus": true
    }
  },

  "testing": {
    "node": {
      "runner": "node:test",
      "status": "optional",
      "testDirectory": "tests",
      "configuration": "package.json",
      "environment": "node"
    },

    "vitest": {
      "runner": "vitest",
      "configuration": "vitest.config.js",
      "status": "optional",
      "coverageProvider": "v8",
      "coverageEnabledByDefault": false,
      "testDirectory": "tests"
    },

    "python": {
      "runner": "pytest",
      "configuration": "pytest.ini",
      "testDirectory": "python/tests",
      "pythonMinimumVersion": "3.12",
      "markers": [
        "unit",
        "integration",
        "e2e",
        "security",
        "regression",
        "slow",
        "external",
        "database",
        "smoke",
        "asyncio",
        "serial",
        "destructive",
        "api",
        "contract",
        "performance",
        "migration",
        "concurrency",
        "validation",
        "auth",
        "authorization"
      ]
    },

    "policy": {
      "isolatedTestDatabase": true,
      "syntheticTestData": true,
      "externalSideEffectsDisabledByDefault": true,
      "destructiveTestsRequireExplicitSafetyChecks": true,
      "productionCredentialsForbidden": true,
      "productionDatabaseMustNeverBeUsedForDestructiveTests": true,
      "testArtifactsMustBeSeparatedFromProductionData": true
    }
  },

  "database": {
    "primaryEngine": "postgresql",
    "driverPackage": "pg",
    "configurationSource": ".env.example",
    "migrationDirectory": null,
    "migrationStrategy": "must-be-verified",
    "automaticProductionMigrations": false,
    "automaticProductionSeeding": false,
    "isolatedTestDatabaseRequired": true,
    "backupRestoreTestingRequired": true,
    "connectionPoolingMustBeReviewed": true,
    "databaseCredentialsMustComeFromEnvironment": true,
    "status": "must-be-verified"
  },

  "api": {
    "documentation": "docs/api/openapi.yaml",
    "specificationVersion": "must-be-verified",
    "routeInventory": "must-be-verified",
    "authenticationRequirements": "must-be-verified",
    "authorizationRequirements": "must-be-verified",
    "requestResponseSchemas": "must-be-verified",
    "rateLimitingRequirements": "must-be-verified",
    "errorResponseContract": "must-be-verified",
    "paginationContract": "must-be-verified",
    "status": "starter-contract"
  },

  "security": {
    "secretFilesMustNotBeCommitted": true,
    "environmentTemplatesMustContainNoRealCredentials": true,
    "dependencyAuditRequired": true,
    "authenticationMustBeVerified": true,
    "authorizationMustBeVerified": true,
    "privateDocumentAccessMustBeVerified": true,
    "productionDatabaseIsolationRequired": true,
    "httpsRequiredInProduction": true,
    "paymentSecurityRequiredWhenPaymentsAreImplemented": true,
    "csrfProtectionRequiredWhereApplicable": true,
    "secureCookieConfigurationRequiredInProduction": true,
    "inputValidationRequired": true,
    "securityHeadersMustBeReviewed": true,
    "incidentResponseDocumentation": "infrastructure/incident-response/README.md",
    "status": "not-certified"
  },

  "deployment": {
    "provider": "must-be-verified",
    "productionCommand": "npm start",
    "runtimeVersionMustMatchManifest": true,
    "secretsMustBeProvidedByDeploymentEnvironment": true,
    "healthCheckMustBeConfiguredWhenSupported": true,
    "rollbackProcedureRequired": true,
    "backupAndRestoreProcedureRequired": true,
    "deploymentMustBeExplicit": true,
    "automaticDeploymentByReleaseUtilities": false,
    "status": "must-be-verified"
  },

  "releasePolicy": {
    "previewBeforeExecution": true,
    "explicitApprovalRequiredForTagCreation": true,
    "explicitApprovalRequiredForRemotePush": true,
    "explicitApprovalRequiredForDeployment": true,
    "forcePushForbiddenByDefault": true,
    "destructiveGitOperationsForbiddenByDefault": true,
    "releaseArtifactMustBeReviewed": true,
    "releaseNotesRequired": true,
    "migrationInstructionsRequiredWhenApplicable": true,
    "rollbackPlanRequiredForProduction": true
  },

  "publicDocuments": {
    "directory": "assets/documents",
    "manifestFiles": [
      "assets/documents/admission-guide.manifest.json",
      "assets/documents/fee-guide.manifest.json"
    ],
    "publicationRequiresContentReview": true,
    "publicationRequiresSourceVerification": true,
    "publicationRequiresPathVerification": true,
    "privateApplicantDocumentsMustNotBePublic": true,
    "personalInformationMustBeReviewedBeforePublication": true,
    "status": "draft-metadata"
  },

  "limitations": {
    "productionApplicationVerified": false,
    "allDocumentedRoutesVerified": false,
    "securityCertificationProvided": false,
    "regulatoryComplianceCertified": false,
    "productionDeploymentVerified": false,
    "backupRestorationVerified": false,
    "admissionsDataAccuracyGuaranteed": false,
    "thirdPartyLicenseAuditCompleted": false,
    "apiContractFullyVerified": false
  }
}
