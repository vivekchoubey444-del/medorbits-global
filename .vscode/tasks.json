{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MedOrbits: Inspect repository",
      "type": "process",
      "command": "python",
      "args": [
        "tools/repository_manager.py",
        "inspect"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Validate repository",
      "type": "process",
      "command": "python",
      "args": [
        "tools/repository_manager.py",
        "validate",
        "--json-report",
        "reports/repository-report.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Discover HTML pages",
      "type": "process",
      "command": "python",
      "args": [
        "tools/repository_manager.py",
        "pages",
        "--discover"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Preview page generation",
      "type": "process",
      "command": "python",
      "args": [
        "tools/repository_manager.py",
        "pages"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Generate missing pages",
      "type": "process",
      "command": "python",
      "args": [
        "tools/repository_manager.py",
        "pages",
        "--apply"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Audit pages",
      "type": "process",
      "command": "python",
      "args": [
        "tools/repository_manager.py",
        "audit-pages"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Preview asset organization",
      "type": "process",
      "command": "python",
      "args": [
        "tools/repository_manager.py",
        "organize"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Python compile check",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "compileall",
        "-q",
        "tools",
        "python"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Run pytest",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Run Ruff",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "ruff",
        "check",
        "tools",
        "python"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Format Python",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "ruff",
        "format",
        "--check",
        "tools",
        "python"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Validate JSON files",
      "type": "process",
      "command": "python",
      "args": [
        "-c",
        "import json,pathlib,sys; files=[p for p in pathlib.Path('.').rglob('*.json') if not any(x in {'.git','node_modules','.venv','venv','dist','build'} for x in p.parts)]; errors=[]; [(errors.append(f'{p}: {e}') if (lambda p: (json.loads(p.read_text(encoding='utf-8-sig')) is None))(p) is False else None) for p in []]; exec('for p in files:\\n try:\\n  json.loads(p.read_text(encoding=\"utf-8-sig\"))\\n except (OSError,UnicodeError,json.JSONDecodeError) as e:\\n  errors.append(f\"{p}: {e}\")'); [print(e,file=sys.stderr) for e in errors]; print(f'Checked {len(files)} JSON file(s).'); sys.exit(bool(errors))"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "MedOrbits: Full local checks",
      "dependsOrder": "sequence",
      "dependsOn": [
        "MedOrbits: Python compile check",
        "MedOrbits: Validate JSON files",
        "MedOrbits: Run Ruff",
        "MedOrbits: Format Python",
        "MedOrbits: Run pytest",
        "MedOrbits: Validate repository"
      ],
      "problemMatcher": []
    }
  ]
}