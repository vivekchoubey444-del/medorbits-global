{
  "MedOrbits Python module": {
    "prefix": "mo-module",
    "body": [
      "\"\"\"${1:Module description}.\"\"\"",
      "",
      "from __future__ import annotations",
      "",
      "",
      "def ${2:function_name}() -> None:",
      "    \"\"\"${3:Describe the operation}.\"\"\"",
      "    ${0:pass}",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    ${4:main()}"
    ],
    "description": "Python module starter"
  },
  "MedOrbits pytest test": {
    "prefix": "mo-test",
    "body": [
      "def test_${1:behavior}() -> None:",
      "    \"\"\"Verify ${2:expected behavior}.\"\"\"",
      "    ${0:assert True}"
    ],
    "description": "Pytest test starter"
  },
  "MedOrbits report issue": {
    "prefix": "mo-issue",
    "body": [
      "report.add(",
      "    \"${1:WARN}\",",
      "    \"${2:ISSUE_CODE}\",",
      "    ${3:path},",
      "    \"${4:Explain the issue}\",",
      ")"
    ],
    "description": "Repository manager issue reporting"
  }
}