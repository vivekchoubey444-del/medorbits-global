{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MedOrbits: Debug repository manager",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/repository_manager.py",
      "args": [
        "validate"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "MedOrbits: Debug page discovery",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/repository_manager.py",
      "args": [
        "pages",
        "--discover"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "MedOrbits: Debug page audit",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/repository_manager.py",
      "args": [
        "audit-pages"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "MedOrbits: Run current Python file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}