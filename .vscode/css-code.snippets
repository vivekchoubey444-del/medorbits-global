{
  "MedOrbits premium section": {
    "prefix": "mo-section",
    "body": [
      ".${1:content-section} {",
      "  position: relative;",
      "  isolation: isolate;",
      "  overflow: hidden;",
      "  background: linear-gradient(135deg, #101f38 0%, #192d4a 52%, #302844 100%);",
      "  border: 1px solid var(--border-color, rgba(201, 166, 107, 0.32));",
      "  border-radius: 24px;",
      "  padding: clamp(20px, 4vw, 40px);",
      "  color: var(--text-color, #f2eee6);",
      "  box-shadow: 0 18px 48px rgba(3, 12, 27, 0.22);",
      "  transition: border-color 250ms ease, box-shadow 250ms ease, transform 250ms ease;",
      "}",
      "",
      ".${1:content-section}::before {",
      "  content: \"\";",
      "  position: absolute;",
      "  inset: 0;",
      "  z-index: -1;",
      "  pointer-events: none;",
      "  background: radial-gradient(circle at 85% 15%, rgba(201, 166, 107, 0.16), transparent 38%);",
      "}",
      "",
      ".${1:content-section}:hover {",
      "  border-color: var(--accent-color, #c9a66b);",
      "  box-shadow: 0 24px 56px rgba(3, 12, 27, 0.3);",
      "}",
      "",
      ".${1:content-section}:focus-within {",
      "  outline: 2px solid var(--accent-color, #c9a66b);",
      "  outline-offset: 4px;",
      "}",
      "",
      "@media (prefers-reduced-motion: no-preference) {",
      "  .${1:content-section} {",
      "    animation: mo-section-enter 600ms ease both;",
      "  }",
      "",
      "  @keyframes mo-section-enter {",
      "    from { opacity: 0; transform: translateY(12px); }",
      "    to { opacity: 1; transform: translateY(0); }",
      "  }",
      "}",
      "$0"
    ],
    "description": "Premium MedOrbits sapphire section with champagne accents, subtle motion, hover and focus states"
  },
  "MedOrbits responsive grid": {
    "prefix": "mo-grid",
    "body": [
      ".${1:content-grid} {",
      "  display: grid;",
      "  grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));",
      "  gap: ${2:20px};",
      "  align-items: stretch;",
      "}",
      "",
      ".${1:content-grid} > * {",
      "  min-width: 0;",
      "}",
      "",
      "@media (max-width: 600px) {",
      "  .${1:content-grid} {",
      "    gap: ${3:14px};",
      "  }",
      "}",
      "$0"
    ],
    "description": "Responsive MedOrbits grid with flexible columns and mobile spacing"
  },
  "MedOrbits animated hero": {
    "prefix": "mo-hero",
    "body": [
      ".${1:premium-hero} {",
      "  position: relative;",
      "  isolation: isolate;",
      "  overflow: hidden;",
      "  display: grid;",
      "  align-items: center;",
      "  min-height: clamp(320px, 52vw, 620px);",
      "  padding: clamp(28px, 6vw, 76px);",
      "  border: 1px solid rgba(201, 166, 107, 0.28);",
      "  border-radius: clamp(20px, 3vw, 32px);",
      "  color: #f5f0e7;",
      "  background: linear-gradient(120deg, #071426, #12365b 55%, #29243f);",
      "}",
      "",
      ".${1:premium-hero}::before {",
      "  content: \"\";",
      "  position: absolute;",
      "  inset: -50%;",
      "  z-index: -1;",
      "  pointer-events: none;",
      "  background: radial-gradient(ellipse at center, rgba(81, 157, 225, 0.22), transparent 58%);",
      "  transform: translate3d(-8%, 0, 0);",
      "}",
      "",
      ".${1:premium-hero} > * {",
      "  position: relative;",
      "  z-index: 1;",
      "}",
      "",
      "@media (prefers-reduced-motion: no-preference) {",
      "  .${1:premium-hero}::before {",
      "    animation: mo-hero-glow 12s ease-in-out infinite alternate;",
      "  }",
      "",
      "  @keyframes mo-hero-glow {",
      "    from { transform: translate3d(-8%, -3%, 0) scale(1); }",
      "    to { transform: translate3d(8%, 3%, 0) scale(1.12); }",
      "  }",
      "}",
      "$0"
    ],
    "description": "Responsive sapphire-blue hero with animated ambient glow and reduced-motion support"
  },
  "MedOrbits premium card": {
    "prefix": "mo-card",
    "body": [
      ".${1:premium-card} {",
      "  min-width: 0;",
      "  height: 100%;",
      "  padding: clamp(18px, 3vw, 28px);",
      "  color: #e9edf5;",
      "  background: linear-gradient(145deg, #14243a, #1c2c43);",
      "  border: 1px solid rgba(177, 198, 223, 0.18);",
      "  border-radius: 20px;",
      "  box-shadow: 0 10px 28px rgba(2, 12, 27, 0.16);",
      "  transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;",
      "}",
      "",
      ".${1:premium-card}:hover {",
      "  transform: translateY(-4px);",
      "  border-color: rgba(201, 166, 107, 0.65);",
      "  box-shadow: 0 18px 38px rgba(2, 12, 27, 0.25);",
      "}",
      "",
      "@media (prefers-reduced-motion: reduce) {",
      "  .${1:premium-card} {",
      "    transition: none;",
      "  }",
      "",
      "  .${1:premium-card}:hover {",
      "    transform: none;",
      "  }",
      "}",
      "$0"
    ],
    "description": "Premium dark card with champagne borders, responsive sizing and accessible motion handling"
  }
}