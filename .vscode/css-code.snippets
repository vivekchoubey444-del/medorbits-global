{
  "MedOrbits premium section": {
    "prefix": "mo-section",
    "body": [
      ".${1:content-section} {",
      "  background: linear-gradient(135deg, #e8eef8, #f2eaf2);",
      "  border: 1px solid var(--border-color, #d6dfeb);",
      "  border-radius: 20px;",
      "  padding: clamp(20px, 4vw, 36px);",
      "  color: var(--text-color, #182638);",
      "}",
      "",
      ".${1:content-section}:focus-within {",
      "  outline: 2px solid var(--accent-color, #c9a66b);",
      "  outline-offset: 3px;",
      "}",
      "$0"
    ],
    "description": "Premium tinted MedOrbits section"
  },
  "MedOrbits responsive grid": {
    "prefix": "mo-grid",
    "body": [
      ".${1:content-grid} {",
      "  display: grid;",
      "  grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));",
      "  gap: ${2:20px};",
      "}",
      "$0"
    ],
    "description": "Responsive content grid"
  }
}