{
  "MedOrbits GitHub Actions workflow": {
    "prefix": "mo-workflow",
    "body": [
      "name: ${1:MedOrbits Quality Checks}",
      "",
      "on:",
      "  push:",
      "    branches: [main]",
      "  pull_request:",
      "    branches: [main]",
      "  workflow_dispatch:",
      "",
      "permissions:",
      "  contents: read",
      "",
      "concurrency:",
      "  group: ${2:medorbits-ci}-${'$'}{{ github.workflow }}-${'$'}{{ github.ref }}",
      "  cancel-in-progress: true",
      "",
      "jobs:",
      "  validate:",
      "    name: Repository Validation",
      "    runs-on: ubuntu-latest",
      "    timeout-minutes: 15",
      "",
      "    steps:",
      "      - name: Checkout repository",
      "        uses: actions/checkout@v4",
      "",
      "      - name: Set up Python",
      "        uses: actions/setup-python@v5",
      "        with:",
      "          python-version: \"3.12\"",
      "          cache: pip",
      "",
      "      - name: Set up Node.js",
      "        uses: actions/setup-node@v4",
      "        with:",
      "          node-version: \"20\"",
      "          cache: npm",
      "          cache-dependency-path: package-lock.json",
      "",
      "      - name: Install Python validation tools",
      "        run: |",
      "          python -m pip install --upgrade pip",
      "          if [ -f requirements.txt ]; then",
      "            python -m pip install -r requirements.txt",
      "          fi",
      "",
      "      - name: Install Node dependencies",
      "        run: |",
      "          if [ -f package-lock.json ]; then",
      "            npm ci",
      "          elif [ -f package.json ]; then",
      "            npm install --ignore-scripts",
      "          else",
      "            echo \"No package.json found; skipping Node dependency installation.\"",
      "          fi",
      "",
      "      - name: Validate repository",
      "        run: |",
      "          if [ -f tools/repository_manager.py ]; then",
      "            python tools/repository_manager.py validate",
      "          else",
      "            echo \"Repository manager not found.\"",
      "            exit 1",
      "          fi",
      "",
      "      - name: Validate Python syntax",
      "        run: |",
      "          python - <<'PY'",
      "          import ast",
      "          import pathlib",
      "          import sys",
      "",
      "          roots = [pathlib.Path(p) for p in ('src', 'scripts', 'tests', 'tools', 'python')]",
      "          files = sorted({f for root in roots if root.exists() for f in root.rglob('*.py')})",
      "          errors = []",
      "          for path in files:",
      "              try:",
      "                  ast.parse(path.read_text(encoding='utf-8-sig'), filename=str(path))",
      "              except (SyntaxError, UnicodeError, OSError) as exc:",
      "                  errors.append(f'{path}: {exc}')",
      "          for error in errors:",
      "              print(error, file=sys.stderr)",
      "          print(f'Checked {len(files)} Python file(s).')",
      "          sys.exit(bool(errors))",
      "          PY",
      "",
      "      - name: Run Ruff",
      "        run: |",
      "          if python -m ruff --version >/dev/null 2>&1; then",
      "            python -m ruff check .",
      "          else",
      "            echo \"Ruff is not installed; skipping lint step.\"",
      "          fi",
      "",
      "      - name: Validate JSON files",
      "        run: |",
      "          python - <<'PY'",
      "          import json",
      "          import pathlib",
      "          import sys",
      "",
      "          excluded = {'.git', 'node_modules', '.venv', 'venv', 'dist', 'build'}",
      "          errors = []",
      "          count = 0",
      "          for path in pathlib.Path('.').rglob('*.json'):",
      "              if any(part in excluded for part in path.parts):",
      "                  continue",
      "              count += 1",
      "              try:",
      "                  with path.open(encoding='utf-8-sig') as stream:",
      "                      json.load(stream)",
      "              except (json.JSONDecodeError, UnicodeError, OSError) as exc:",
      "                  errors.append(f'{path}: {exc}')",
      "          for error in errors:",
      "              print(error, file=sys.stderr)",
      "          print(f'Checked {count} JSON file(s).')",
      "          sys.exit(bool(errors))",
      "          PY",
      "",
      "      - name: Run project tests",
      "        run: |",
      "          if [ -f package.json ]; then",
      "            npm test --if-present",
      "          fi",
      "          if [ -d tests ] || [ -d test ]; then",
      "            python -m pytest",
      "          else",
      "            echo \"No Python test directory found; skipping pytest.\"",
      "          fi",
      "$0"
    ],
    "description": "MedOrbits CI workflow starter with repository, Python, JSON, Ruff, Node.js, and test checks"
  }
}