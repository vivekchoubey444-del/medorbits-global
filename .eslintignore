
# ============================================================
# MedOrbits -- ESLint Ignore Rules
# File: .eslintignore
# Release target: 2.0.0
#
# Purpose:
# Exclude generated files, dependencies, build outputs, local
# data, and non-source artifacts from legacy ESLint file scans.
#
# IMPORTANT:
# Modern ESLint flat configuration (ESLint 9+) uses ignores
# in eslint.config.js or eslint.config.mjs. This file is
# primarily for legacy ESLint configurations.
# ============================================================


# ------------------------------------------------------------
# 01. DEPENDENCIES AND PACKAGE MANAGERS
# ------------------------------------------------------------

node_modules/
**/node_modules/

.npm/
.pnpm-store/
.yarn/
vendor/


# ------------------------------------------------------------
# 02. VERSION CONTROL AND EDITOR METADATA
# ------------------------------------------------------------

.git/
.github/
.vscode/
.idea/
.DS_Store
Thumbs.db


# ------------------------------------------------------------
# 03. BUILD OUTPUTS AND GENERATED DIRECTORIES
# ------------------------------------------------------------

dist/
build/
out/
release/
coverage/
.nyc_output/
.next/
.nuxt/
.svelte-kit/
.angular/
.turbo/
.cache/
.parcel-cache/
.webpack/
vite-cache/


# ------------------------------------------------------------
# 04. LOGS AND TEMPORARY FILES
# ------------------------------------------------------------

logs/
log/
tmp/
temp/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*


# ------------------------------------------------------------
# 05. ENVIRONMENT AND PRIVATE CONFIGURATION
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.test.example

# Private credentials and local overrides.
secrets/
private/
.local/
*.pem
*.key
*.p12
*.pfx


# ------------------------------------------------------------
# 06. GENERATED API AND DOCUMENTATION ARTIFACTS
# ------------------------------------------------------------

# Ignore generated files only when these directories are
# exclusively generated output in this repository.
generated/
swagger-output/
openapi-generated/


# ------------------------------------------------------------
# 07. TEST OUTPUTS AND REPORTS
# ------------------------------------------------------------

test-results/
playwright-report/
blob-report/
junit/
reports/


# ------------------------------------------------------------
# 08. PYTHON GENERATED ARTIFACTS
# ------------------------------------------------------------

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/


# ------------------------------------------------------------
# 09. DATABASE, UPLOAD, AND LOCAL DATA
# ------------------------------------------------------------

# Exclude local runtime data from linting; keep source schemas,
# migrations, fixtures, and tracked test files lintable.
storage/uploads/
storage/tmp/
data/local/
*.sqlite
*.sqlite3
*.db


# ------------------------------------------------------------
# 10. ARCHIVES AND BINARY ASSETS
# ------------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.exe
*.dll
*.so
*.dylib


# ------------------------------------------------------------
# 11. GENERATED FRONTEND ASSETS
# ------------------------------------------------------------

# Do not ignore source assets such as assets/js or assets/css.
# Add specific generated bundle paths here only when verified.
# Example:
# public/assets/generated/


# ------------------------------------------------------------
# 12. PROJECT-SPECIFIC EXCLUSIONS
# ------------------------------------------------------------

# Add only verified generated or non-source paths below.
# Do not exclude api/, controllers/, middleware/, routes/,
# services/, models/, schemas/, scripts/, or tools/ wholesale.


# ============================================================
# END OF ESLint ignore rules
# ============================================================
