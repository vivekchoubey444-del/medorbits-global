# ============================================================
# MedOrbits -- ESLint Ignore Rules
# File: .eslintignore
# Release target: 2.1.0
#
# Purpose:
# Exclude dependencies, generated output, local runtime data,
# and non-source artifacts from legacy ESLint file scans.
#
# Compatibility:
#   - Legacy ESLint configurations: .eslintignore
#   - ESLint 9+ flat configuration: ignores in eslint.config.js
#
# IMPORTANT:
# .eslintignore is not supported by ESLint 9+ flat configuration.
# Migrate these rules to eslint.config.js when using flat config.
# ============================================================


# ------------------------------------------------------------
# 01. DEPENDENCIES AND PACKAGE MANAGERS
# ------------------------------------------------------------

node_modules/
**/node_modules/

.npm/
.pnpm-store/
.yarn/
vendor/


# ------------------------------------------------------------
# 02. VERSION CONTROL AND EDITOR METADATA
# ------------------------------------------------------------

.git/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Keep .github/ lintable if it contains JavaScript or TypeScript
# tooling. Workflow YAML files are not ESLint source files.


# ------------------------------------------------------------
# 03. BUILD OUTPUTS AND GENERATED DIRECTORIES
# ------------------------------------------------------------

dist/
build/
out/
release/
coverage/
.nyc_output/
.next/
.nuxt/
.svelte-kit/
.angular/
.turbo/
.cache/
.parcel-cache/
.webpack/
vite-cache/


# ------------------------------------------------------------
# 04. LOGS AND TEMPORARY FILES
# ------------------------------------------------------------

logs/
log/
tmp/
temp/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*


# ------------------------------------------------------------
# 05. ENVIRONMENT AND PRIVATE CONFIGURATION
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.test.example

secrets/
private/
.local/

# Exclude private key material from lint scans.
*.pem
*.key
*.p12
*.pfx


# ------------------------------------------------------------
# 06. VERIFIED GENERATED API AND DOCUMENTATION OUTPUT
# ------------------------------------------------------------

# Enable these rules only when the paths are generated output.
# Do not exclude source schemas or maintained documentation.
# generated/
# swagger-output/
# openapi-generated/


# ------------------------------------------------------------
# 07. TEST OUTPUTS AND REPORTS
# ------------------------------------------------------------

test-results/
playwright-report/
blob-report/
junit/
reports/


# ------------------------------------------------------------
# 08. PYTHON GENERATED ARTIFACTS
# ------------------------------------------------------------

__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/


# ------------------------------------------------------------
# 09. DATABASE, UPLOAD, AND LOCAL DATA
# ------------------------------------------------------------

storage/uploads/
storage/tmp/
data/local/

*.sqlite
*.sqlite3
*.db


# ------------------------------------------------------------
# 10. ARCHIVES AND BINARY ASSETS
# ------------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.exe
*.dll
*.so
*.dylib


# ------------------------------------------------------------
# 11. GENERATED FRONTEND ASSETS
# ------------------------------------------------------------

# Keep maintained source assets such as assets/js and assets/css.
# Add verified generated bundle paths only when necessary.
# public/assets/generated/


# ------------------------------------------------------------
# 12. PROJECT-SPECIFIC EXCLUSIONS
# ------------------------------------------------------------

# Do not exclude application source directories wholesale.
# Keep api/, controllers/, middleware/, routes/, services/,
# models/, schemas/, scripts/, and tools/ lintable.


# ============================================================
# END OF ESLint ignore rules
# ============================================================