
# ==============================================================================
# MedOrbits -- Local Environment Configuration
# File: /.env
#
# IMPORTANT:
# - Never commit real secrets to version control.
# - Add /.env to .gitignore.
# - Keep production secrets in Render Environment Variables.
# - Do not use placeholder secrets in a deployed environment.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Application
# ------------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=MedOrbits
APP_VERSION=1.0.0

HOST=0.0.0.0
PORT=3000
APP_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# 2. Frontend and API
# ------------------------------------------------------------------------------

API_BASE_URL=http://localhost:3000/api
API_V1_BASE_URL=http://localhost:3000/api/v1

# Origins permitted to access the API.
# Configure ALLOWED_ORIGINS for the supplied server.js.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional application-specific CORS setting.
# Use only if the application explicitly reads this variable.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ------------------------------------------------------------------------------
# 3. Security
# ------------------------------------------------------------------------------

# Generate unique, cryptographically secure secrets for local development.
# Replace these placeholders before enabling authentication or encryption.

SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_ENCRYPTION_KEY

# Local HTTP development only.
# Set to true in production when HTTPS and secure cookies are configured.
COOKIE_SECURE=false

# Do not enable proxy trust unless the value matches your deployment topology.
TRUST_PROXY_HOPS=0


# ------------------------------------------------------------------------------
# 4. Database -- PostgreSQL
# ------------------------------------------------------------------------------

# Leave empty if the application constructs its connection from PG* variables.
# The supplied server.js requires DATABASE_URL in production.
DATABASE_URL=

PGHOST=localhost
PGPORT=5432
PGDATABASE=medorbits
PGUSER=REPLACE_WITH_LOCAL_DB_USER
PGPASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD

# Local PostgreSQL without TLS.
# Use the provider's required TLS configuration in production.
PGSSLMODE=disable

# Settings read directly by the supplied server.js.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
READINESS_TIMEOUT_MS=3000


# ------------------------------------------------------------------------------
# 5. Optional MySQL Configuration
# ------------------------------------------------------------------------------
# Configure these only if a separate part of the application uses MySQL.
# The supplied server.js uses PostgreSQL via the pg package.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=medorbits
DB_USER=REPLACE_WITH_LOCAL_MYSQL_USER
DB_PASSWORD=REPLACE_WITH_LOCAL_MYSQL_PASSWORD


# ------------------------------------------------------------------------------
# 6. Request Limits and Server Lifecycle
# ------------------------------------------------------------------------------

BODY_LIMIT=1mb

API_RATE_LIMIT=300
API_RATE_WINDOW_MS=900000

SHUTDOWN_TIMEOUT_MS=15000


# ------------------------------------------------------------------------------
# 7. Static Assets
# ------------------------------------------------------------------------------

# Optional. Set only to a directory containing public files.
# Never point this to private uploads, documents, configuration, or the repo root.
# STATIC_DIRECTORY=public


# ------------------------------------------------------------------------------
# 8. Logging
# ------------------------------------------------------------------------------

LOG_LEVEL=debug
ENABLE_REQUEST_LOGS=true


# ------------------------------------------------------------------------------
# 9. AI Integration -- Optional
# ------------------------------------------------------------------------------

AI_API_URL=
AI_API_KEY=
AI_MODEL=


# ------------------------------------------------------------------------------
# 10. Email / SMTP -- Optional
# ------------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=


# ------------------------------------------------------------------------------
# 11. Payments -- Optional
# ------------------------------------------------------------------------------

PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=


# ==============================================================================
# End of local environment configuration
# ==============================================================================
