
# ==============================================================================
# MedOrbits -- Local Environment Configuration Template
# File: /.env.example
# Release: 3.0.1
# Runtime: Node.js >= 20
# Deployment: Render
# Primary database: PostgreSQL
# ==============================================================================

# ------------------------------------------------------------------------------
# 01. APPLICATION RUNTIME
# ------------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=MedOrbits
APP_VERSION=3.0.1
APP_ENVIRONMENT=local

HOST=127.0.0.1
PORT=3000

APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api
API_V1_BASE_URL=http://localhost:3000/api/v1

DEPLOYMENT_REGION=
INSTANCE_ID=local
RELEASE_SHA=
BUILD_TIMESTAMP=

ENABLE_GRACEFUL_SHUTDOWN=true
SHUTDOWN_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 02. FRONTEND, API, AND CORS
# ------------------------------------------------------------------------------

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# server.js currently uses CORS_ORIGINS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE_SECONDS=600

CORS_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Request-ID,X-Correlation-ID,X-CSRF-Token

TRUST_PROXY=0
TRUST_PROXY_HOPS=0

# ------------------------------------------------------------------------------
# 03. SECURITY AND AUTHENTICATION
# ------------------------------------------------------------------------------

SESSION_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=medorbits-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ALGORITHM=HS256

JWT_REFRESH_ROTATION=true
JWT_REVOKE_ON_LOGOUT=true
JWT_CLOCK_TOLERANCE_SECONDS=30

COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/
COOKIE_DOMAIN=

CSRF_PROTECTION_ENABLED=true
CSRF_HEADER_NAME=X-CSRF-Token

PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_BCRYPT_ROUNDS=12

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=900000

# ------------------------------------------------------------------------------
# 04. PRIMARY DATABASE -- POSTGRESQL
# ------------------------------------------------------------------------------

ENABLE_DATABASE=false
DATABASE_URL=

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=medorbits
PGUSER=
PGPASSWORD=

PGSSLMODE=disable
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
READINESS_TIMEOUT_MS=3000

DB_AUTO_MIGRATE=false
DB_SEED_ON_START=false

# Optional certificate paths:
# PGSSLROOTCERT=
# PGSSLCERT=
# PGSSLKEY=

# ------------------------------------------------------------------------------
# 05. OPTIONAL MYSQL
# ------------------------------------------------------------------------------

DB_CLIENT=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medorbits
DB_USER=
DB_PASSWORD=

DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000
DB_MULTIPLE_STATEMENTS=false

DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 06. REQUEST LIMITS AND SERVER LIFECYCLE
# ------------------------------------------------------------------------------

BODY_LIMIT=1mb

# Variables consumed by the current server.js:
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Additional application-level rate-limit configuration.
API_RATE_LIMIT=300
API_RATE_WINDOW_MS=900000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=memory
RATE_LIMIT_KEY_STRATEGY=ip

# ------------------------------------------------------------------------------
# 07. STATIC ASSETS
# ------------------------------------------------------------------------------

STATIC_DIRECTORY=public

# ------------------------------------------------------------------------------
# 08. LOGGING AND REQUEST OBSERVABILITY
# ------------------------------------------------------------------------------

LOG_LEVEL=debug
LOG_FORMAT=json
LOG_REDACT_SENSITIVE=true
LOG_INCLUDE_STACKS=false

ENABLE_REQUEST_LOGS=true
LOG_REQUEST_BODIES=false
LOG_RESPONSE_BODIES=false
LOG_SQL=false
LOG_SQL_PARAMETERS=false

REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID
GENERATE_REQUEST_ID=true

# ------------------------------------------------------------------------------
# 09. MONITORING MODULE
# ------------------------------------------------------------------------------

# Set false to disable the optional monitoring integration.
MONITORING_ENABLED=true

MONITORING_SERVICE_NAME=medorbits-api
MONITORING_METRICS_ENABLED=true

# Generate a long random secret before enabling protected metrics in production.
MONITORING_METRICS_TOKEN=

MONITORING_SLOW_REQUEST_MS=2000
MONITORING_HEALTH_TIMEOUT_MS=3000
MONITORING_ALERT_COOLDOWN_MS=300000
MONITORING_RETENTION_DAYS=14

# Optional alert destination. Only use a trusted, HTTPS webhook endpoint.
MONITORING_ALERT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 10. HEALTH CHECKS AND METRICS
# ------------------------------------------------------------------------------

HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/health/ready
LIVENESS_CHECK_PATH=/health/live

HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_REDIS=false

METRICS_ENABLED=false
METRICS_PATH=/internal/metrics
METRICS_REQUIRE_AUTH=true

ERROR_TRACKING_ENABLED=false
TRACING_ENABLED=false

# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=medorbits-api

# ------------------------------------------------------------------------------
# 11. OPTIONAL AI INTEGRATION
# ------------------------------------------------------------------------------

AI_ENABLED=false
AI_PROVIDER=
AI_API_URL=
AI_API_KEY=
AI_MODEL=

AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=0
AI_MAX_OUTPUT_TOKENS=2000
AI_TEMPERATURE=0.2

AI_REQUIRE_USER_CONSENT=true
AI_SEND_PERSONAL_DOCUMENTS=false
AI_REDACT_PERSONAL_DATA=true
AI_LOG_PROMPTS=false
AI_LOG_RESPONSES=false

# ------------------------------------------------------------------------------
# 12. OPTIONAL EMAIL / SMTP
# ------------------------------------------------------------------------------

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

EMAIL_FROM=MedOrbits
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

EMAIL_SEND_TIMEOUT_MS=10000
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_MAX_RETRIES=0

# ------------------------------------------------------------------------------
# 13. OPTIONAL PAYMENTS
# ------------------------------------------------------------------------------

PAYMENT_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=INR

PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

PAYMENT_IDEMPOTENCY_ENABLED=true
PAYMENT_REQUIRE_WEBHOOK_SIGNATURE=true
PAYMENT_LOG_SENSITIVE_DATA=false

# ------------------------------------------------------------------------------
# 14. OPTIONAL REDIS / CACHING
# ------------------------------------------------------------------------------

CACHE_ENABLED=false
CACHE_PROVIDER=memory
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

REDIS_ENABLED=false
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_KEY_PREFIX=medorbits:local:

# ------------------------------------------------------------------------------
# 15. OPTIONAL FILE STORAGE
# ------------------------------------------------------------------------------

UPLOADS_ENABLED=true
UPLOAD_DIRECTORY=storage/uploads
UPLOAD_TEMP_DIRECTORY=storage/tmp

UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_MAX_FILES=5
UPLOAD_MAX_TOTAL_SIZE_BYTES=52428800

UPLOAD_FILENAME_STRATEGY=random
UPLOAD_OVERWRITE_EXISTING=false
UPLOAD_PRESERVE_ORIGINAL_FILENAME=false
UPLOAD_VALIDATE_SIGNATURE=true
UPLOAD_REJECT_EXECUTABLES=true

DOCUMENTS_PRIVATE=true
DOCUMENT_DOWNLOAD_AUTH_REQUIRED=true

OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_PROVIDER=s3

# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_REGION=ap-south-1
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 16. BACKGROUND WORKERS
# ------------------------------------------------------------------------------

WORKERS_ENABLED=false
SCHEDULER_ENABLED=false

JOB_QUEUE_PROVIDER=database
JOB_QUEUE_MAX_ATTEMPTS=3
JOB_QUEUE_RETRY_DELAY_MS=5000
JOB_QUEUE_CONCURRENCY=2
JOB_QUEUE_POLL_INTERVAL_MS=5000

# ------------------------------------------------------------------------------
# 17. APPLICATION FEATURE FLAGS
# ------------------------------------------------------------------------------

FEATURE_COURSES=true
FEATURE_COLLEGES=true
FEATURE_UNIVERSITIES=true
FEATURE_SCHOLARSHIPS=true
FEATURE_ADMISSIONS=true
FEATURE_CAREERS=true
FEATURE_RECRUITMENT=true
FEATURE_HOSTELS=true
FEATURE_NEWS=true
FEATURE_TESTIMONIALS=true
FEATURE_CONTACT_FORMS=true

FEATURE_SOCIAL_LOGIN=false
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_PUBLIC_PROFILES=false
FEATURE_NEWSLETTER=false

# ------------------------------------------------------------------------------
# 18. DEVELOPMENT AND TESTING
# ------------------------------------------------------------------------------

DEBUG=false
ENABLE_STACK_TRACES=false
ENABLE_TEST_ROUTES=false
ENABLE_DEMO_DATA=false
TEST_MODE=false

# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/medorbits_test

TEST_TIMEOUT_MS=10000
TEST_HOOK_TIMEOUT_MS=10000
TEST_CLEANUP_ENABLED=true
TEST_USE_SYNTHETIC_DATA=true

# ------------------------------------------------------------------------------
# 19. DEPLOYMENT METADATA
# ------------------------------------------------------------------------------

# APP_ENVIRONMENT=production
# DEPLOYMENT_REGION=
# INSTANCE_ID=
# RELEASE_SHA=
# BUILD_TIMESTAMP=

# ------------------------------------------------------------------------------
# 20. RENDER PRODUCTION CHECKLIST
# ------------------------------------------------------------------------------

# Configure actual production values in Render Environment Variables.
#
# NODE_ENV=production
# APP_URL=https://www.medorbits.in
# FRONTEND_URL=https://www.medorbits.in
# CORS_ORIGINS=https://medorbits.in,https://www.medorbits.in
# ENABLE_DATABASE=true
# DATABASE_URL=<Render PostgreSQL connection string>
# DATABASE_SSL=true
# COOKIE_SECURE=true
# TRUST_PROXY=1
# MONITORING_ENABLED=true
# MONITORING_METRICS_ENABLED=true
# MONITORING_METRICS_TOKEN=<long random secret>
#
# Production requirements:
# 1. Never commit .env or real credentials.
# 2. Use separate development, test, and production databases.
# 3. Generate unique secrets for each environment.
# 4. Confirm database TLS requirements with the database provider.
# 5. Restrict CORS to exact trusted frontend origins.
# 6. Configure proxy trust for the actual hosting topology.
# 7. Disable test routes, demo data, and debug output.
# 8. Protect metrics endpoints and restrict network access where possible.
# 9. Configure backups, monitoring, and recovery procedures.
# 10. Validate every setting against the actual application code.
#
# This file documents configuration; it does not implement features.
# Only settings consumed by application code take effect.
# ==============================================================================
