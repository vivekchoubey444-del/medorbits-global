# ==============================================================================
# MedOrbits -- Local Environment Configuration Template
# File: /.env.example
# Release: 3.0.0
#
# Runtime: Node.js (use a currently supported LTS release)
# Deployment: Render
# Primary database: PostgreSQL
#
# Purpose:
#   Document local development settings, database connectivity, security,
#   logging, and optional service integrations.
#
# Setup:
#   cp .env.example .env
#   Configure the required local values.
#
# SECURITY:
#   - Never commit .env, real credentials, or production secrets.
#   - Configure production values in Render Environment Variables.
#   - Never point development or test environments at production databases.
#   - Only variables consumed by application code take effect.
#   - Keep optional integrations disabled until their implementations exist.
# ==============================================================================


# ------------------------------------------------------------------------------
# 01. APPLICATION RUNTIME
# ------------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=MedOrbits
APP_VERSION=3.0.0
APP_ENVIRONMENT=local

HOST=127.0.0.1
PORT=3000

APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api
API_V1_BASE_URL=http://localhost:3000/api/v1

DEPLOYMENT_REGION=
INSTANCE_ID=local
RELEASE_SHA=
BUILD_TIMESTAMP=

ENABLE_GRACEFUL_SHUTDOWN=true
SHUTDOWN_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000


# ------------------------------------------------------------------------------
# 02. FRONTEND, API, AND CORS
# ------------------------------------------------------------------------------

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=600

CORS_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Request-ID,X-Correlation-ID,X-CSRF-Token

# Trust only the proxy hops required by your actual network topology.
TRUST_PROXY_HOPS=0


# ------------------------------------------------------------------------------
# 03. SECURITY AND AUTHENTICATION
# ------------------------------------------------------------------------------

# Generate separate, cryptographically random secrets when required.
# Leave blank until configured; the application should fail securely if a
# required secret is missing.
SESSION_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=medorbits-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ALGORITHM=HS256

JWT_REFRESH_ROTATION=true
JWT_REVOKE_ON_LOGOUT=true
JWT_CLOCK_TOLERANCE_SECONDS=30

COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/
COOKIE_DOMAIN=

CSRF_PROTECTION_ENABLED=true
CSRF_HEADER_NAME=X-CSRF-Token

PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_BCRYPT_ROUNDS=12

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=900000

# Keep local proxy trust and cookie security appropriate for local HTTP.
# Enable secure cookies when deployed behind HTTPS.


# ------------------------------------------------------------------------------
# 04. PRIMARY DATABASE -- POSTGRESQL
# ------------------------------------------------------------------------------

# Prefer DATABASE_URL if the application supports it.
# Keep the connection string empty until configured locally.
DATABASE_URL=

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=medorbits
PGUSER=
PGPASSWORD=

# Local development without TLS. Configure TLS for remote database services.
PGSSLMODE=disable
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
READINESS_TIMEOUT_MS=3000

DB_AUTO_MIGRATE=false
DB_SEED_ON_START=false

# Optional provider-specific certificate paths.
# PGSSLROOTCERT=
# PGSSLCERT=
# PGSSLKEY=


# ------------------------------------------------------------------------------
# 05. OPTIONAL MYSQL
# ------------------------------------------------------------------------------

# Configure only if an application component actually uses MySQL.
# Do not confuse these settings with PostgreSQL configuration.

DB_CLIENT=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medorbits
DB_USER=
DB_PASSWORD=

DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000
DB_MULTIPLE_STATEMENTS=false

# Optional MySQL TLS settings.
DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true


# ------------------------------------------------------------------------------
# 06. REQUEST LIMITS AND SERVER LIFECYCLE
# ------------------------------------------------------------------------------

BODY_LIMIT=1mb

API_RATE_LIMIT=300
API_RATE_WINDOW_MS=900000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=memory
RATE_LIMIT_KEY_STRATEGY=ip

# In-memory limits are per process. Use a shared store if distributed
# deployments require consistent rate limiting.


# ------------------------------------------------------------------------------
# 07. STATIC ASSETS
# ------------------------------------------------------------------------------

# Configure only if server.js explicitly supports this setting.
# STATIC_DIRECTORY=public


# ------------------------------------------------------------------------------
# 08. LOGGING AND REQUEST OBSERVABILITY
# ------------------------------------------------------------------------------

LOG_LEVEL=debug
LOG_FORMAT=json
LOG_REDACT_SENSITIVE=true
LOG_INCLUDE_STACKS=false

ENABLE_REQUEST_LOGS=true
LOG_REQUEST_BODIES=false
LOG_RESPONSE_BODIES=false
LOG_SQL=false
LOG_SQL_PARAMETERS=false

REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID
GENERATE_REQUEST_ID=true


# ------------------------------------------------------------------------------
# 09. OPTIONAL AI INTEGRATION
# ------------------------------------------------------------------------------

AI_ENABLED=false
AI_PROVIDER=
AI_API_URL=
AI_API_KEY=
AI_MODEL=

AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=0
AI_MAX_OUTPUT_TOKENS=2000
AI_TEMPERATURE=0.2

AI_REQUIRE_USER_CONSENT=true
AI_SEND_PERSONAL_DOCUMENTS=false
AI_REDACT_PERSONAL_DATA=true
AI_LOG_PROMPTS=false
AI_LOG_RESPONSES=false


# ------------------------------------------------------------------------------
# 10. OPTIONAL EMAIL / SMTP
# ------------------------------------------------------------------------------

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

EMAIL_FROM=MedOrbits
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

EMAIL_SEND_TIMEOUT_MS=10000
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_MAX_RETRIES=0


# ------------------------------------------------------------------------------
# 11. OPTIONAL PAYMENTS
# ------------------------------------------------------------------------------

PAYMENT_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=INR

PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

PAYMENT_IDEMPOTENCY_ENABLED=true
PAYMENT_REQUIRE_WEBHOOK_SIGNATURE=true
PAYMENT_LOG_SENSITIVE_DATA=false


# ------------------------------------------------------------------------------
# 12. OPTIONAL REDIS / CACHING
# ------------------------------------------------------------------------------

CACHE_ENABLED=false
CACHE_PROVIDER=memory
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

REDIS_ENABLED=false
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_KEY_PREFIX=medorbits:local:


# ------------------------------------------------------------------------------
# 13. OPTIONAL FILE STORAGE
# ------------------------------------------------------------------------------

UPLOADS_ENABLED=true
UPLOAD_DIRECTORY=storage/uploads
UPLOAD_TEMP_DIRECTORY=storage/tmp

UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_MAX_FILES=5
UPLOAD_MAX_TOTAL_SIZE_BYTES=52428800

UPLOAD_FILENAME_STRATEGY=random
UPLOAD_OVERWRITE_EXISTING=false
UPLOAD_PRESERVE_ORIGINAL_FILENAME=false
UPLOAD_VALIDATE_SIGNATURE=true
UPLOAD_REJECT_EXECUTABLES=true

DOCUMENTS_PRIVATE=true
DOCUMENT_DOWNLOAD_AUTH_REQUIRED=true

OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_PROVIDER=s3

# Configure only when the object-storage adapter is implemented.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_REGION=ap-south-1
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=


# ------------------------------------------------------------------------------
# 14. HEALTH CHECKS AND METRICS
# ------------------------------------------------------------------------------

HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live

HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_REDIS=false

METRICS_ENABLED=false
METRICS_PATH=/metrics
METRICS_REQUIRE_AUTH=true

ERROR_TRACKING_ENABLED=false
TRACING_ENABLED=false

# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=medorbits-api


# ------------------------------------------------------------------------------
# 15. BACKGROUND WORKERS
# ------------------------------------------------------------------------------

WORKERS_ENABLED=false
SCHEDULER_ENABLED=false

JOB_QUEUE_PROVIDER=database
JOB_QUEUE_MAX_ATTEMPTS=3
JOB_QUEUE_RETRY_DELAY_MS=5000
JOB_QUEUE_CONCURRENCY=2
JOB_QUEUE_POLL_INTERVAL_MS=5000


# ------------------------------------------------------------------------------
# 16. APPLICATION FEATURE FLAGS
# ------------------------------------------------------------------------------

FEATURE_COURSES=true
FEATURE_COLLEGES=true
FEATURE_UNIVERSITIES=true
FEATURE_SCHOLARSHIPS=true
FEATURE_ADMISSIONS=true
FEATURE_CAREERS=true
FEATURE_RECRUITMENT=true
FEATURE_HOSTELS=true
FEATURE_NEWS=true
FEATURE_TESTIMONIALS=true
FEATURE_CONTACT_FORMS=true

FEATURE_SOCIAL_LOGIN=false
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_PUBLIC_PROFILES=false
FEATURE_NEWSLETTER=false


# ------------------------------------------------------------------------------
# 17. DEVELOPMENT AND TESTING
# ------------------------------------------------------------------------------

DEBUG=false
ENABLE_STACK_TRACES=false
ENABLE_TEST_ROUTES=false
ENABLE_DEMO_DATA=false
TEST_MODE=false

# Use a dedicated test database. Never use production connection strings.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/medorbits_test

TEST_TIMEOUT_MS=10000
TEST_HOOK_TIMEOUT_MS=10000
TEST_CLEANUP_ENABLED=true
TEST_USE_SYNTHETIC_DATA=true


# ------------------------------------------------------------------------------
# 18. DEPLOYMENT METADATA
# ------------------------------------------------------------------------------

# Set deployment-specific values in the hosting environment.
# APP_ENVIRONMENT=production
# DEPLOYMENT_REGION=
# INSTANCE_ID=
# RELEASE_SHA=
# BUILD_TIMESTAMP=


# ------------------------------------------------------------------------------
# 19. PRODUCTION DEPLOYMENT CHECKLIST -- RENDER
# ------------------------------------------------------------------------------

# Configure these values through Render Environment Variables rather than
# committing production values into this file.
#
# NODE_ENV=production
# APP_URL=https://www.medorbits.in
# FRONTEND_URL=https://www.medorbits.in
# COOKIE_SECURE=true
#
# Before deployment:
#   1. Configure the actual production DATABASE_URL.
#   2. Generate unique SESSION_SECRET, JWT_SECRET, JWT_REFRESH_SECRET,
#      and ENCRYPTION_KEY values as required by the implemented features.
#   3. Configure database TLS according to the database provider.
#   4. Set exact production CORS origins.
#   5. Configure trusted proxy hops according to Render's topology.
#   6. Disable test routes, demo data, and debug output.
#   7. Configure backups, monitoring, and recovery procedures.
#   8. Verify health endpoints do not disclose sensitive information.
#   9. Validate environment variables against the actual configuration loader.
#  10. Keep external integrations disabled until their adapters are tested.
#
# IMPORTANT:
# This file documents settings; it does not implement application features.
# Only variables read by application code have an effect.
# ==============================================================================