
# ==============================================================================
# MedOrbits -- Local Environment Configuration Template
# File: /.env.example
#
# Copy to .env for local development.
# Never commit real credentials or production secrets.
# Production configuration belongs in Render Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application
# ------------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=MedOrbits
APP_VERSION=1.0.0

HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Frontend and API
# ------------------------------------------------------------------------------

API_BASE_URL=http://localhost:3000/api
API_V1_BASE_URL=http://localhost:3000/api/v1

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. Security
# ------------------------------------------------------------------------------

# Generate unique random values before using authentication or encryption.
# Do not use these variable names as proof that the application implements them.
SESSION_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=

# Local HTTP development only.
COOKIE_SECURE=false

# Keep proxy trust disabled unless explicitly configured for your topology.
TRUST_PROXY_HOPS=0

# ------------------------------------------------------------------------------
# 4. PostgreSQL
# ------------------------------------------------------------------------------

# Set DATABASE_URL if the application uses a connection string.
# Example format only:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/medorbits

DATABASE_URL=

PGHOST=localhost
PGPORT=5432
PGDATABASE=medorbits
PGUSER=
PGPASSWORD=

# Local PostgreSQL without TLS. Configure provider-required TLS in production.
PGSSLMODE=disable
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
READINESS_TIMEOUT_MS=3000

# ------------------------------------------------------------------------------
# 5. Optional MySQL
# ------------------------------------------------------------------------------
# Configure only if a separate application component actually uses MySQL.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=medorbits
DB_USER=
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Request Limits and Server Lifecycle
# ------------------------------------------------------------------------------

BODY_LIMIT=1mb

API_RATE_LIMIT=300
API_RATE_WINDOW_MS=900000

SHUTDOWN_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 7. Static Assets
# ------------------------------------------------------------------------------

# Set only if server.js explicitly supports this variable.
# STATIC_DIRECTORY=public

# ------------------------------------------------------------------------------
# 8. Logging
# ------------------------------------------------------------------------------

LOG_LEVEL=debug
ENABLE_REQUEST_LOGS=true

# ------------------------------------------------------------------------------
# 9. Optional AI Integration
# ------------------------------------------------------------------------------

AI_API_URL=
AI_API_KEY=
AI_MODEL=

# ------------------------------------------------------------------------------
# 10. Optional Email / SMTP
# ------------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ------------------------------------------------------------------------------
# 11. Optional Payments
# ------------------------------------------------------------------------------

PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ==============================================================================
# End of template
# ==============================================================================
