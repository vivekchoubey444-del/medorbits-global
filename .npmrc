
; =============================================================================
; MedOrbits | npm Configuration
; File: /.npmrc
; Release: 2.1.1
;
; Purpose:
;   Establish consistent npm behavior for local development and CI.
;
; Security:
;   - Use the official npm registry over HTTPS.
;   - Keep strict SSL verification enabled.
;   - Do not store credentials or authentication tokens in this file.
; =============================================================================

; Package installation and dependency resolution
save-exact=true
save=false
strict-peer-deps=true
legacy-peer-deps=false

; Lockfile and installation strategy
package-lock=true
package-lock-only=false
install-strategy=hoisted
force=false

; Registry and TLS
registry=https://registry.npmjs.org/
strict-ssl=true

; Network retry and timeout settings
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=120000

; Audit and lifecycle scripts
audit=true
fund=false
ignore-scripts=false

; CLI behavior
global=false
update-notifier=false
progress=false
color=true
