
; =============================================================================
; MedOrbits | npm Configuration
; File: /.npmrc
; Release: 2.1.1
;
; Purpose:
;   Establish consistent npm behavior for local development and CI/CD.
;
; Security:
;   - Use the official npm registry over HTTPS.
;   - Keep strict SSL certificate verification enabled.
;   - Never store credentials or authentication tokens here.
;   - Preserve dependency lifecycle scripts unless separately reviewed.
; =============================================================================


; -----------------------------------------------------------------------------
; 1. Package installation and dependency resolution
; -----------------------------------------------------------------------------

save=true
save-exact=true

strict-peer-deps=true
legacy-peer-deps=false


; -----------------------------------------------------------------------------
; 2. Lockfile and installation strategy
; -----------------------------------------------------------------------------

package-lock=true
package-lock-only=false

install-strategy=hoisted

force=false


; -----------------------------------------------------------------------------
; 3. Registry and TLS security
; -----------------------------------------------------------------------------

registry=https://registry.npmjs.org/

strict-ssl=true


; -----------------------------------------------------------------------------
; 4. Network retry and timeout settings
; -----------------------------------------------------------------------------

fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=120000


; -----------------------------------------------------------------------------
; 5. Security audit and package lifecycle
; -----------------------------------------------------------------------------

audit=true
fund=false

ignore-scripts=false


; -----------------------------------------------------------------------------
; 6. CLI behavior
; -----------------------------------------------------------------------------

global=false
update-notifier=false

progress=false
color=true


; -----------------------------------------------------------------------------
; 7. Reproducible installation guidance
; -----------------------------------------------------------------------------
;
; CI/CD:
;   npm ci
;
; Local development:
;   npm install
;
; Dependency installation:
;   npm install package-name
;
; Security review:
;   npm audit
;
; Lockfile verification:
;   npm install --package-lock-only
;
; IMPORTANT:
;   - Commit package-lock.json.
;   - Use npm ci in CI/CD.
;   - Review dependency updates before merging.
;   - Do not use --force or --legacy-peer-deps to hide
;     unresolved dependency conflicts.
;   - Review packages that require lifecycle scripts.
;
; =============================================================================
; End of MedOrbits npm configuration
; =============================================================================
