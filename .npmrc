; =============================================================================
; MedOrbits -- npm Project Configuration
; File: /.npmrc
; Policy version: 2.0.0
; Minimum supported Node.js: 20+
;
; Purpose:
;   Reproducible dependency installation, safer package management,
;   consistent local/CI behavior, and dependency integrity.
;
; Security:
;   Never store tokens, passwords, or private registry credentials here.
;   Use environment variables or CI secret storage.
; =============================================================================

; -----------------------------------------------------------------------------
; Dependency management
; -----------------------------------------------------------------------------

; Pin saved dependency versions when explicitly adding packages.
save-exact=true

; Do not automatically save package changes during ordinary installs.
save=false

; Require compatible peer dependencies instead of silently accepting conflicts.
strict-peer-deps=true
legacy-peer-deps=false

; Keep optional dependencies available for cross-platform compatibility.
optional=true

; Do not automatically omit development dependencies.
; CI should set NODE_ENV appropriately for its installation stage.
omit=

; -----------------------------------------------------------------------------
; Lockfile and reproducibility
; -----------------------------------------------------------------------------

package-lock=true
package-lock-only=false

; Avoid rewriting lockfile metadata during installation where possible.
; Use `npm ci` in CI and deployment environments.
install-strategy=hoisted

; Do not force npm to accept inconsistent lockfile or dependency states.
force=false

; -----------------------------------------------------------------------------
; Registry and transport security
; -----------------------------------------------------------------------------

registry=https://registry.npmjs.org/
strict-ssl=true

; Do not disable TLS verification or use insecure HTTP registries.
; Configure private registries and credentials outside this file.

; -----------------------------------------------------------------------------
; Network reliability
; -----------------------------------------------------------------------------

fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=120000

; -----------------------------------------------------------------------------
; Security auditing and package lifecycle scripts
; -----------------------------------------------------------------------------

audit=true
fund=false

; Keep lifecycle scripts enabled for compatibility with native modules
; and build tools. Use `npm ci --ignore-scripts` only when the project
; has been verified to work without installation scripts.
ignore-scripts=false

; Do not automatically install packages globally.
global=false

; -----------------------------------------------------------------------------
; CLI behavior
; -----------------------------------------------------------------------------

update-notifier=false
progress=false
color=true

; -----------------------------------------------------------------------------
; Operational policy
; -----------------------------------------------------------------------------
;
; 1. Commit package-lock.json to version control.
; 2. Use `npm ci` for clean, lockfile-based CI/deployment installations.
; 3. Run `npm audit` and review findings before applying dependency updates.
; 4. Never run `npm audit fix --force` without reviewing breaking changes.
; 5. Keep registry credentials out of source control.
; 6. Review dependency lifecycle scripts before introducing new packages.
; 7. Keep Node.js and npm on supported release lines.
; 8. Validate configuration against the npm version used in CI.
;
; Example:
;   npm ci
;   npm audit
;   npm run lint
;   npm test
;
; Note:
;   `.npmrc` cannot guarantee dependency integrity or secure package contents.
;   Use lockfile review, CI checks, and dependency scanning as well.
; =============================================================================