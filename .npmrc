
; =============================================================================
; MedOrbits -- npm Project Configuration
; File: /.npmrc
; Policy version: 1.0.0
; Minimum supported Node.js: 20+
;
; Purpose:
;   Consistent npm behavior, safer dependency installation, and CI reliability.
;
; Security:
;   Never store authentication tokens, passwords, or private registry secrets
;   in this file. Use environment variables or CI secret storage.
; =============================================================================

; Dependency installation
save-exact=true
fund=false
audit=true

; Do not silently ignore peer dependency conflicts.
strict-peer-deps=true

; Prevent implicit installation of peer dependencies from masking conflicts.
; Review compatibility before changing this setting.
legacy-peer-deps=false

; Use package-lock.json for reproducible dependency installation.
package-lock=true

; Keep npm from automatically modifying package.json during installs.
; Explicitly save dependencies when intentionally adding packages.
save=false

; Network reliability
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=120000

; Registry
registry=https://registry.npmjs.org/

; Do not disable TLS certificate validation.
strict-ssl=true

; Avoid installing optional platform-specific dependencies as a global policy.
; Leave optional dependencies enabled for cross-platform compatibility.
optional=true

; Reduce lifecycle-script exposure where supported by the installed npm version.
; Do not enable globally without testing native modules and build tooling.
ignore-scripts=false

; Lockfile behavior
package-lock-only=false

; Avoid automatic package manager behavior that can obscure intentional changes.
update-notifier=false

; =============================================================================
; Operational notes
;
; - Commit package-lock.json and use `npm ci` in CI/deployment.
; - Review `npm audit` findings before applying dependency updates.
; - Do not use `npm audit fix --force` without reviewing breaking changes.
; - Keep registry credentials out of source control.
; - npm configuration does not replace dependency review, lockfile integrity
;   checks, or CI security scanning.
; =============================================================================
