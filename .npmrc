
; =============================================================================
; MedOrbits -- npm Project Configuration
; File: /.npmrc
; Policy version: 2.0.1
; Minimum supported Node.js: 20+
; =============================================================================

; Dependency management
save-exact=true
save=false
strict-peer-deps=true
legacy-peer-deps=false
optional=true

; Do not omit development or optional dependencies by default.
; Set NODE_ENV and omit options explicitly in CI when required.

; Lockfile and reproducibility
package-lock=true
package-lock-only=false
install-strategy=hoisted
force=false

; Registry and transport security
registry=https://registry.npmjs.org/
strict-ssl=true

; Network reliability
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=120000

; Auditing and lifecycle scripts
audit=true
fund=false
ignore-scripts=false

; CLI behavior
global=false
update-notifier=false
progress=false
color=true

; Operational policy
; 1. Commit package-lock.json.
; 2. Use npm ci in CI and deployment.
; 3. Run npm audit and review findings.
; 4. Avoid npm audit fix --force without impact analysis.
; 5. Never store registry credentials or tokens in this file.
; 6. Review dependency lifecycle scripts before installing packages.
; 7. Use supported Node.js and npm versions.
; 8. Validate npm settings against the CI npm version.
;
; Recommended validation:
;   npm --version
;   node --version
;   npm config list
;   npm ci
;   npm audit
;   npm run lint
;   npm test
;
; Security note:
; .npmrc does not guarantee package integrity. Use a reviewed lockfile,
; dependency scanning, and CI validation.
; =============================================================================
