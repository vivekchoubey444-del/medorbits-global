
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MedOrbits Application Fixture",
  "description": "Validates synthetic MedOrbits application fixtures used for development and automated testing. Does not validate real admission decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "applications"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/application"
      }
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "userEmail",
        "applicationNumber",
        "courseSlug",
        "collegeSlug",
        "applicantName",
        "applicantEmail",
        "applicantPhone",
        "status",
        "notes",
        "submittedAt",
        "documents",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^APP-TEST-[0-9]{4}$"
        },
        "userEmail": {
          "type": "string",
          "format": "email"
        },
        "applicationNumber": {
          "type": "string",
          "minLength": 1
        },
        "courseSlug": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "collegeSlug": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "applicantName": {
          "type": "string",
          "minLength": 1
        },
        "applicantEmail": {
          "type": "string",
          "format": "email"
        },
        "applicantPhone": {
          "type": ["string", "null"]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "submitted",
            "under_review",
            "approved",
            "rejected",
            "withdrawn",
            "cancelled"
          ]
        },
        "notes": {
          "type": "string"
        },
        "submittedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/applicationDocument"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "applicationDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "documentType",
        "status"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "documentType": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "pending_review",
            "uploaded",
            "under_review",
            "verified",
            "approved",
            "rejected",
            "expired"
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "testCase"
      ],
      "properties": {
        "source": {
          "const": "fixture"
        },
        "testCase": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "const": true
        },
        "verified": {
          "const": false
        }
      }
    }
  }
}
