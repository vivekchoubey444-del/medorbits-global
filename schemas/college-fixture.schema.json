
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/schemas/college-fixture.schema.json",
  "title": "MedOrbits College Fixture",
  "description": "Validates synthetic MedOrbits college fixtures for development and automated testing. Does not verify real institutions, accreditation, fees, rankings, or admission eligibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "colleges"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "colleges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/college"
      }
    }
  },
  "$defs": {
    "college": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "slug",
        "name",
        "type",
        "location",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "integer"
          ],
          "minimum": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "location": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": true,
              "properties": {
                "address": {
                  "type": "string",
                  "maxLength": 500
                },
                "city": {
                  "type": "string",
                  "maxLength": 100
                },
                "district": {
                  "type": "string",
                  "maxLength": 100
                },
                "state": {
                  "type": "string",
                  "maxLength": 100
                },
                "country": {
                  "type": "string",
                  "maxLength": 100
                },
                "pincode": {
                  "type": "string",
                  "maxLength": 20
                },
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              }
            }
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "synthetic",
        "verified"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "synthetic": {
          "const": true
        },
        "verified": {
          "const": false
        },
        "testCase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
