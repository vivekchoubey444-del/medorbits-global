
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/schemas/application.schema.json",
  "title": "MedOrbits Application",
  "description": "Validation schema for MedOrbits education, admission, and career-service applications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "email"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Server-generated application identifier."
    },
    "applicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Alternative application identifier used by compatible integrations."
    },
    "userId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Identifier of the associated user. The server must establish ownership."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120,
      "pattern": ".*\\S.*",
      "description": "Applicant's full name."
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254,
      "description": "Applicant's email address."
    },
    "phone": {
      "type": "string",
      "minLength": 7,
      "maxLength": 25,
      "pattern": "^[+0-9() .-]+$",
      "description": "Applicant's contact number."
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date",
      "description": "Applicant's date of birth in YYYY-MM-DD format."
    },
    "country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "postalCode": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20
    },
    "applicationType": {
      "type": "string",
      "enum": [
        "admission",
        "education",
        "career",
        "job",
        "consultancy",
        "other"
      ],
      "default": "admission"
    },
    "course": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Requested course or program."
    },
    "courseLevel": {
      "type": "string",
      "enum": [
        "school",
        "diploma",
        "undergraduate",
        "postgraduate",
        "doctoral",
        "certificate",
        "other"
      ]
    },
    "courseCategory": {
      "type": "string",
      "enum": [
        "medical",
        "dental",
        "ayush",
        "paramedical",
        "nursing",
        "engineering",
        "management",
        "science",
        "arts",
        "commerce",
        "study_abroad",
        "other"
      ]
    },
    "preferredCollege": {
      "type": "string",
      "maxLength": 200
    },
    "preferredUniversity": {
      "type": "string",
      "maxLength": 200
    },
    "preferredCountry": {
      "type": "string",
      "maxLength": 100
    },
    "academicDetails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qualification": {
          "type": "string",
          "maxLength": 120
        },
        "boardOrUniversity": {
          "type": "string",
          "maxLength": 200
        },
        "passingYear": {
          "type": "integer",
          "minimum": 1950,
          "maximum": 2100
        },
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "grade": {
          "type": "string",
          "maxLength": 20
        },
        "entranceExam": {
          "type": "string",
          "maxLength": 120
        },
        "entranceExamScore": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "entranceExamRank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferredLocations": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "budgetMin": {
          "type": "number",
          "minimum": 0
        },
        "budgetMax": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "INR"
        },
        "studyMode": {
          "type": "string",
          "enum": [
            "on_campus",
            "online",
            "hybrid",
            "distance",
            "not_specified"
          ]
        },
        "intake": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "message": {
      "type": "string",
      "maxLength": 5000,
      "description": "Applicant's message or additional requirements."
    },
    "documents": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/documentReference"
      },
      "description": "References to uploaded documents; not raw file contents."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "documents_required",
        "approved",
        "rejected",
        "withdrawn",
        "completed"
      ],
      "default": "draft",
      "description": "Application workflow status. Status transitions must be enforced by the server."
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "assignedTo": {
      "type": "string",
      "maxLength": 128,
      "description": "Identifier of the assigned staff member, set by authorized server-side workflows."
    },
    "counsellorNotes": {
      "type": "string",
      "maxLength": 10000,
      "description": "Internal notes. Must not be exposed to unauthorized users."
    },
    "reviewNotes": {
      "type": "string",
      "maxLength": 10000,
      "description": "Review notes with access controlled by the backend."
    },
    "submittedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approvedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "rejectedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "withdrawnAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Server-generated creation timestamp."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Server-generated update timestamp."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 100
        },
        "campaign": {
          "type": "string",
          "maxLength": 160
        },
        "locale": {
          "type": "string",
          "maxLength": 20
        },
        "timezone": {
          "type": "string",
          "maxLength": 80
        }
      }
    }
  },
  "$defs": {
    "documentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Server-issued document identifier."
        },
        "documentType": {
          "type": "string",
          "enum": [
            "identity",
            "photograph",
            "signature",
            "academic_certificate",
            "transcript",
            "entrance_exam",
            "category_certificate",
            "domicile_certificate",
            "passport",
            "resume",
            "recommendation_letter",
            "other"
          ]
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mimeType": {
          "type": "string",
          "enum": [
            "application/pdf",
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10485760
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time"
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "pending",
            "verified",
            "rejected",
            "not_required"
          ],
          "default": "pending"
        }
      }
    }
  }
}

