{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/schemas/user-fixture.schema.json",
  "title": "MedOrbits User Fixtures",
  "description": "Validates synthetic MedOrbits user fixtures for local development and automated testing only. These records must never be treated as production user accounts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "users"
  ],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "metadata": {
      "$ref": "#/$defs/fixtureMetadata"
    },
    "users": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/user"
      }
    }
  },
  "$defs": {
    "fixtureMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "synthetic",
        "productionEligible"
      ],
      "properties": {
        "source": {
          "const": "fixture"
        },
        "synthetic": {
          "const": true
        },
        "productionEligible": {
          "const": false
        },
        "generatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "email",
        "role",
        "status",
        "emailVerified",
        "phone",
        "phoneVerified",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^USR-TEST-[0-9]{4,}$",
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "pattern": ".*\\S.*"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "pattern": "^[^\\s@]+@example\\.invalid$"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "admin",
            "counsellor",
            "employer"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "pending",
            "suspended",
            "disabled"
          ]
        },
        "emailVerified": {
          "type": "boolean"
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32,
          "pattern": "^\\+?[0-9 ()-]{7,32}$"
        },
        "phoneVerified": {
          "type": "boolean"
        },
        "metadata": {
          "$ref": "#/$defs/userMetadata"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "emailVerified": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phone": {
                "type": "null"
              }
            },
            "required": [
              "phone"
            ]
          },
          "then": {
            "properties": {
              "phoneVerified": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "userMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "testCase",
        "synthetic",
        "verified"
      ],
      "properties": {
        "source": {
          "const": "fixture"
        },
        "testCase": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,79}$"
        },
        "synthetic": {
          "const": true
        },
        "verified": {
          "const": false
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}