
{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "singleAttributePerLine": false,
  "proseWrap": "preserve",
  "htmlWhitespaceSensitivity": "css",
  "vueIndentScriptAndStyle": false,
  "objectWrap": "preserve",
  "requirePragma": false,
  "insertPragma": false,
  "overrides": [
    {
      "files": [
        "*.js",
        "*.cjs",
        "*.mjs",
        "*.jsx"
      ],
      "options": {
        "parser": "babel",
        "printWidth": 100,
        "tabWidth": 2,
        "semi": true,
        "singleQuote": false,
        "trailingComma": "all"
      }
    },
    {
      "files": [
        "*.ts",
        "*.cts",
        "*.mts",
        "*.tsx"
      ],
      "options": {
        "parser": "typescript",
        "printWidth": 100,
        "tabWidth": 2,
        "semi": true,
        "singleQuote": false,
        "trailingComma": "all"
      }
    },
    {
      "files": [
        "*.html",
        "*.htm"
      ],
      "options": {
        "parser": "html",
        "printWidth": 100,
        "tabWidth": 2,
        "htmlWhitespaceSensitivity": "css",
        "bracketSameLine": false
      }
    },
    {
      "files": [
        "*.css",
        "*.scss",
        "*.less"
      ],
      "options": {
        "printWidth": 100,
        "tabWidth": 2,
        "singleQuote": false
      }
    },
    {
      "files": [
        "*.json",
        "*.jsonc"
      ],
      "options": {
        "printWidth": 100,
        "tabWidth": 2,
        "useTabs": false,
        "trailingComma": "none"
      }
    },
    {
      "files": [
        "*.yaml",
        "*.yml"
      ],
      "options": {
        "printWidth": 100,
        "tabWidth": 2,
        "singleQuote": false
      }
    },
    {
      "files": [
        "*.md",
        "*.mdx"
      ],
      "options": {
        "printWidth": 100,
        "proseWrap": "preserve",
        "tabWidth": 2
      }
    },
    {
      "files": [
        "*.yml",
        "*.yaml"
      ],
      "options": {
        "singleQuote": false,
        "bracketSpacing": true
      }
    },
    {
      "files": [
        "*.graphql",
        "*.gql"
      ],
      "options": {
        "printWidth": 100,
        "tabWidth": 2
      }
    },
    {
      "files": [
        "*.vue"
      ],
      "options": {
        "printWidth": 100,
        "tabWidth": 2,
        "vueIndentScriptAndStyle": false
      }
    }
  ]
}
