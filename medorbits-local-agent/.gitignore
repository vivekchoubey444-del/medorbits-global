
# ==========================================
# MedOrbits Local Agent -- Git Ignore Rules
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample

# Credentials and private keys
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
credentials.json
secrets.json
secrets/
credentials/

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Package-manager temporary files
.npm/
.pnpm-store/

# Runtime logs
logs/
*.log

# Runtime state and process files
*.pid
*.pid.lock
pids/
*.seed

# Coverage and test artifacts
coverage/
.nyc_output/
test-results/
playwright-report/

# Build and generated output
dist/
build/
.tmp/
.temp/
.cache/
.parcel-cache/

# Generated agent reports
# Keep the directory tracked with reports/.gitkeep.
reports/*
!reports/.gitkeep

# Local databases and database sidecars
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-shm
*.sqlite-wal

# Editor and operating-system files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# IDE settings
.idea/
.vscode/
!.vscode/extensions.json

# Local agent state
.agent-state/
.agent-cache/
.agent-tmp/

# Temporary patches and backups
*.patch.tmp
*.diff.tmp
*.bak
*.backup
*.orig
*.rej

# Local environment overrides
.env.local
.env.development.local
.env.test.local
.env.production.local

# Do not ignore source code, tests, docs, or lockfiles.
# Keep package-lock.json tracked for reproducible installs.
