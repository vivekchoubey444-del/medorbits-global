{
  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "trustProxy": 0
  },
  "cors": {
    "allowedOrigins": [
      "http://localhost:3000"
    ],
    "allowCredentials": false
  },
  "rateLimit": {
    "windowMs": 900000,
    "max": 200
  },
  "database": {
    "connectionLimit": 10,
    "connectTimeoutMs": 10000
  },
  "session": {
    "ttlMs": 86400000
  },
  "features": {
    "ai": false,
    "email": false,
    "payments": false
  },
  "logging": {
    "level": "debug"
  },
  "environment": "development",
  "_note": "Non-secret defaults only. Secrets come from environment variables or the deployment secrets manager."
}
