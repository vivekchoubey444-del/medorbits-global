
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/schemas/env.schema.json",
  "title": "MedOrbits Environment Configuration",
  "description": "Validation schema for MedOrbits environment variable names and value formats. Variables must be verified against actual application usage before being marked required.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "NODE_ENV": {
      "type": "string",
      "enum": ["development", "test", "staging", "production"],
      "default": "development",
      "description": "Runtime environment."
    },
    "PORT": {
      "type": "string",
      "pattern": "^[0-9]{1,5}$",
      "description": "HTTP server port. Application validation should enforce the range 1–65535."
    },
    "HOST": {
      "type": "string",
      "minLength": 1,
      "description": "Optional server bind address."
    },
    "APP_NAME": {
      "type": "string",
      "minLength": 1
    },
    "APP_URL": {
      "type": "string",
      "format": "uri",
      "description": "Public application URL."
    },
    "FRONTEND_URL": {
      "type": "string",
      "format": "uri",
      "description": "Frontend origin, if used by the application."
    },
    "API_BASE_URL": {
      "type": "string",
      "format": "uri",
      "description": "Public API base URL, if configured."
    },
    "DATABASE_URL": {
      "type": "string",
      "minLength": 1,
      "description": "Database connection URL, only if supported by the configured database driver."
    },
    "DB_HOST": {
      "type": "string",
      "minLength": 1
    },
    "DB_PORT": {
      "type": "string",
      "pattern": "^[0-9]{1,5}$"
    },
    "DB_NAME": {
      "type": "string",
      "minLength": 1
    },
    "DB_USER": {
      "type": "string",
      "minLength": 1
    },
    "DB_PASSWORD": {
      "type": "string",
      "minLength": 1,
      "description": "Database password. Never log or expose its value."
    },
    "DB_CONNECTION_LIMIT": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "DB_SSL": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "SESSION_SECRET": {
      "type": "string",
      "minLength": 32,
      "description": "Session signing secret. Set a strong, randomly generated value."
    },
    "JWT_SECRET": {
      "type": "string",
      "minLength": 32,
      "description": "JWT signing secret, if JWT authentication is implemented."
    },
    "JWT_EXPIRES_IN": {
      "type": "string",
      "minLength": 1
    },
    "COOKIE_SECURE": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "COOKIE_SAME_SITE": {
      "type": "string",
      "enum": ["strict", "lax", "none"]
    },
    "CORS_ORIGIN": {
      "type": "string",
      "minLength": 1,
      "description": "Configured CORS origin or origin list, according to application implementation."
    },
    "RATE_LIMIT_WINDOW_MS": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "RATE_LIMIT_MAX": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "LOG_LEVEL": {
      "type": "string",
      "enum": ["fatal", "error", "warn", "info", "debug", "trace", "silent"]
    },
    "LOG_FORMAT": {
      "type": "string",
      "enum": ["json", "pretty", "text"]
    },
    "AI_API_KEY": {
      "type": "string",
      "minLength": 1,
      "description": "AI provider credential, if AI integration is enabled. Keep secret."
    },
    "AI_API_URL": {
      "type": "string",
      "format": "uri",
      "description": "AI provider endpoint, if supported."
    },
    "AI_MODEL": {
      "type": "string",
      "minLength": 1
    },
    "SMTP_HOST": {
      "type": "string",
      "minLength": 1
    },
    "SMTP_PORT": {
      "type": "string",
      "pattern": "^[0-9]{1,5}$"
    },
    "SMTP_USER": {
      "type": "string",
      "minLength": 1
    },
    "SMTP_PASSWORD": {
      "type": "string",
      "minLength": 1,
      "description": "SMTP credential. Keep secret."
    },
    "SMTP_FROM": {
      "type": "string",
      "format": "email"
    },
    "REDIS_URL": {
      "type": "string",
      "format": "uri",
      "description": "Redis connection URL, if Redis is used."
    },
    "STORAGE_DRIVER": {
      "type": "string",
      "enum": ["local", "s3", "gcs", "azure"]
    },
    "UPLOAD_MAX_BYTES": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "S3_BUCKET": {
      "type": "string",
      "minLength": 1
    },
    "S3_REGION": {
      "type": "string",
      "minLength": 1
    },
    "S3_ACCESS_KEY_ID": {
      "type": "string",
      "minLength": 1
    },
    "S3_SECRET_ACCESS_KEY": {
      "type": "string",
      "minLength": 1,
      "description": "Object-storage credential. Keep secret."
    },
    "SENTRY_DSN": {
      "type": "string",
      "format": "uri",
      "description": "Optional error-monitoring endpoint."
    },
    "RENDER_SERVICE_ID": {
      "type": "string",
      "minLength": 1
    },
    "RENDER_DEPLOY_HOOK": {
      "type": "string",
      "format": "uri",
      "description": "Sensitive deployment URL. Never expose in logs or client-side code."
    },
    "RENDER_STAGING_DEPLOY_HOOK": {
      "type": "string",
      "format": "uri",
      "description": "Sensitive staging deployment URL. Never expose in logs or client-side code."
    },
    "ADMIN_TOKEN": {
      "type": "string",
      "minLength": 32,
      "description": "Administrative API token, if supported. Keep secret."
    },
    "TRUST_PROXY": {
      "type": "string",
      "enum": ["true", "false", "1", "0"]
    },
    "FORCE_HTTPS": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "MAINTENANCE_MODE": {
      "type": "string",
      "enum": ["true", "false"]
    }
  },
  "x-medorbits-policy": {
    "version": "1.0.0",
    "classification": "candidate",
    "requiredVariables": [],
    "security": {
      "neverCommitSecrets": true,
      "neverLogSecretValues": true,
      "neverExposeServerSecretsToFrontend": true,
      "validateProductionSecretsAtStartup": true
    },
    "validationNotes": [
      "Environment variables are commonly represented as strings in Node.js.",
      "An omitted property is permitted unless application-level validation explicitly requires it.",
      "Only retain properties verified against the actual application source and deployment configuration.",
      "Do not use this schema to automatically populate production environment variables.",
      "The JSON Schema format keyword requires a validator configured to assert formats."
    ]
  }
}
