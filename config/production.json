{
  "server": {
    "host": "0.0.0.0",
    "port": 3000,
    "trustProxy": 1
  },
  "cors": {
    "allowedOrigins": [
      "https://medorbits.in",
      "https://www.medorbits.in"
    ],
    "allowCredentials": false
  },
  "rateLimit": {
    "windowMs": 900000,
    "max": 200
  },
  "database": {
    "connectionLimit": 10,
    "connectTimeoutMs": 10000
  },
  "session": {
    "ttlMs": 86400000
  },
  "features": {
    "ai": false,
    "email": false,
    "payments": false
  },
  "logging": {
    "level": "info"
  },
  "environment": "production",
  "_note": "Non-secret defaults only. Secrets come from environment variables or the deployment secrets manager."
}
