
# ==============================================================================
# MedOrbits Mobile -- Environment Configuration Template
# File: /mobile/.env.example
# Purpose: Document public mobile-app configuration variables.
#
# IMPORTANT:
# - Never put private API keys, passwords, database credentials, or tokens
#   in a mobile application's environment variables.
# - Values bundled into a mobile app can be extracted by users.
# - Keep this file free of real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME=MedOrbits
APP_ENV=development
APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# API configuration
# Replace with the appropriate API URL for your environment.
# Android emulator: use 10.0.2.2 to reach the host machine's localhost.
# iOS simulator: localhost may work when the API runs on the host machine.
# Physical devices: use your development machine's LAN IP or a public HTTPS URL.
# ------------------------------------------------------------------------------
API_BASE_URL=https://api.example.com
API_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Web application
# ------------------------------------------------------------------------------
WEB_BASE_URL=https://medorbits.in
PRIVACY_POLICY_URL=https://medorbits.in/privacy
TERMS_OF_SERVICE_URL=https://medorbits.in/terms

# ------------------------------------------------------------------------------
# Feature flags
# Use only if supported by the mobile application.
# ------------------------------------------------------------------------------
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_PUSH_NOTIFICATIONS=false

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=info

# ==============================================================================
# Setup notes
#
# 1. Copy this file to the environment file required by your framework.
# 2. Configure framework-specific variable prefixes where required.
# 3. Verify that the app reads these variables before relying on them.
# 4. Keep real credentials out of source control and mobile bundles.
# 5. Add local environment files to .gitignore.
# 6. Enforce authentication, authorization, validation, and rate limiting
#    on the server; mobile configuration is not a security boundary.
# ==============================================================================
