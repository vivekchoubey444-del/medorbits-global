{
  "name": "medorbits-mobile",
  "version": "1.1.0",
  "private": true,
  "description": "Capacitor mobile application shell for the MedOrbits education platform",
  "type": "module",
  "scripts": {
    "stage:web": "node scripts/stage-web.mjs",
    "stage:check": "node scripts/check-stage.mjs",
    "config:check": "node scripts/check-config.mjs",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "android:build": "cap build android",
    "ios:build": "cap build ios",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run config:check && npm test && npm run stage:check"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
