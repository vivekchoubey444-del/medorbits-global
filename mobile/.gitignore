
# ==============================================================================
# MedOrbits Mobile -- Git Ignore Rules
# File: /mobile/.gitignore
# Purpose: Exclude secrets, generated files, caches, and local build artifacts.
# ==============================================================================

# Environment files and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.keystore
*.jks
*.p12
*.pfx
*.mobileprovision
*.provisionprofile
secrets/
credentials/
private-keys/

# Dependencies
node_modules/
.pnp/
.pnp.*
vendor/

# Package-manager caches
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml

# Logs and diagnostics
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
*.stacktrace
crash-dumps/
reports/

# Temporary files and editor artifacts
.tmp/
temp/
tmp/
.cache/
.parcel-cache/
.turbo/
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Test and coverage output
coverage/
.nyc_output/
test-results/
playwright-report/
junit.xml

# JavaScript and TypeScript build output
dist/
build/
out/
lib/
*.tsbuildinfo

# React Native / Metro
.metro-health-check*
.metro-cache/
*.bundle
*.hbc

# Expo
.expo/
.expo-shared/
web-build/
expo-env.d.ts

# Android / Gradle
android/.gradle/
android/local.properties
android/.idea/
android/**/build/
android/**/.cxx/
android/**/captures/
android/**/outputs/
android/**/intermediates/
android/**/generated/
android/key.properties
android/app/google-services.json

# iOS / Xcode
ios/Pods/
ios/build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcuserstate
ios/xcuserdata/
ios/*.ipa
ios/*.dSYM
ios/*.dSYM.zip
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/screenshots/
ios/fastlane/test_output/
ios/GoogleService-Info.plist

# Flutter (if this mobile folder contains Flutter)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
.flutter-*
*.freezed.dart
*.g.dart

# Python tooling (if used by mobile utilities)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/

# Local databases and data
*.sqlite
*.sqlite3
*.db
local-data/
uploads/
downloads/

# Generated API clients and artifacts
generated/
*.generated.*
*.gen.*

# Keep dependency lockfiles committed for reproducible builds.
# Do not ignore package-lock.json, npm-shrinkwrap.json, yarn.lock,
# pnpm-lock.yaml, pubspec.lock, or Podfile.lock by default.

# ==============================================================================
# Review before committing:
# - Keep .env.example tracked; never commit actual credentials.
# - Do not ignore source files or configuration required by CI.
# - If a credential has already been committed, revoke and rotate it.
# ==============================================================================
