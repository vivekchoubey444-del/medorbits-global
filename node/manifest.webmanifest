
{
  "id": "/node/",
  "name": "MedOrbits Node Infrastructure",
  "short_name": "MedOrbits Node",
  "description": "MedOrbits Node.js infrastructure management, runtime diagnostics, system health and development tools.",
  "lang": "en",
  "dir": "ltr",

  "start_url": "/node/",
  "scope": "/node/",

  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],

  "orientation": "any",

  "theme_color": "#09151b",
  "background_color": "#09151b",

  "categories": [
    "education",
    "productivity",
    "utilities",
    "developer-tools"
  ],

  "prefer_related_applications": false,

  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Node.js Diagnostics",
      "short_name": "Diagnostics",
      "description": "Open MedOrbits Node.js diagnostics.",
      "url": "/node/"
    },
    {
      "name": "System Health",
      "short_name": "Health",
      "description": "Check infrastructure health.",
      "url": "/node/health/"
    }
  ],

  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },

  "handle_links": "preferred",

  "protocol_handlers": [],

  "related_applications": []
}
