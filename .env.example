DB_PASSWORD=replace_with_local_database_password
DATABASE_URL=

DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000
DB_IDLE_TIMEOUT=60000
DB_WAIT_FOR_CONNECTIONS=true
DB_ENABLE_KEEPALIVE=true
DB_TIMEZONE=Z
DB_LOG_QUERIES=false

DB_SSL_ENABLED=false
DB_SSL_CA_PATH=
DB_SSL_CERT_PATH=
DB_SSL_KEY_PATH=

DB_AUTO_MIGRATE=false
DB_AUTO_SEED=false
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
DB_HEALTH_CHECK_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=10000

Use a least-privilege application account.

Run schema migrations using a controlled deployment step.

Never enable automatic production seeding without explicit safeguards.

