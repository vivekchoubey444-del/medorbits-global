06. REDIS, CACHE AND RATE-LIMIT STORAGE

=============================================================================

REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=
REDIS_TLS_ENABLED=false
REDIS_CONNECT_TIMEOUT=10000
REDIS_KEY_PREFIX=medorbits:

CACHE_ENABLED=false
CACHE_TTL_SECONDS=300

RATE_LIMIT_STORE=memory
