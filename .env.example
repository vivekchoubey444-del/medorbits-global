# ==============================================================================
# MedOrbits -- Environment Variable Example
# File: /.env.example
# Release: 3.0.0
# Runtime: Node.js 20+ (use a currently supported Node.js LTS release)
# Backend: Express.js
# Database: MySQL
# Website: https://www.medorbits.in
#
# Purpose:
#   Document local development configuration and optional application
#   integrations without including real credentials.
#
# Local setup:
#   cp .env.example .env
#   Edit .env with local development values.
#
# SECURITY:
#   - Never commit .env or production credentials.
#   - Use hosting-provider secrets for production deployments.
#   - Only variables consumed by application code have an effect.
#   - Keep test and production databases completely separate.
#   - Do not enable integrations until their adapters are implemented.
# ==============================================================================


# ------------------------------------------------------------------------------
# 01. APPLICATION RUNTIME
# ------------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=MedOrbits
APP_VERSION=3.0.0
APP_ENVIRONMENT=local

HOST=127.0.0.1
PORT=3000
API_PREFIX=/api/v1

APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:3000
SUPPORT_EMAIL=support@medorbits.in

DEPLOYMENT_REGION=
INSTANCE_ID=local
RELEASE_SHA=
BUILD_TIMESTAMP=

SHUTDOWN_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000

ENABLE_GRACEFUL_SHUTDOWN=true
ENABLE_STARTUP_BANNER=true
ENABLE_STACK_TRACES=false


# ------------------------------------------------------------------------------
# 02. CORS AND SECURITY HEADERS
# ------------------------------------------------------------------------------

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keep aliases only if they are consumed by your application.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=600

CORS_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Request-ID,X-Correlation-ID,X-CSRF-Token

ENABLE_SECURITY_HEADERS=true
ENABLE_CSP=false
CROSS_ORIGIN_RESOURCE_POLICY=same-site
REFERRER_POLICY=strict-origin-when-cross-origin

TRUST_PROXY_HOPS=0


# ------------------------------------------------------------------------------
# 03. MYSQL DATABASE
# ------------------------------------------------------------------------------

DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medorbits
DB_USER=medorbits_app
DB_PASSWORD=

DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
DB_QUEUE_LIMIT=100
DB_CHECK_ON_START=true

DB_ENABLE_KEEP_ALIVE=true
DB_KEEP_ALIVE_INITIAL_DELAY_MS=0
DB_IDLE_TIMEOUT_MS=60000
DB_MAX_IDLE_CONNECTIONS=5

DB_QUERY_TIMEOUT_MS=15000
DB_SLOW_QUERY_THRESHOLD_MS=1000
DB_LOG_QUERIES=false
DB_LOG_PARAMETERS=false
DB_MULTIPLE_STATEMENTS=false

DB_DEFAULT_ISOLATION_LEVEL=READ COMMITTED
DB_TRANSACTION_TIMEOUT_MS=30000

DB_SSL_ENABLED=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional TLS certificate paths.
# DB_SSL_CA_PATH=
# DB_SSL_CERT_PATH=
# DB_SSL_KEY_PATH=

DB_READ_REPLICA_ENABLED=false
# DB_READ_REPLICA_HOST=
# DB_READ_REPLICA_PORT=3306
# DB_READ_REPLICA_NAME=
# DB_READ_REPLICA_USER=
# DB_READ_REPLICA_PASSWORD=

DB_AUTO_MIGRATE=false
DB_SEED_ON_START=false

# Alternative connection string; use only if supported by the adapter.
# DATABASE_URL=mysql://medorbits_app:LOCAL_PASSWORD@127.0.0.1:3306/medorbits


# ------------------------------------------------------------------------------
# 04. AUTHENTICATION AND PASSWORD SECURITY
# ------------------------------------------------------------------------------

# Generate independent, cryptographically random values when required.
# Never reuse production secrets.
SESSION_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_ISSUER=https://www.medorbits.in
JWT_AUDIENCE=medorbits-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ALGORITHM=HS256

JWT_REFRESH_ROTATION=true
JWT_REVOKE_ON_LOGOUT=true
JWT_CLOCK_TOLERANCE_SECONDS=30

PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=false
PASSWORD_BCRYPT_ROUNDS=12

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=900000
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_ALLOW_SELF_REGISTRATION=true
AUTH_REQUIRE_MFA_FOR_ADMIN=true

PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24


# ------------------------------------------------------------------------------
# 05. SESSION, COOKIES, AND CSRF
# ------------------------------------------------------------------------------

SESSION_ENABLED=true
SESSION_COOKIE_NAME=medorbits.sid
SESSION_TTL_MS=86400000
SESSION_STORE=mysql

COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/
COOKIE_DOMAIN=
COOKIE_PARTITIONED=false

CSRF_PROTECTION_ENABLED=true
CSRF_COOKIE_NAME=medorbits.csrf
CSRF_HEADER_NAME=X-CSRF-Token


# ------------------------------------------------------------------------------
# 06. AUTHORIZATION AND ADMIN SECURITY
# ------------------------------------------------------------------------------

RBAC_ENABLED=true
ADMIN_MFA_REQUIRED=true
ADMIN_SESSION_TTL_MS=3600000
ADMIN_IDLE_TIMEOUT_MS=900000
ADMIN_REQUIRE_VERIFIED_EMAIL=true

# Optional application-specific restrictions.
# ADMIN_ALLOWED_EMAILS=
# ADMIN_ALLOWED_IPS=


# ------------------------------------------------------------------------------
# 07. RATE LIMITING
# ------------------------------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=5

UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=20

SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX_REQUESTS=60

# Legacy or alternate rate-limit settings; retain only if consumed by code.
API_RATE_LIMIT=100
API_RATE_LIMIT_STANDARD=100
API_RATE_LIMIT_PREMIUM=300
API_RATE_WINDOW_MS=900000

RATE_LIMIT_STORE=memory
RATE_LIMIT_KEY_STRATEGY=ip

# REDIS_URL=


# ------------------------------------------------------------------------------
# 08. EMAIL AND SMTP
# ------------------------------------------------------------------------------

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

EMAIL_FROM_NAME=MedOrbits
EMAIL_FROM_ADDRESS=no-reply@medorbits.in
EMAIL_REPLY_TO=support@medorbits.in

EMAIL_SEND_TIMEOUT_MS=10000
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_GREETING_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=20000

EMAIL_POOLING_ENABLED=true
EMAIL_MAX_CONNECTIONS=5
EMAIL_MAX_MESSAGES=100
EMAIL_RETRY_ENABLED=true
EMAIL_MAX_RETRIES=3

EMAIL_VERIFICATION_ENABLED=true
PASSWORD_RESET_EMAIL_ENABLED=true
APPLICATION_CONFIRMATION_EMAIL_ENABLED=true
JOB_ALERT_EMAIL_ENABLED=false
NEWSLETTER_EMAIL_ENABLED=false

# EMAIL_API_KEY=
# EMAIL_WEBHOOK_SECRET=


# ------------------------------------------------------------------------------
# 09. LOGGING AND AUDITING
# ------------------------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=json
LOG_REDACT_SENSITIVE=true
LOG_INCLUDE_STACKS=false
LOG_REQUESTS=true
LOG_RESPONSE_BODIES=false
LOG_SQL=false
LOG_SQL_PARAMETERS=false

LOG_MAX_FIELD_LENGTH=500
LOG_RETENTION_DAYS=30

REQUEST_ID_HEADER=X-Request-ID
CORRELATION_ID_HEADER=X-Correlation-ID
GENERATE_REQUEST_ID=true

AUDIT_LOG_ENABLED=true
AUDIT_LOG_AUTH_EVENTS=true
AUDIT_LOG_ADMIN_ACTIONS=true
AUDIT_LOG_DOCUMENT_ACCESS=true
AUDIT_LOG_RETENTION_DAYS=365


# ------------------------------------------------------------------------------
# 10. UPLOADS AND DOCUMENT STORAGE
# ------------------------------------------------------------------------------

UPLOADS_ENABLED=true
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_MAX_FILES=5
UPLOAD_MAX_TOTAL_SIZE_BYTES=52428800

UPLOAD_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png
UPLOAD_DIRECTORY=storage/uploads
UPLOAD_TEMP_DIRECTORY=storage/tmp

UPLOAD_FILENAME_STRATEGY=random
UPLOAD_OVERWRITE_EXISTING=false
UPLOAD_PRESERVE_ORIGINAL_FILENAME=false
UPLOAD_VALIDATE_SIGNATURE=true
UPLOAD_SCAN_FOR_MALWARE=false
UPLOAD_REJECT_EXECUTABLES=true

DOCUMENTS_PRIVATE=true
DOCUMENT_DOWNLOAD_AUTH_REQUIRED=true
DOCUMENT_SIGNED_URLS_ENABLED=false
DOCUMENT_SIGNED_URL_TTL_SECONDS=300

OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_PROVIDER=s3

# Configure only when object storage integration is implemented.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_REGION=ap-south-1
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Optional malware-scanning integration.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=10000


# ------------------------------------------------------------------------------
# 11. APPLICATIONS AND ADMISSIONS
# ------------------------------------------------------------------------------

APPLICATIONS_ENABLED=true
APPLICATIONS_REQUIRE_AUTH=true
APPLICATIONS_ALLOW_DRAFTS=true
APPLICATIONS_MAX_PER_USER=20
APPLICATIONS_REFERENCE_PREFIX=MO
APPLICATIONS_REFERENCE_RANDOM_BYTES=8

APPLICATION_DOCUMENTS_ENABLED=true
APPLICATION_DOCUMENT_REVIEW_REQUIRED=true
APPLICATION_DOCUMENT_VERSIONING=true
APPLICATION_DOCUMENT_MAX_VERSIONS=10

APPLICATION_NOTIFY_ON_SUBMISSION=true
APPLICATION_NOTIFY_ON_STATUS_CHANGE=true
APPLICATION_REQUIRE_ADMIN_REVIEW=true

APPLICATION_DATA_RETENTION_DAYS=730
APPLICATION_AUTO_DELETE_EXPIRED=false


# ------------------------------------------------------------------------------
# 12. CAREERS AND RECRUITMENT
# ------------------------------------------------------------------------------

JOBS_ENABLED=true
JOB_APPLICATIONS_ENABLED=true
EMPLOYER_ACCOUNTS_ENABLED=true
RECRUITMENT_SERVICES_ENABLED=true
CAREER_GUIDANCE_ENABLED=true
RESUME_UPLOAD_ENABLED=true

JOB_ALERTS_ENABLED=false
JOB_ALERT_DIGEST_FREQUENCY=daily

JOB_LISTING_DEFAULT_STATUS=pending_review
JOB_LISTING_REQUIRE_MODERATION=true
JOB_LISTING_MAX_ACTIVE_PER_EMPLOYER=100

EXTERNAL_JOB_FEEDS_ENABLED=false
EXTERNAL_JOB_FEED_SYNC_INTERVAL_MINUTES=60


# ------------------------------------------------------------------------------
# 13. AI INTEGRATION
# ------------------------------------------------------------------------------

AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_API_URL=
AI_API_KEY=

AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2000
AI_TEMPERATURE=0.2

AI_ADMISSIONS_ASSISTANT_ENABLED=false
AI_CAREER_ASSISTANT_ENABLED=false
AI_RESUME_ASSISTANT_ENABLED=false
AI_DOCUMENT_EXTRACTION_ENABLED=false
AI_CHAT_HISTORY_ENABLED=false

AI_REQUIRE_USER_CONSENT=true
AI_SEND_PERSONAL_DOCUMENTS=false
AI_REDACT_PERSONAL_DATA=true
AI_LOG_PROMPTS=false
AI_LOG_RESPONSES=false


# ------------------------------------------------------------------------------
# 14. PAYMENTS AND SUBSCRIPTIONS
# ------------------------------------------------------------------------------

PAYMENT_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=INR
PAYMENT_CAPTURE_MODE=automatic
PAYMENT_REQUEST_TIMEOUT_MS=15000
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

PAYMENT_IDEMPOTENCY_ENABLED=true
PAYMENT_REQUIRE_WEBHOOK_SIGNATURE=true
PAYMENT_LOG_SENSITIVE_DATA=false

# Configure only for the selected payment provider.
# PAYMENT_PUBLIC_KEY=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_DEFAULT_CURRENCY=INR
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
SUBSCRIPTION_RENEWAL_REMINDERS_ENABLED=false


# ------------------------------------------------------------------------------
# 15. SMS AND OTP
# ------------------------------------------------------------------------------

SMS_ENABLED=false
SMS_PROVIDER=
SMS_DEFAULT_COUNTRY_CODE=+91

OTP_ENABLED=false
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HASH_AT_REST=true

# SMS_API_KEY=
# SMS_API_SECRET=
# SMS_SENDER_ID=
# SMS_TEMPLATE_ID=


# ------------------------------------------------------------------------------
# 16. PUSH NOTIFICATIONS AND WEBHOOKS
# ------------------------------------------------------------------------------

PUSH_NOTIFICATIONS_ENABLED=false
WEB_PUSH_ENABLED=false

# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@medorbits.in

WEBHOOKS_ENABLED=false
WEBHOOK_SIGNING_SECRET=
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_MS=1000
WEBHOOK_TIMEOUT_MS=10000


# ------------------------------------------------------------------------------
# 17. CACHE AND REDIS
# ------------------------------------------------------------------------------

CACHE_ENABLED=false
CACHE_PROVIDER=memory
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

REDIS_ENABLED=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_KEY_PREFIX=medorbits:

# REDIS_URL=

DISTRIBUTED_LOCKS_ENABLED=false


# ------------------------------------------------------------------------------
# 18. BACKGROUND JOBS
# ------------------------------------------------------------------------------

WORKERS_ENABLED=false
SCHEDULER_ENABLED=false

JOB_QUEUE_PROVIDER=database
JOB_QUEUE_MAX_ATTEMPTS=5
JOB_QUEUE_RETRY_DELAY_MS=5000
JOB_QUEUE_CONCURRENCY=5
JOB_QUEUE_POLL_INTERVAL_MS=5000

SCHEDULE_EMAIL_DIGESTS=false
SCHEDULE_APPLICATION_REMINDERS=false
SCHEDULE_JOB_FEED_SYNC=false
SCHEDULE_CLEANUP_TASKS=false


# ------------------------------------------------------------------------------
# 19. SEARCH AND SEO
# ------------------------------------------------------------------------------

SEARCH_ENABLED=true
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
SEARCH_MIN_QUERY_LENGTH=2

SEO_ENABLED=true
SITEMAP_ENABLED=true
ROBOTS_TXT_ENABLED=true

EXTERNAL_SEARCH_ENABLED=false
# EXTERNAL_SEARCH_API_KEY=


# ------------------------------------------------------------------------------
# 20. HEALTH, METRICS, AND ERROR TRACKING
# ------------------------------------------------------------------------------

HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live

HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_REDIS=false
HEALTH_CHECK_EMAIL=false

METRICS_ENABLED=false
METRICS_PATH=/metrics
METRICS_REQUIRE_AUTH=true
DETAILED_HEALTH_REQUIRE_AUTH=true

ERROR_TRACKING_ENABLED=false
# ERROR_TRACKING_DSN=

TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=medorbits-api


# ------------------------------------------------------------------------------
# 21. API DOCUMENTATION AND PAGINATION
# ------------------------------------------------------------------------------

OPENAPI_ENABLED=true
OPENAPI_PATH=/docs
OPENAPI_PUBLIC=false

API_DEPRECATION_HEADERS_ENABLED=true
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100


# ------------------------------------------------------------------------------
# 22. OUTBOUND HTTP CLIENTS
# ------------------------------------------------------------------------------

EXTERNAL_API_TIMEOUT_MS=10000
EXTERNAL_API_MAX_RETRIES=2
EXTERNAL_API_RETRY_DELAY_MS=500

OUTBOUND_HTTP_ALLOW_PRIVATE_IPS=false
OUTBOUND_HTTP_FOLLOW_REDIRECTS=false


# ------------------------------------------------------------------------------
# 23. PRIVACY AND DATA RETENTION
# ------------------------------------------------------------------------------

PRIVACY_CONTACT_EMAIL=support@medorbits.in
DATA_EXPORT_ENABLED=true
ACCOUNT_DELETION_ENABLED=true
CONSENT_RECORDING_ENABLED=true

LOG_PERSONAL_DATA=false
STORE_IP_ADDRESSES=false
ANALYTICS_ENABLED=false
ANALYTICS_ANONYMIZE_IP=true

MARKETING_CONSENT_REQUIRED=true
COOKIE_CONSENT_ENABLED=true


# ------------------------------------------------------------------------------
# 24. DEVELOPMENT AND TESTING
# ------------------------------------------------------------------------------

DEBUG=false
ENABLE_TEST_ROUTES=false
ENABLE_DEMO_DATA=false
TEST_MODE=false

# Use an isolated database for automated tests.
# TEST_DATABASE_URL=
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_NAME=medorbits_test
# TEST_DB_USER=medorbits_test
# TEST_DB_PASSWORD=


# ------------------------------------------------------------------------------
# 25. FEATURE FLAGS
# ------------------------------------------------------------------------------

FEATURE_COURSES=true
FEATURE_COLLEGES=true
FEATURE_UNIVERSITIES=true
FEATURE_SCHOLARSHIPS=true
FEATURE_ADMISSIONS=true
FEATURE_CAREERS=true
FEATURE_RECRUITMENT=true
FEATURE_HOSTELS=true
FEATURE_NEWS=true
FEATURE_TESTIMONIALS=true
FEATURE_CONTACT_FORMS=true

FEATURE_SOCIAL_LOGIN=false
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_PUBLIC_PROFILES=false
FEATURE_NEWSLETTER=false


# ------------------------------------------------------------------------------
# 26. OPTIONAL OAUTH
# ------------------------------------------------------------------------------

OAUTH_ENABLED=false

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://www.medorbits.in/api/v1/auth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://www.medorbits.in/api/v1/auth/github/callback


# ------------------------------------------------------------------------------
# 27. BACKUP AND RECOVERY
# ------------------------------------------------------------------------------

BACKUP_ENABLED=false
BACKUP_ENCRYPTION_REQUIRED=true
BACKUP_RETENTION_DAYS=30

# BACKUP_STORAGE_PATH=
# BACKUP_STORAGE_ENDPOINT=
# BACKUP_STORAGE_BUCKET=
# BACKUP_STORAGE_ACCESS_KEY=
# BACKUP_STORAGE_SECRET_KEY=


# ------------------------------------------------------------------------------
# 28. DEPLOYMENT CHECKLIST
# ------------------------------------------------------------------------------

# Configure actual values in your hosting provider's secret settings.
#
# Production configuration should use:
#   NODE_ENV=production
#   APP_URL=https://www.medorbits.in
#   API_PUBLIC_URL=https://www.medorbits.in/api/v1
#   FRONTEND_URL=https://www.medorbits.in
#   COOKIE_SECURE=true
#
# Before deployment:
#   - Generate independent, strong session and JWT secrets.
#   - Use a least-privilege database account and appropriate TLS.
#   - Configure HTTPS, trusted proxy hops, and exact CORS origins.
#   - Disable test routes, debug output, and demo data.
#   - Configure backups, monitoring, and recovery procedures.
#   - Validate variables against the actual application configuration.
#   - Do not enable integrations whose adapters are not implemented.
#   - Verify health endpoints do not expose sensitive internal details.
#
# This file documents configuration; it does not implement any integration.
# Only variables read by the application have an effect.
#
# ==============================================================================
# END OF .env.example
# ==============================================================================