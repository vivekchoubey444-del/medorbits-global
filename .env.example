PAYMENT_METHOD_UPI_ENABLED=true
PAYMENT_METHOD_CARD_ENABLED=true
PAYMENT_METHOD_NETBANKING_ENABLED=true
PAYMENT_METHOD_WALLET_ENABLED=true
PAYMENT_METHOD_EMI_ENABLED=false
PAYMENT_METHOD_PAYLATER_ENABLED=false

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_ENABLED=false
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENVIRONMENT=sandbox

STRIPE_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYMENT_SUCCESS_URL=http://localhost:3000/account/payment-success.html
PAYMENT_FAILURE_URL=http://localhost:3000/account/payment-failure.html
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_IDEMPOTENCY_REQUIRED=true

Verify webhook signatures against the exact raw request body.

Verify amounts, currency, order ownership and payment state on the server.

Make payment processing idempotent and handle duplicate webhook delivery.

Never trust a browser redirect as proof of a successful payment.

Do not store card numbers or security codes in MedOrbits.

