
#!/usr/bin/env sh

# ==============================================================================
# MedOrbits / GHAR -- Pre-Commit Validation
# File: /.husky/pre-commit
# Version: 1.0.0
#
# Purpose:
#   Validate staged changes before Git commits them.
#
# Checks:
#   - Node.js availability
#   - package.json syntax
#   - JSON syntax
#   - Python syntax
#   - ESLint (when configured)
#   - Prettier (when configured)
#   - lint-staged (when configured)
#
# Security:
#   - No automatic dependency installation
#   - No automatic Git commits
#   - No deployment
#   - No database migrations
#   - Never prints environment variable values
#
# Exit:
#   0 = validation successful
#   1 = validation failed
# ==============================================================================

set -eu

PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

cd "$PROJECT_ROOT"

echo ""
echo "=================================================="
echo " MEDORBITS / GHAR -- PRE-COMMIT CHECK"
echo "=================================================="

# ----------------------------------------------------------------------
# Ensure there are staged changes
# ----------------------------------------------------------------------

if git diff --cached --quiet; then
    echo "No staged changes found."
    exit 0
fi

# ----------------------------------------------------------------------
# Runtime validation
# ----------------------------------------------------------------------

if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: Node.js is required for pre-commit validation."
    exit 1
fi

echo "Node.js: $(node --version)"

# ----------------------------------------------------------------------
# Run lint-staged when available
# ----------------------------------------------------------------------

if node -e "
const p = require('./package.json');
process.exit(
  p.devDependencies?.['lint-staged'] ||
  p.dependencies?.['lint-staged'] ? 0 : 1
)
" 2>/dev/null; then

    if [ ! -x node_modules/.bin/lint-staged ]; then
        echo "ERROR: lint-staged is configured but not installed."
        echo "Run npm ci before committing."
        exit 1
    fi

    echo "Running lint-staged..."
    npx --no-install lint-staged
else
    echo "INFO: lint-staged is not configured. Running basic checks."
fi

# ----------------------------------------------------------------------
# Validate staged JSON files
# ----------------------------------------------------------------------

echo ""
echo "Checking staged JSON files..."

git diff --cached --name-only --diff-filter=ACMR |
while IFS= read -r FILE; do
    case "$FILE" in
        *.json)
            if [ -f "$FILE" ]; then
                echo "Validating: $FILE"
                python3 -m json.tool "$FILE" > /dev/null || exit 1
            fi
            ;;
    esac
done

# ----------------------------------------------------------------------
# Validate staged Python files
# ----------------------------------------------------------------------

echo ""
echo "Checking staged Python files..."

git diff --cached --name-only --diff-filter=ACMR |
while IFS= read -r FILE; do
    case "$FILE" in
        *.py)
            if [ -f "$FILE" ]; then
                if command -v python3 >/dev/null 2>&1; then
                    echo "Validating: $FILE"
                    python3 -m py_compile "$FILE"
                else
                    echo "ERROR: Python 3 is required for Python validation."
                    exit 1
                fi
            fi
            ;;
    esac
done

# ----------------------------------------------------------------------
# Validate package.json
# ----------------------------------------------------------------------

if [ -f package.json ]; then
    echo ""
    echo "Checking package.json..."

    node -e "
      const fs = require('fs');
      const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'));

      if (!pkg || typeof pkg !== 'object' || Array.isArray(pkg)) {
        throw new Error('Invalid package.json structure');
      }

      console.log('package.json is valid.');
    "
fi

# ----------------------------------------------------------------------
# ESLint validation
# ----------------------------------------------------------------------

if [ -x node_modules/.bin/eslint ]; then
    echo ""
    echo "Running ESLint..."

    npx --no-install eslint .
else
    echo "INFO: ESLint not installed. Skipping."
fi

# ----------------------------------------------------------------------
# Prettier validation
# ----------------------------------------------------------------------

if [ -x node_modules/.bin/prettier ]; then
    echo ""
    echo "Checking formatting..."

    npx --no-install prettier --check .
else
    echo "INFO: Prettier not installed. Skipping."
fi

# ----------------------------------------------------------------------
# Reject accidentally staged environment files
# ----------------------------------------------------------------------

echo ""
echo "Checking staged sensitive files..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

for FILE in $STAGED_FILES; do
    case "$FILE" in
        .env|.env.*)
            case "$FILE" in
                .env.example|.env.sample|.env.template)
                    echo "Allowed environment template: $FILE"
                    ;;
                *)
                    echo "ERROR: Sensitive environment file staged: $FILE"
                    echo "Remove it using: git restore --staged \"$FILE\""
                    exit 1
                    ;;
            esac
            ;;
        *.pem|*.key)
            echo "ERROR: Potential private key staged: $FILE"
            exit 1
            ;;
    esac
done

# ----------------------------------------------------------------------
# Final result
# ----------------------------------------------------------------------

echo ""
echo "=================================================="
echo " PRE-COMMIT VALIDATION PASSED"
echo "=================================================="
echo "Repository checks completed successfully."
echo "Commit is permitted."
echo ""

exit 0
