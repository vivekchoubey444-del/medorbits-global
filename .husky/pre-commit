#!/usr/bin/env sh
# ============================================================
# MedOrbits -- Pre-Commit Quality Gate
# File: .husky/pre-commit
# Release: 2.0.0
#
# Runs available checks before committing.
# Does not install dependencies, stage files, or create commits.
# ============================================================
set -eu
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "[MedOrbits] ERROR: Not inside a Git repository." >&2
  exit 1
}
cd "$ROOT"
echo "[MedOrbits] Starting pre-commit checks..."
# ------------------------------------------------------------
# 1. Validate staged JSON files
# ------------------------------------------------------------
if command -v node >/dev/null 2>&1; then
  STAGED_JSON="$(git diff --cached --name-only --diff-filter=ACMR -- '*.json' || true)"
  if [ -n "$STAGED_JSON" ]; then
    printf '%s\n' "$STAGED_JSON" |
      while IFS= read -r file; do
        [ -f "$file" ] || continue
        if ! node -e \
          'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))' \
          "$file" >/dev/null 2>&1; then
          echo "[MedOrbits] ERROR: Invalid JSON: $file" >&2
          exit 1
        fi
      done
    echo "[MedOrbits] JSON validation passed."
  else
    echo "[MedOrbits] No staged JSON files to validate."
  fi
else
  echo "[MedOrbits] WARNING: Node.js unavailable; JSON validation skipped." >&2
fi
# ------------------------------------------------------------
# 2. Check staged JavaScript syntax
# ------------------------------------------------------------
if command -v node >/dev/null 2>&1; then
  STAGED_JS="$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.mjs' '*.cjs' || true)"
  if [ -n "$STAGED_JS" ]; then
    printf '%s\n' "$STAGED_JS" |
      while IFS= read -r file; do
        [ -f "$file" ] || continue
        if ! node --check "$file"; then
          echo "[MedOrbits] ERROR: JavaScript syntax check failed: $file" >&2
          exit 1
        fi
      done
    echo "[MedOrbits] JavaScript syntax validation passed."
  else
    echo "[MedOrbits] No staged JavaScript files to validate."
  fi
else
  echo "[MedOrbits] WARNING: Node.js unavailable; JavaScript validation skipped." >&2
fi
# ------------------------------------------------------------
# 3. Run configured npm quality scripts
# ------------------------------------------------------------
if [ -f package.json ] && command -v npm >/dev/null 2>&1; then
  if [ ! -d node_modules ]; then
    echo "[MedOrbits] WARNING: node_modules is missing; npm checks skipped." >&2
  else
    for script in lint check; do
      if node -e '
        const p = require("./package.json");
        process.exit(p.scripts && p.scripts[process.argv[1]] ? 0 : 1);
      ' "$script" >/dev/null 2>&1; then
        echo "[MedOrbits] Running npm run $script..."
        npm run "$script"
      else
        echo "[MedOrbits] No '$script' script configured; skipping."
      fi
    done
  fi
else
  echo "[MedOrbits] WARNING: npm or package.json unavailable; npm checks skipped." >&2
fi
echo "[MedOrbits] Pre-commit checks passed."
exit 0