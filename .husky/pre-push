#!/usr/bin/env sh
# MedOrbits pre-push validation hook
# Purpose: Protect pushes by running configured project quality checks.
#
# Standard mode:
#   Run ESLint when configured.
#
# Strict mode:
#   MEDORBITS_PREPUSH_FULL=1
#   Require tests; run configured formatting and build checks.
#
# Optional additional validation:
#   MEDORBITS_PREPUSH_JSON=1
#   Run "validate:json" when configured; otherwise fail.
#
# Exit codes:
#   0 = All applicable checks passed
#   1 = A required check failed or setup was invalid
set -eu
checks_run=0
checks_skipped=0
strict_mode=${MEDORBITS_PREPUSH_FULL:-0}
json_mode=${MEDORBITS_PREPUSH_JSON:-0}
printf '\n%s\n\n' "MedOrbits: Running pre-push validation..."
# --------------------------------------------------
# 1. Validate configuration flags
# --------------------------------------------------
case "$strict_mode" in
    0|1) ;;
    *)
        printf '%s\n' \
            "ERROR: MEDORBITS_PREPUSH_FULL must be 0 or 1." >&2
        exit 1
        ;;
esac
case "$json_mode" in
    0|1) ;;
    *)
        printf '%s\n' \
            "ERROR: MEDORBITS_PREPUSH_JSON must be 0 or 1." >&2
        exit 1
        ;;
esac
# --------------------------------------------------
# 2. Locate repository root
# --------------------------------------------------
if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    printf '%s\n' \
        "ERROR: Unable to determine the Git repository root." >&2
    exit 1
fi
if ! cd "$repo_root"; then
    printf '%s\n' \
        "ERROR: Unable to enter the repository root." >&2
    exit 1
fi
# --------------------------------------------------
# 3. Verify required files and tools
# --------------------------------------------------
if [ ! -f package.json ]; then
    printf '%s\n' \
        "ERROR: package.json was not found at the repository root." >&2
    exit 1
fi
if ! command -v node >/dev/null 2>&1; then
    printf '%s\n' \
        "ERROR: Node.js is required for pre-push validation." >&2
    exit 1
fi
if ! command -v npm >/dev/null 2>&1; then
    printf '%s\n' \
        "ERROR: npm is required for pre-push validation." >&2
    exit 1
fi
# --------------------------------------------------
# 4. Validate package.json structure
# --------------------------------------------------
printf '\n%s\n' "Validating package.json..."
if ! node -e '
    const fs = require("node:fs");
    try {
        const pkg = JSON.parse(
            fs.readFileSync("package.json", "utf8")
        );
        if (
            pkg === null ||
            typeof pkg !== "object" ||
            Array.isArray(pkg)
        ) {
            throw new Error("Expected a JSON object.");
        }
        if (
            pkg.scripts !== undefined &&
            (
                pkg.scripts === null ||
                typeof pkg.scripts !== "object" ||
                Array.isArray(pkg.scripts)
            )
        ) {
            throw new Error(
                "The scripts field must be an object when present."
            );
        }
    } catch (error) {
        console.error(
            "ERROR: Invalid package.json:",
            error.message
        );
        process.exit(1);
    }
'; then
    printf '%s\n' \
        "ERROR: Package configuration validation failed." >&2
    exit 1
fi
printf '%s\n' "PASS: package.json is valid."
# --------------------------------------------------
# 5. Detect configured npm scripts
#
# Return codes:
#   0 = Script exists and is non-empty
#   1 = Script is not configured
#   2 = package.json could not be inspected
# --------------------------------------------------
has_script() {
    node -e '
        const fs = require("node:fs");
        try {
            const pkg = JSON.parse(
                fs.readFileSync("package.json", "utf8")
            );
            const name = process.argv[1];
            const script = pkg.scripts?.[name];
            process.exit(
                typeof script === "string" && script.trim() !== ""
                    ? 0
                    : 1
            );
        } catch (error) {
            console.error(
                "ERROR: Unable to inspect package.json:",
                error.message
            );
            process.exit(2);
        }
    ' "$1"
}
# --------------------------------------------------
# 6. Run an npm script
#
# Arguments:
#   $1 = Human-readable check name
#   $2 = npm script name
#   $3 = 1 if required; otherwise 0
# --------------------------------------------------
run_check() {
    check_name=$1
    script_name=$2
    required=$3
    printf '\n%s\n' "----------------------------------------"
    printf 'CHECK: %s\n' "$check_name"
    printf 'SCRIPT: npm run %s\n' "$script_name"
    printf '%s\n' "----------------------------------------"
    if has_script "$script_name"; then
        :
    else
        script_status=$?
        if [ "$script_status" -gt 1 ]; then
            printf 'ERROR: Could not inspect script "%s".\n' \
                "$script_name" >&2
            exit 1
        fi
        if [ "$required" = "1" ]; then
            printf 'ERROR: Required npm script "%s" is missing.\n' \
                "$script_name" >&2
            printf '%s\n' \
                "Configure this script in package.json before pushing." >&2
            exit 1
        fi
        printf 'WARNING: Skipping %s.\n' "$check_name"
        printf 'Reason: script "%s" is not configured.\n' \
            "$script_name"
        checks_skipped=$((checks_skipped + 1))
        return 0
    fi
    if npm run "$script_name"; then
        checks_run=$((checks_run + 1))
        printf '\nPASS: %s\n' "$check_name"
    else
        printf '\nFAIL: %s\n' "$check_name" >&2
        printf '%s\n' \
            "Push blocked because the check failed." >&2
        exit 1
    fi
}
# --------------------------------------------------
# 7. Standard quality checks
# --------------------------------------------------
run_check "ESLint" "lint" 0
# --------------------------------------------------
# 8. Optional JSON validation
#
# Enable with:
#   MEDORBITS_PREPUSH_JSON=1
#
# When enabled, validate:json must exist.
# --------------------------------------------------
if [ "$json_mode" = "1" ]; then
    run_check "JSON validation" "validate:json" 1
else
    printf '\n%s\n' \
        "INFO: Dedicated JSON validation is disabled."
    printf '%s\n' \
        "INFO: Set MEDORBITS_PREPUSH_JSON=1 to require validate:json."
fi
# --------------------------------------------------
# 9. Strict validation mode
# --------------------------------------------------
if [ "$strict_mode" = "1" ]; then
    printf '\n%s\n' \
        "MedOrbits strict validation mode is enabled."
    # Tests are mandatory in strict mode.
    run_check "Automated tests" "test" 1
    # Formatting and build checks run when configured.
    run_check \
        "Prettier formatting validation" \
        "format:check" \
        0
    run_check "Production build" "build" 0
else
    checks_skipped=$((checks_skipped + 3))
    printf '\n%s\n' \
        "INFO: Strict validation mode is disabled."
    printf '%s\n' \
        "INFO: Tests, formatting validation, and build are not being run."
    printf '%s\n' \
        "INFO: Set MEDORBITS_PREPUSH_FULL=1 to enable strict mode."
fi
# --------------------------------------------------
# 10. Final report
# --------------------------------------------------
printf '\n%s\n' "========================================"
printf '%s\n' "MedOrbits: Pre-push validation passed."
printf 'Checks passed:  %s\n' "$checks_run"
printf 'Checks skipped: %s\n' "$checks_skipped"
printf 'Strict mode:    %s\n' "$strict_mode"
printf 'JSON validation: %s\n' "$json_mode"
printf '%s\n\n' "========================================"
exit 0