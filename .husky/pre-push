
#!/usr/bin/env sh
# ============================================================
# MedOrbits -- Pre-Push Safety Gate
# File: .husky/pre-push
# Release: 2.1.0
#
# Purpose:
#   Validate repository state, tracked JSON, JavaScript syntax,
#   configured tests, and optional project verification scripts.
#
# Safety:
#   - Does not install dependencies.
#   - Does not modify source files.
#   - Does not commit or push.
#   - Blocks a push when a required check fails.
# ============================================================

set -eu

log() {
  printf '%s\n' "[MedOrbits] $*"
}

error() {
  printf '%s\n' "[MedOrbits] ERROR: $*" >&2
}

warning() {
  printf '%s\n' "[MedOrbits] WARNING: $*" >&2
}

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  error "Not inside a Git repository."
  exit 1
}

cd "$ROOT"

log "Running pre-push checks..."

# ------------------------------------------------------------
# 1. Require a valid repository HEAD
# ------------------------------------------------------------

if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  error "No valid HEAD commit exists."
  exit 1
fi

log "Repository HEAD is valid."

# ------------------------------------------------------------
# 2. Block unresolved index conflicts
# ------------------------------------------------------------

if ! git diff --name-only --diff-filter=U > /dev/null 2>&1; then
  error "Unable to inspect the Git index."
  exit 1
fi

UNRESOLVED="$(git diff --name-only --diff-filter=U)" || {
  error "Unable to inspect unresolved conflicts."
  exit 1
}

if [ -n "$UNRESOLVED" ]; then
  error "Unresolved merge conflicts exist:"
  printf '%s\n' "$UNRESOLVED" >&2
  exit 1
fi

log "No unresolved index conflicts."

# ------------------------------------------------------------
# 3. Validate tracked JSON files
# ------------------------------------------------------------

if command -v node >/dev/null 2>&1; then
  JSON_COUNT=0

  # Git paths are newline-delimited here. Repository filenames
  # should not contain newline characters for this check to work
  # reliably; see the note below.
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    [ -f "$file" ] || continue

    JSON_COUNT=$((JSON_COUNT + 1))

    if ! node -e '
      const fs = require("node:fs");
      JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    ' "$file" >/dev/null 2>&1; then
      error "Invalid JSON: $file"
      exit 1
    fi
  done <<EOF
$(git ls-files -- '*.json' '*.schema.json' '*.shema.json')
EOF

  if [ "$JSON_COUNT" -gt 0 ]; then
    log "JSON validation passed ($JSON_COUNT files)."
  else
    log "No tracked JSON files found."
  fi
else
  warning "Node.js unavailable; JSON validation skipped."
fi

# ------------------------------------------------------------
# 4. Check tracked JavaScript syntax
# ------------------------------------------------------------

if command -v node >/dev/null 2>&1; then
  JS_COUNT=0

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    [ -f "$file" ] || continue

    JS_COUNT=$((JS_COUNT + 1))

    if ! node --check "$file"; then
      error "JavaScript syntax check failed: $file"
      exit 1
    fi
  done <<EOF
$(git ls-files -- '*.js' '*.mjs' '*.cjs')
EOF

  if [ "$JS_COUNT" -gt 0 ]; then
    log "JavaScript syntax validation passed ($JS_COUNT files)."
  else
    log "No tracked JavaScript files found."
  fi
else
  warning "Node.js unavailable; JavaScript syntax validation skipped."
fi

# ------------------------------------------------------------
# 5. Run configured tests, when available
# ------------------------------------------------------------

if [ -f package.json ] && command -v npm >/dev/null 2>&1; then
  if [ ! -d node_modules ]; then
    warning "node_modules is missing; npm tests skipped."
  elif node -e '
    const fs = require("node:fs");
    const p = JSON.parse(fs.readFileSync("package.json", "utf8"));
    process.exit(p.scripts && p.scripts.test ? 0 : 1);
  ' >/dev/null 2>&1; then
    log "Running npm test..."
    npm test
    log "npm test passed."
  else
    log "No npm test script configured; skipping."
  fi
else
  warning "npm or package.json unavailable; tests skipped."
fi

# ------------------------------------------------------------
# 6. Run optional project verification scripts
# ------------------------------------------------------------

for script in VERIFY.sh TEST.sh; do
  if [ -f "$script" ]; then
    log "Running $script..."

    if ! bash "$script"; then
      error "$script failed."
      exit 1
    fi

    log "$script passed."
  else
    log "$script not found; skipping."
  fi
done

# ------------------------------------------------------------
# 7. Complete
# ------------------------------------------------------------

log "All enabled pre-push checks passed."
exit 0
