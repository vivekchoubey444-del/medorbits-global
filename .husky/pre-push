
#!/usr/bin/env sh
# MedOrbits pre-push validation hook
# Purpose: Validate code quality and optionally require automated tests.

set -eu

echo ""
echo "MedOrbits: Running pre-push checks..."
echo ""

# --------------------------------------------------
# 1. Locate repository root
# --------------------------------------------------
if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo "ERROR: Unable to determine the Git repository root." >&2
    exit 1
fi

cd "$repo_root"

# --------------------------------------------------
# 2. Verify project configuration and tools
# --------------------------------------------------
if [ ! -f package.json ]; then
    echo "ERROR: package.json was not found at the repository root." >&2
    exit 1
fi

if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: Node.js is required for pre-push validation." >&2
    exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
    echo "ERROR: npm is required for pre-push validation." >&2
    exit 1
fi

# --------------------------------------------------
# 3. Detect configured npm scripts
# Return codes:
#   0 = script exists
#   1 = script is not configured
#   2 = package.json could not be inspected
# --------------------------------------------------
has_script() {
    node -e '
        const fs = require("node:fs");

        try {
            const pkg = JSON.parse(
                fs.readFileSync("package.json", "utf8")
            );

            const name = process.argv[1];

            process.exit(
                pkg.scripts &&
                typeof pkg.scripts[name] === "string" &&
                pkg.scripts[name].trim() !== ""
                    ? 0
                    : 1
            );
        } catch (error) {
            console.error(
                "ERROR: Unable to inspect package.json:",
                error.message
            );
            process.exit(2);
        }
    ' "$1"
}

# --------------------------------------------------
# 4. Run a configured npm script
# --------------------------------------------------
run_check() {
    check_name=$1
    script_name=$2
    required=$3

    echo ""
    echo "----------------------------------------"
    echo "Checking $check_name..."
    echo "----------------------------------------"

    if has_script "$script_name"; then
        :
    else
        script_status=$?

        if [ "$script_status" -gt 1 ]; then
            echo "ERROR: Unable to inspect npm script '$script_name'." >&2
            exit 1
        fi

        if [ "$required" = "1" ]; then
            echo "ERROR: Required npm script '$script_name' is missing." >&2
            echo "Configure it in package.json before pushing." >&2
            exit 1
        fi

        echo "WARNING: Skipping $check_name; '$script_name' is not configured."
        return 0
    fi

    echo "Running $check_name..."

    if npm run "$script_name"; then
        echo "PASS: $check_name"
    else
        echo "FAIL: $check_name" >&2
        echo "Push blocked because the check failed." >&2
        exit 1
    fi
}

# --------------------------------------------------
# 5. Run ESLint when configured
# --------------------------------------------------
run_check "ESLint" "lint" 0

# --------------------------------------------------
# 6. Optional strict validation
# --------------------------------------------------
if [ "${MEDORBITS_PREPUSH_FULL:-0}" = "1" ]; then
    echo ""
    echo "MedOrbits strict pre-push mode enabled."

    # Tests are mandatory in strict mode.
    run_check "automated tests" "test" 1

    # Run formatting validation if configured.
    run_check "Prettier formatting validation" "format:check" 0

    # Run build validation if configured.
    run_check "production build" "build" 0
else
    echo ""
    echo "INFO: Strict pre-push mode is disabled."
    echo "INFO: Automated tests and build checks were not required."
    echo "INFO: Set MEDORBITS_PREPUSH_FULL=1 to enable strict mode."
fi

# --------------------------------------------------
# 7. Report success
# --------------------------------------------------
echo ""
echo "========================================"
echo "MedOrbits: Pre-push checks passed."
echo "========================================"
echo ""

exit 0
