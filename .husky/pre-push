#!/usr/bin/env sh
# ============================================================
# MedOrbits -- Pre-Push Safety Gate
# File: .husky/pre-push
# Release: 2.0.0
#
# Runs read-only checks before a Git push.
# Does not install dependencies, modify files, commit, or push.
# ============================================================
set -eu
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "[MedOrbits] ERROR: Not inside a Git repository." >&2
  exit 1
}
cd "$ROOT"
echo "[MedOrbits] Running pre-push checks..."
# ------------------------------------------------------------
# 1. Require a valid repository HEAD
# ------------------------------------------------------------
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  echo "[MedOrbits] ERROR: No valid HEAD commit exists." >&2
  exit 1
fi
echo "[MedOrbits] Repository HEAD is valid."
# ------------------------------------------------------------
# 2. Block pushes while the Git index has unresolved conflicts
# ------------------------------------------------------------
if git diff --name-only --diff-filter=U 2>/dev/null | grep -q .; then
  echo "[MedOrbits] ERROR: Unresolved merge conflicts exist." >&2
  git diff --name-only --diff-filter=U >&2 || true
  exit 1
fi
echo "[MedOrbits] No unresolved index conflicts."
# ------------------------------------------------------------
# 3. Validate tracked JSON files
# ------------------------------------------------------------
if command -v node >/dev/null 2>&1; then
  JSON_FILES="$(git ls-files '*.json' '*.schema.json' '*.shema.json')"
  if [ -n "$JSON_FILES" ]; then
    printf '%s\n' "$JSON_FILES" |
      while IFS= read -r file; do
        [ -f "$file" ] || continue
        if ! node -e \
          'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))' \
          "$file" >/dev/null 2>&1; then
          echo "[MedOrbits] ERROR: Invalid JSON: $file" >&2
          exit 1
        fi
      done
    echo "[MedOrbits] JSON validation passed."
  else
    echo "[MedOrbits] No tracked JSON files found."
  fi
else
  echo "[MedOrbits] WARNING: Node.js unavailable; JSON validation skipped." >&2
fi
# ------------------------------------------------------------
# 4. Check tracked JavaScript syntax
# ------------------------------------------------------------
if command -v node >/dev/null 2>&1; then
  JS_FILES="$(git ls-files '*.js' '*.mjs' '*.cjs')"
  if [ -n "$JS_FILES" ]; then
    printf '%s\n' "$JS_FILES" |
      while IFS= read -r file; do
        [ -f "$file" ] || continue
        if ! node --check "$file"; then
          echo "[MedOrbits] ERROR: JavaScript syntax check failed: $file" >&2
          exit 1
        fi
      done
    echo "[MedOrbits] JavaScript syntax validation passed."
  else
    echo "[MedOrbits] No tracked JavaScript files found."
  fi
else
  echo "[MedOrbits] WARNING: Node.js unavailable; JavaScript validation skipped." >&2
fi
# ------------------------------------------------------------
# 5. Run configured tests, when available
# ------------------------------------------------------------
if [ -f package.json ] && command -v npm >/dev/null 2>&1; then
  if [ ! -d node_modules ]; then
    echo "[MedOrbits] WARNING: node_modules is missing; npm tests skipped." >&2
  elif node -e '
    const p = require("./package.json");
    process.exit(p.scripts && p.scripts.test ? 0 : 1);
  ' >/dev/null 2>&1; then
    echo "[MedOrbits] Running npm test..."
    npm test
  else
    echo "[MedOrbits] No npm test script configured; skipping."
  fi
else
  echo "[MedOrbits] WARNING: npm or package.json unavailable; tests skipped." >&2
fi
# ------------------------------------------------------------
# 6. Optional project verification scripts
# ------------------------------------------------------------
for script in VERIFY.sh TEST.sh; do
  if [ -f "$script" ]; then
    echo "[MedOrbits] Running $script..."
    if ! bash "$script"; then
      echo "[MedOrbits] ERROR: $script failed." >&2
      exit 1
    fi
  else
    echo "[MedOrbits] $script not found; skipping."
  fi
done
echo "[MedOrbits] Pre-push checks passed."
exit 0