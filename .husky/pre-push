
#!/usr/bin/env sh

# ==============================================================================
# MedOrbits / GHAR -- Pre-Push Validation
# File: /.husky/pre-push
# Version: 1.0.0
#
# Purpose:
#   Run quality and security checks before Git push.
#
# Checks:
#   - Git repository integrity
#   - Node.js and npm availability
#   - package.json validity
#   - package-lock.json consistency
#   - Dependency installation integrity
#   - Automated tests
#   - ESLint
#   - Prettier
#   - Production build
#   - Python compilation
#   - Secret and sensitive-file checks
#
# Safety:
#   - No automatic dependency upgrades
#   - No automatic Git push
#   - No deployment
#   - No database migrations
#   - No destructive Git operations
#
# Exit:
#   0 = Push permitted
#   1 = Push blocked
# ==============================================================================

set -eu

PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "ERROR: Not inside a Git repository."
    exit 1
}

cd "$PROJECT_ROOT"

echo ""
echo "=================================================="
echo " MEDORBITS / GHAR -- PRE-PUSH VALIDATION"
echo "=================================================="

# ----------------------------------------------------------------------
# Helper
# ----------------------------------------------------------------------

run_check() {
    LABEL="$1"
    shift

    echo ""
    echo "CHECK: $LABEL"

    if "$@"; then
        echo "PASS: $LABEL"
    else
        echo "FAIL: $LABEL"
        echo "Push blocked."
        exit 1
    fi
}

# ----------------------------------------------------------------------
# Git integrity
# ----------------------------------------------------------------------

run_check "Git repository integrity" git fsck --no-reflogs

# ----------------------------------------------------------------------
# Runtime checks
# ----------------------------------------------------------------------

command -v node >/dev/null 2>&1 || {
    echo "ERROR: Node.js is required."
    exit 1
}

command -v npm >/dev/null 2>&1 || {
    echo "ERROR: npm is required."
    exit 1
}

echo "Node.js: $(node --version)"
echo "npm: $(npm --version)"

# ----------------------------------------------------------------------
# Package manifest validation
# ----------------------------------------------------------------------

if [ -f package.json ]; then
    run_check "package.json syntax" \
        node -e "JSON.parse(require('fs').readFileSync('package.json','utf8'))"
else
    echo "INFO: No root package.json found."
fi

# ----------------------------------------------------------------------
# Lockfile validation
# ----------------------------------------------------------------------

if [ -f package.json ] && [ -f package-lock.json ]; then
    run_check "npm lockfile consistency" \
        npm install --package-lock-only --ignore-scripts --no-audit --no-fund
else
    echo "WARNING: package.json or package-lock.json is missing."
fi

# ----------------------------------------------------------------------
# Dependency integrity
# ----------------------------------------------------------------------

if [ -f package-lock.json ]; then
    run_check "npm dependency installation" \
        npm ci --ignore-scripts --no-audit --no-fund
fi

# ----------------------------------------------------------------------
# Test suite
# ----------------------------------------------------------------------

if [ -f package.json ]; then
    if node -e "
      const p = require('./package.json');
      process.exit(p.scripts?.test ? 0 : 1);
    "; then
        run_check "Automated tests" npm test
    else
        echo "WARNING: No test script configured."
    fi
fi

# ----------------------------------------------------------------------
# ESLint
# ----------------------------------------------------------------------

if [ -x node_modules/.bin/eslint ]; then
    run_check "ESLint" npx --no-install eslint .
else
    echo "INFO: ESLint unavailable; skipping."
fi

# ----------------------------------------------------------------------
# Prettier
# ----------------------------------------------------------------------

if [ -x node_modules/.bin/prettier ]; then
    run_check "Prettier formatting" \
        npx --no-install prettier --check .
else
    echo "INFO: Prettier unavailable; skipping."
fi

# ----------------------------------------------------------------------
# Production build
# ----------------------------------------------------------------------

if [ -f package.json ]; then
    if node -e "
      const p = require('./package.json');
      process.exit(p.scripts?.build ? 0 : 1);
    "; then
        run_check "Production build" npm run build
    else
        echo "INFO: No build script configured."
    fi
fi

# ----------------------------------------------------------------------
# Python syntax validation
# ----------------------------------------------------------------------

if command -v python3 >/dev/null 2>&1; then
    echo ""
    echo "CHECK: Python syntax"

    python3 - <<'PY'
import ast
import subprocess
import sys

files = subprocess.run(
    ["git", "ls-files", "-m", "-o", "--exclude-standard"],
    capture_output=True,
    text=True,
    check=True
).stdout.splitlines()

python_files = [
    file for file in files
    if file.endswith(".py")
]

errors = []

for file in python_files:
    try:
        with open(file, "r", encoding="utf-8") as source:
            ast.parse(source.read(), filename=file)
        print(f"PASS: {file}")
    except (OSError, UnicodeError, SyntaxError) as exc:
        errors.append(f"{file}: {exc}")

if errors:
    for error in errors:
        print(f"FAIL: {error}")
    sys.exit(1)

print(f"Validated {len(python_files)} Python files.")
PY

else
    echo "INFO: Python 3 unavailable; skipping."
fi

# ----------------------------------------------------------------------
# Sensitive-file validation
# ----------------------------------------------------------------------

echo ""
echo "CHECK: Sensitive files"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

for FILE in $STAGED_FILES; do
    case "$FILE" in
        .env|.env.*)
            case "$FILE" in
                .env.example|.env.sample|.env.template)
                    ;;
                *)
                    echo "ERROR: Sensitive environment file: $FILE"
                    exit 1
                    ;;
            esac
            ;;
        *.pem|*.key)
            echo "ERROR: Potential private key: $FILE"
            exit 1
            ;;
    esac
done

echo "PASS: Sensitive filename check"

# ----------------------------------------------------------------------
# Final report
# ----------------------------------------------------------------------

echo ""
echo "=================================================="
echo " PRE-PUSH VALIDATION PASSED"
echo "=================================================="
echo "Repository: $PROJECT_ROOT"
echo "Branch: $(git branch --show-current)"
echo "Commit: $(git rev-parse --short HEAD)"
echo ""
echo "All configured checks completed."
echo "Git push is permitted."
echo ""

exit 0
