
#!/usr/bin/env sh
# ==============================================================================
# MedOrbits -- Enterprise Pre-Push Safety Gate
# File: .husky/pre-push
# Version: 2.2.0
#
# Checks:
#   - Git repository and HEAD integrity
#   - Unresolved merge conflicts
#   - Tracked JSON and JSON Schema syntax
#   - Tracked JavaScript syntax
#   - Lockfile-aware configured test script
#   - Optional VERIFY.sh and TEST.sh scripts
#
# Safety:
#   - Does not install dependencies or change source files.
#   - Does not create commits or push.
#   - Blocks the push when an enabled required check fails.
#   - Uses NUL-delimited Git filenames.
# ==============================================================================

set -eu

log() {
  printf '%s\n' "[MedOrbits] $*"
}

warning() {
  printf '%s\n' "[MedOrbits] WARNING: $*" >&2
}

error() {
  printf '%s\n' "[MedOrbits] ERROR: $*" >&2
}

die() {
  error "$*"
  exit 1
}

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" ||
  die "Not inside a Git repository."

cd "$ROOT" || die "Cannot enter repository root."

log "Running pre-push checks..."
log "Repository: $ROOT"

# ------------------------------------------------------------------------------
# 1. Validate Git repository state
# ------------------------------------------------------------------------------

git rev-parse --verify HEAD >/dev/null 2>&1 ||
  die "No valid HEAD commit exists."

log "Repository HEAD is valid."

UNRESOLVED="$(git diff --name-only --diff-filter=U)" ||
  die "Unable to inspect unresolved conflicts."

if [ -n "$UNRESOLVED" ]; then
  error "Unresolved working-tree/index conflicts exist:"
  printf '%s\n' "$UNRESOLVED" >&2
  exit 1
fi

INDEX_CONFLICTS="$(git ls-files -u)" ||
  die "Unable to inspect Git index."

if [ -n "$INDEX_CONFLICTS" ]; then
  die "Unresolved Git index conflicts exist."
fi

log "No unresolved Git conflicts."

# ------------------------------------------------------------------------------
# 2. Detect available runtime tools
# ------------------------------------------------------------------------------

NODE_AVAILABLE=0
if command -v node >/dev/null 2>&1; then
  NODE_AVAILABLE=1
  NODE_VERSION="$(node -p 'process.versions.node' 2>/dev/null)" ||
    die "Unable to determine Node.js version."
  log "Node.js: $NODE_VERSION"
else
  warning "Node.js unavailable; JSON and JavaScript checks cannot run."
fi

# ------------------------------------------------------------------------------
# 3. Validate tracked JSON files
# ------------------------------------------------------------------------------

if [ "$NODE_AVAILABLE" -eq 1 ]; then
  JSON_COUNT=0

  # NUL delimiters safely handle spaces, tabs, and newlines in filenames.
  # Process substitution is deliberately avoided because this script
  # targets POSIX sh, not Bash.
  JSON_LIST="$(mktemp "${TMPDIR:-/tmp}/medorbits-json.XXXXXX")" ||
    die "Unable to create JSON file list."

  trap 'rm -f "$JSON_LIST" "$JS_LIST"' 0
  trap 'exit 130' INT
  trap 'exit 143' TERM

  git ls-files -z -- '*.json' '*.schema.json' '*.shema.json' > "$JSON_LIST" ||
    die "Unable to enumerate tracked JSON files."

  # Read NUL-delimited filenames with a tiny Node helper. This avoids
  # newline-based shell parsing of Git filenames.
  while IFS= read -r -d '' file; do
    :
  done </dev/null 2>/dev/null || true

  node - "$JSON_LIST" <<'NODE'
'use strict';

const fs = require('node:fs');
const cp = require('node:child_process');

const listFile = process.argv[2];
const paths = fs.readFileSync(listFile).toString('utf8').split('\0').filter(Boolean);

for (const file of paths) {
  if (!fs.existsSync(file) || !fs.statSync(file).isFile()) continue;

  try {
    JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch (error) {
    console.error(`[MedOrbits] ERROR: Invalid JSON: ${file}`);
    console.error(`  ${error.message}`);
    process.exitCode = 1;
  }
}
NODE

  # Count existing tracked JSON files for reporting.
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    [ -f "$file" ] || continue
    JSON_COUNT=$((JSON_COUNT + 1))
  done <<EOF
$(git ls-files -- '*.json' '*.schema.json' '*.shema.json')
EOF

  # NUL-based validation above is authoritative. This count is informational.
  log "Tracked JSON validation completed ($JSON_COUNT listed files)."
fi

# ------------------------------------------------------------------------------
# 4. Validate tracked JavaScript syntax
# ------------------------------------------------------------------------------

if [ "$NODE_AVAILABLE" -eq 1 ]; then
  JS_LIST="$(mktemp "${TMPDIR:-/tmp}/medorbits-js.XXXXXX")" ||
    die "Unable to create JavaScript file list."

  git ls-files -z -- '*.js' '*.mjs' '*.cjs' > "$JS_LIST" ||
    die "Unable to enumerate tracked JavaScript files."

  node - "$JS_LIST" <<'NODE'
'use strict';

const fs = require('node:fs');
const cp = require('node:child_process');

const listFile = process.argv[2];
const paths = fs.readFileSync(listFile).toString('utf8').split('\0').filter(Boolean);

for (const file of paths) {
  if (!fs.existsSync(file) || !fs.statSync(file).isFile()) continue;

  const result = cp.spawnSync(process.execPath, ['--check', file], {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe']
  });

  if (result.error || result.status !== 0) {
    console.error(`[MedOrbits] ERROR: JavaScript syntax check failed: ${file}`);
    const detail = (result.stderr || result.stdout || '').trim();
    if (detail) console.error(detail);
    process.exitCode = 1;
  }
}
NODE

  log "Tracked JavaScript syntax validation completed."
fi

# ------------------------------------------------------------------------------
# 5. Run configured tests with detected lockfile
# ------------------------------------------------------------------------------

if [ -f package.json ] && [ "$NODE_AVAILABLE" -eq 1 ]; then
  HAS_TEST_SCRIPT=0

  if node -e '
    const fs = require("node:fs");
    const p = JSON.parse(fs.readFileSync("package.json", "utf8"));
    process.exit(typeof p.scripts?.test === "string" && p.scripts.test.trim() ? 0 : 1);
  ' >/dev/null 2>&1; then
    HAS_TEST_SCRIPT=1
  fi

  if [ "$HAS_TEST_SCRIPT" -eq 1 ]; then
    if [ -d node_modules ]; then
      if [ -f pnpm-lock.yaml ] && command -v pnpm >/dev/null 2>&1; then
        log "Running pnpm test..."
        pnpm run test
      elif [ -f yarn.lock ] && command -v yarn >/dev/null 2>&1; then
        log "Running Yarn test..."
        yarn run test
      elif { [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; } &&
           command -v npm >/dev/null 2>&1; then
        log "Running npm test..."
        npm test
      elif { [ -f bun.lock ] || [ -f bun.lockb ]; } &&
           command -v bun >/dev/null 2>&1; then
        log "Running Bun test..."
        bun run test
      else
        warning "Could not safely identify the package manager; tests skipped."
      fi

      log "Configured package tests completed."
    else
      warning "node_modules is missing; configured package tests skipped."
    fi
  else
    log "No package.json test script configured."
  fi
fi

# ------------------------------------------------------------------------------
# 6. Optional project verification scripts
# ------------------------------------------------------------------------------

for script in VERIFY.sh TEST.sh; do
  if [ -f "$script" ]; then
    log "Running $script..."
    bash "$script" || die "$script failed."
    log "$script passed."
  fi
done

# ------------------------------------------------------------------------------
# 7. Complete
# ------------------------------------------------------------------------------

log "All enabled pre-push checks passed."
exit 0
