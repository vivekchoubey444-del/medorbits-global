
#!/usr/bin/env sh
# ============================================================
# MedOrbits -- Commit Message Validation
# File: .husky/commit-msg
# Release: 2.1.0
#
# Enforces Conventional Commits subject format.
# Does not modify the commit message or repository.
# ============================================================

set -eu

log() {
  printf '%s\n' "[MedOrbits] $*"
}

error() {
  printf '%s\n' "[MedOrbits] ERROR: $*" >&2
}

COMMIT_MSG_FILE="${1:-}"

if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
  error "Commit message file was not provided or does not exist."
  exit 1
fi

# ------------------------------------------------------------
# 1. Extract the first non-comment, non-empty line
# ------------------------------------------------------------

SUBJECT="$(
  awk '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    {
      sub(/\r$/, "")
      print
      exit
    }
  ' "$COMMIT_MSG_FILE"
)"

if [ -z "$SUBJECT" ]; then
  error "Commit message cannot be empty."
  exit 1
fi

# ------------------------------------------------------------
# 2. Validate Conventional Commits format
#
# Accepted:
#   feat: add course search
#   fix(api): handle missing application
#   docs: update support guide
#   chore(deps): update dependencies
#   feat!: change public API
#   feat(api)!: change API response
#
# Subject requirements:
#   - Allowed type
#   - Optional scope
#   - Optional breaking-change marker
#   - Colon followed by one space
#   - Description of 1-100 characters
# ------------------------------------------------------------

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?(!)?: .{1,100}$'

if ! printf '%s\n' "$SUBJECT" | grep -Eq "$PATTERN"; then
  error "Invalid commit message subject."
  printf '\n' >&2
  printf '%s\n' \
    "Use Conventional Commits:" \
    "  type(scope): short description" \
    "" \
    "Allowed types:" \
    "  feat, fix, docs, style, refactor, perf," \
    "  test, build, ci, chore, revert" \
    "" \
    "Examples:" \
    "  feat(admissions): add course search" \
    "  fix(api): handle missing application" \
    "  docs: update support guide" \
    "  chore(deps): update dependencies" \
    "  feat!: change public API" \
    "  feat(api)!: change API response" >&2
  exit 1
fi

log "Commit message validated."
exit 0
