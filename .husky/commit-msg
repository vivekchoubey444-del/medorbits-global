
#!/usr/bin/env sh

# ==============================================================================
# MedOrbits / GHAR -- Commit Message Validation
# File: /.husky/commit-msg
# Version: 1.0.0
#
# Purpose:
#   Enforce Conventional Commits specification.
#
# Accepted examples:
#   feat: add student dashboard
#   fix(auth): resolve login validation error
#   docs: update installation guide
#   refactor(api): simplify request handling
#   chore(deps): update dependencies
#
# Security:
#   - Reject empty commit messages.
#   - Reject malformed commit headers.
#   - Reject excessively long headers.
#   - Preserve Git-generated merge and revert commits.
# ==============================================================================

set -eu

COMMIT_MSG_FILE="${1:-}"

if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
    echo "ERROR: Commit message file not found."
    exit 1
fi

# Read the first non-comment, non-empty line.
HEADER=$(
    sed '/^[[:space:]]*#/d' "$COMMIT_MSG_FILE" |
    sed '/^[[:space:]]*$/d' |
    head -n 1
)

if [ -z "$HEADER" ]; then
    echo ""
    echo "ERROR: Commit message cannot be empty."
    exit 1
fi

# Allow standard Git-generated merge commits.
case "$HEADER" in
    "Merge "*)
        exit 0
        ;;
    "Revert "*)
        exit 0
        ;;
esac

# Enforce maximum header length.
HEADER_LENGTH=${#HEADER}

if [ "$HEADER_LENGTH" -gt 100 ]; then
    echo ""
    echo "ERROR: Commit header exceeds 100 characters."
    echo "Current length: $HEADER_LENGTH"
    exit 1
fi

# Conventional Commit header validation.
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|security)(\([a-z0-9._/-]+\))?(!)?: .{1,72}$'

if ! printf '%s\n' "$HEADER" | grep -Eq "$PATTERN"; then
    echo ""
    echo "=================================================="
    echo "INVALID COMMIT MESSAGE"
    echo "=================================================="
    echo ""
    echo "Expected format:"
    echo "type(scope): description"
    echo ""
    echo "Accepted types:"
    echo "feat, fix, docs, style, refactor, perf,"
    echo "test, build, ci, chore, revert, security"
    echo ""
    echo "Examples:"
    echo "feat: add admission application form"
    echo "fix(auth): resolve authentication issue"
    echo "docs: update README"
    echo "security(api): improve upload validation"
    echo "chore(deps): update npm dependencies"
    echo ""
    echo "=================================================="

    exit 1
fi

echo "Commit message validation passed."
