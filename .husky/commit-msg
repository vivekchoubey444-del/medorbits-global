
#!/usr/bin/env sh
# ==============================================================================
# MedOrbits -- Commit Message Validator
#
# File: .github/scripts/validate-commit-message.sh
#
# Purpose:
#   Validate the first non-empty, non-comment commit subject against the
#   Conventional Commits format.
#
# Supported formats:
#   type(scope): description
#   type: description
#   type(scope)!: description
#   type!: description
#
# Supported types:
#   feat, fix, docs, style, refactor, perf, test, build,
#   ci, chore, revert
#
# Scope characters:
#   Letters, numbers, dots, underscores, slashes and hyphens.
#
# Requirements:
#   - POSIX-compatible shell and standard Unix utilities.
#   - Subject length defaults to 100 characters.
#   - MAX_SUBJECT_LENGTH overrides the default maximum.
#   - VERBOSE=1 enables additional validation details.
#   - CRLF input is supported.
#
# Usage:
#   .github/scripts/validate-commit-message.sh <commit-message-file>
#   .github/scripts/validate-commit-message.sh --help
#
# Exit codes:
#   0  Validation successful
#   1  Invalid commit message or validation failure
#   2  Invalid arguments, configuration, or input file
#
# Note:
#   This script validates the subject only. It does not validate commit bodies,
#   footers, issue references, or the breaking-change footer specification.
# ==============================================================================

set -eu

PROGRAM_NAME=${0##*/}
DEFAULT_MAX_LENGTH=100
MAX_SUBJECT_LENGTH=${MAX_SUBJECT_LENGTH:-$DEFAULT_MAX_LENGTH}
VERBOSE=${VERBOSE:-0}

# ------------------------------------------------------------------------------
# Output helpers
# ------------------------------------------------------------------------------

info() {
    printf '%s\n' "$*"
}

error() {
    printf 'ERROR: %s\n' "$*" >&2
}

usage() {
    cat <<EOF
MedOrbits Commit Message Validator

Usage:
  $PROGRAM_NAME <commit-message-file>
  $PROGRAM_NAME --help
  $PROGRAM_NAME --version

Environment variables:
  MAX_SUBJECT_LENGTH  Maximum subject length (default: 100)
  VERBOSE             Set to 1 for additional validation details

Examples:
  $PROGRAM_NAME .git/COMMIT_EDITMSG
  MAX_SUBJECT_LENGTH=120 $PROGRAM_NAME .git/COMMIT_EDITMSG
  VERBOSE=1 $PROGRAM_NAME .git/COMMIT_EDITMSG
EOF
}

fail() {
    error "$1"
    exit "${2:-1}"
}

# ------------------------------------------------------------------------------
# 1. Parse arguments
# ------------------------------------------------------------------------------

if [ "$#" -gt 1 ]; then
    fail "Exactly one commit message file must be provided. Use --help for usage." 2
fi

case "${1:-}" in
    --help|-h)
        usage
        exit 0
        ;;
    --version|-V)
        info "MedOrbits Commit Message Validator 2.1.0"
        exit 0
        ;;
    "")
        usage >&2
        exit 2
        ;;
    -*)
        fail "Unknown option: $1. Use --help for usage." 2
        ;;
esac

commit_msg_file=$1

if [ ! -f "$commit_msg_file" ]; then
    fail "Commit message file does not exist or is not a regular file: $commit_msg_file" 2
fi

if [ ! -r "$commit_msg_file" ]; then
    fail "Commit message file is not readable: $commit_msg_file" 2
fi

# ------------------------------------------------------------------------------
# 2. Validate configuration
# ------------------------------------------------------------------------------

case "$MAX_SUBJECT_LENGTH" in
    ""|*[!0-9]*)
        fail "MAX_SUBJECT_LENGTH must be a positive integer." 2
        ;;
esac

# Reject zero and values with excessive leading zeroes that may be interpreted
# inconsistently by shell arithmetic implementations.
case "$MAX_SUBJECT_LENGTH" in
    0*)
        normalized_length=$(printf '%s\n' "$MAX_SUBJECT_LENGTH" | sed 's/^0*//')
        if [ -z "$normalized_length" ]; then
            fail "MAX_SUBJECT_LENGTH must be greater than zero." 2
        fi
        MAX_SUBJECT_LENGTH=$normalized_length
        ;;
esac

# Avoid shell arithmetic overflow on extremely long configuration values.
if [ "${#MAX_SUBJECT_LENGTH}" -gt 6 ]; then
    fail "MAX_SUBJECT_LENGTH is unreasonably large." 2
fi

if [ "$MAX_SUBJECT_LENGTH" -lt 1 ]; then
    fail "MAX_SUBJECT_LENGTH must be greater than zero." 2
fi

case "$VERBOSE" in
    0|1)
        ;;
    *)
        fail "VERBOSE must be either 0 or 1." 2
        ;;
esac

# ------------------------------------------------------------------------------
# 3. Extract the first non-empty, non-comment subject
#
# Ignore Git comment lines beginning with optional whitespace followed by #.
# Remove a trailing carriage return to support CRLF input.
# ------------------------------------------------------------------------------

commit_msg=$(
    awk '
        {
            sub(/\r$/, "")
        }

        /^[[:space:]]*#/ {
            next
        }

        /^[[:space:]]*$/ {
            next
        }

        {
            print
            exit
        }
    ' "$commit_msg_file"
)

if [ -z "$commit_msg" ]; then
    fail "Commit message is empty or contains only blank/comment lines." 1
fi

# ------------------------------------------------------------------------------
# 4. Validate leading and trailing whitespace
# ------------------------------------------------------------------------------

trimmed_msg=$(
    printf '%s\n' "$commit_msg" |
        sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
)

if [ "$commit_msg" != "$trimmed_msg" ]; then
    fail "The commit subject must not start or end with whitespace." 1
fi

# ------------------------------------------------------------------------------
# 5. Validate Conventional Commits format
#
# Accepted:
#   feat(auth): add email verification
#   fix(api): handle missing application ID
#   docs: update installation guide
#   chore(deps): update dependencies
#   feat(api)!: remove deprecated endpoint
#   feat!: change public API
#
# Rejected:
#   Feature(auth): add verification
#   feat(): add verification
#   feat(auth):  add verification
#   feat(auth) add verification
#   feat(auth): 
# ------------------------------------------------------------------------------

commit_pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([[:alnum:]._/-]+\))?!?: [^[:space:]].*$'

if ! printf '%s\n' "$commit_msg" | grep -Eq "$commit_pattern"; then
    cat >&2 <<'EOF'
ERROR: Invalid commit subject format.

Required format:
  type(scope): description
  type: description
  type(scope)!: description
  type!: description

Allowed types:
  feat, fix, docs, style, refactor, perf,
  test, build, ci, chore, revert

Scope characters:
  Letters, numbers, dots, underscores, slashes and hyphens.

Valid examples:
  feat(auth): add email verification
  fix(api): handle missing application ID
  docs: update installation guide
  chore(deps): update dependencies
  feat(api)!: remove deprecated endpoint
  feat!: change public API

Check that:
  - The type is supported and lowercase.
  - Scope parentheses are balanced and non-empty.
  - Exactly one ordinary space follows the colon.
  - The description does not begin with whitespace.
  - The description contains at least one letter or number.
EOF
    exit 1
fi

# ------------------------------------------------------------------------------
# 6. Extract the description and commit type
# ------------------------------------------------------------------------------

description=$(
    printf '%s\n' "$commit_msg" |
        sed 's/^[^:]*: //'
)

if [ -z "$description" ]; then
    fail "Commit description must not be empty." 1
fi

if ! printf '%s\n' "$description" | grep -Eq '[[:alnum:]]'; then
    fail "Commit description must contain at least one letter or number." 1
fi

commit_type=$(
    printf '%s\n' "$commit_msg" |
        sed 's/^\([a-z][a-z]*\).*/\1/'
)

# ------------------------------------------------------------------------------
# 7. Reject control characters
# ------------------------------------------------------------------------------

# The subject is a single extracted line. Reject embedded tabs and other
# control characters rather than allowing unusual whitespace in the subject.

if printf '%s' "$commit_msg" |
    LC_ALL=C grep -Eq '[[:cntrl:]]'; then
    fail "Commit subject contains an unsupported control character." 1
fi

# ------------------------------------------------------------------------------
# 8. Enforce subject length
#
# wc -m counts characters where supported by the active locale. Set LC_ALL
# explicitly for a consistent character-counting environment when possible.
# ------------------------------------------------------------------------------

subject_length=$(
    printf '%s' "$commit_msg" |
        LC_ALL="${LC_ALL:-}" wc -m |
        tr -d '[:space:]'
)

case "$subject_length" in
    ""|*[!0-9]*)
        fail "Could not determine the commit subject length." 1
        ;;
esac

if [ "$subject_length" -gt "$MAX_SUBJECT_LENGTH" ]; then
    error "Commit subject exceeds the maximum permitted length."
    error "Current length: $subject_length characters"
    error "Maximum length: $MAX_SUBJECT_LENGTH characters"
    exit 1
fi

# ------------------------------------------------------------------------------
# 9. Optional verbose reporting
# ------------------------------------------------------------------------------

if [ "$VERBOSE" -eq 1 ]; then
    info "Commit subject: $commit_msg"
    info "Commit type: $commit_type"
    info "Description: $description"
    info "Subject length: $subject_length characters"
fi

# ------------------------------------------------------------------------------
# 10. Report success
# ------------------------------------------------------------------------------

info "Commit message format validated."
info "Subject length: $subject_length/$MAX_SUBJECT_LENGTH characters"

exit 0
