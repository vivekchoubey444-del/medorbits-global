{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/api/schemas/colleges.shema.json",
  "title": "MedOrbits College Schema",
  "description": "Validation schema for MedOrbits college and university listings, medical colleges, engineering institutions, nursing colleges, pharmacy institutions, management colleges, and other educational providers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "slug",
    "institutionType",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Unique institution identifier generated or validated by the server."
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 250,
      "pattern": "\\S"
    },
    "shortName": {
      "type": "string",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    },
    "summary": {
      "type": "string",
      "maxLength": 1500
    },
    "institutionType": {
      "type": "string",
      "enum": [
        "university",
        "medical-college",
        "dental-college",
        "ayurvedic-college",
        "homeopathic-college",
        "unani-college",
        "nursing-college",
        "pharmacy-college",
        "engineering-college",
        "management-college",
        "law-college",
        "arts-science-college",
        "paramedical-college",
        "polytechnic",
        "vocational-institute",
        "research-institute",
        "other"
      ]
    },
    "institutionCategory": {
      "type": "string",
      "enum": [
        "government",
        "private",
        "deemed-university",
        "central-university",
        "state-university",
        "autonomous",
        "public-private-partnership",
        "other"
      ]
    },
    "ownership": {
      "type": "string",
      "enum": [
        "central-government",
        "state-government",
        "private",
        "trust",
        "society",
        "public-sector",
        "other"
      ]
    },
    "establishedYear": {
      "type": "integer",
      "minimum": 1800,
      "maximum": 2100
    },
    "affiliation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "universityName": {
          "type": "string",
          "maxLength": 250
        },
        "universityId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "affiliationNumber": {
          "type": "string",
          "maxLength": 150
        },
        "academicAffiliationStatus": {
          "type": "string",
          "enum": [
            "affiliated",
            "autonomous",
            "constituent",
            "not-applicable",
            "unverified"
          ]
        }
      }
    },
    "recognition": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authority",
          "status"
        ],
        "properties": {
          "authority": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "recognitionNumber": {
            "type": "string",
            "maxLength": 150
          },
          "status": {
            "type": "string",
            "enum": [
              "recognized",
              "approved",
              "provisional",
              "pending",
              "expired",
              "withdrawn",
              "unverified"
            ]
          },
          "validFrom": {
            "type": "string",
            "format": "date"
          },
          "validUntil": {
            "type": "string",
            "format": "date"
          },
          "verificationUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country"
      ],
      "properties": {
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "default": "India"
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "state": {
          "type": "string",
          "maxLength": 100
        },
        "stateCode": {
          "type": "string",
          "maxLength": 20
        },
        "district": {
          "type": "string",
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "addressLine1": {
          "type": "string",
          "maxLength": 250
        },
        "addressLine2": {
          "type": "string",
          "maxLength": 250
        },
        "postalCode": {
          "type": "string",
          "maxLength": 20
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "mapUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "officialEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "admissionEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 25,
          "pattern": "^[0-9+() .-]+$"
        },
        "admissionPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 25,
          "pattern": "^[0-9+() .-]+$"
        },
        "website": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "admissionWebsite": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "courses": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "level"
        ],
        "properties": {
          "courseId": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 250
          },
          "slug": {
            "type": "string",
            "maxLength": 180,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "level": {
            "type": "string",
            "enum": [
              "certificate",
              "diploma",
              "undergraduate",
              "postgraduate",
              "doctoral",
              "fellowship",
              "other"
            ]
          },
          "duration": {
            "type": "string",
            "maxLength": 100
          },
          "durationMonths": {
            "type": "integer",
            "minimum": 1,
            "maximum": 240
          },
          "eligibility": {
            "type": "string",
            "maxLength": 5000
          },
          "entranceExams": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "annualSeats": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "annualTuitionFee": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "default": "INR"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "suspended",
              "unverified"
            ],
            "default": "active"
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admissionOpen": {
          "type": "boolean",
          "default": false
        },
        "academicYear": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{4})?$"
        },
        "applicationStartDate": {
          "type": "string",
          "format": "date"
        },
        "applicationDeadline": {
          "type": "string",
          "format": "date"
        },
        "admissionProcess": {
          "type": "string",
          "maxLength": 10000
        },
        "counsellingAuthority": {
          "type": "string",
          "maxLength": 250
        },
        "counsellingUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "applicationFee": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "INR"
        },
        "requiredDocuments": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "fees": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "INR"
        },
        "annualTuitionMinimum": {
          "type": "number",
          "minimum": 0
        },
        "annualTuitionMaximum": {
          "type": "number",
          "minimum": 0
        },
        "totalCourseMinimum": {
          "type": "number",
          "minimum": 0
        },
        "totalCourseMaximum": {
          "type": "number",
          "minimum": 0
        },
        "hostelAnnualFee": {
          "type": "number",
          "minimum": 0
        },
        "otherCharges": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "amount"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "frequency": {
                "type": "string",
                "enum": [
                  "one-time",
                  "monthly",
                  "semester",
                  "annual",
                  "course-total",
                  "other"
                ]
              }
            }
          }
        },
        "feeNotes": {
          "type": "string",
          "maxLength": 5000
        },
        "lastVerifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "facilities": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 150
      }
    },
    "hostel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "separateAccommodationAvailable": {
          "type": "boolean"
        },
        "annualFeeMinimum": {
          "type": "number",
          "minimum": 0
        },
        "annualFeeMaximum": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "INR"
        },
        "description": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logoUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "coverImageUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "gallery": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        },
        "videoUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "altText": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "rankings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agency",
          "year"
        ],
        "properties": {
          "agency": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "type": "string",
            "maxLength": 150
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unverified",
            "pending-review",
            "verified",
            "rejected",
            "expired"
          ],
          "default": "unverified"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "verifiedBy": {
          "type": "string",
          "maxLength": 128
        },
        "sourceUrls": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metaTitle": {
          "type": "string",
          "maxLength": 70
        },
        "metaDescription": {
          "type": "string",
          "maxLength": 320
        },
        "keywords": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending-review",
        "published",
        "suspended",
        "rejected",
        "archived"
      ],
      "default": "draft"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "createdBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "updatedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "archivedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}