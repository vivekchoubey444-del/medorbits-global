
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/api/schemas/career.schema.json",
  "title": "MedOrbits Career Opportunity",
  "description": "Validation schema for career opportunities, jobs, internships, government vacancies, and recruitment listings on MedOrbits.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Unique career listing identifier generated by the server."
    },
    "slug": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000
    },
    "category": {
      "type": "string",
      "enum": [
        "private_job",
        "government_job",
        "internship",
        "apprenticeship",
        "fresher_job",
        "experienced_job",
        "remote_job",
        "part_time",
        "full_time",
        "contract",
        "freelance",
        "healthcare",
        "education",
        "recruitment",
        "career_guidance",
        "other"
      ]
    },
    "employmentType": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "contract",
        "temporary",
        "internship",
        "apprenticeship",
        "freelance",
        "volunteer",
        "not_applicable"
      ]
    },
    "experienceLevel": {
      "type": "string",
      "enum": [
        "student",
        "fresher",
        "entry_level",
        "junior",
        "mid_level",
        "senior",
        "manager",
        "director",
        "executive",
        "any"
      ]
    },
    "industry": {
      "type": "string",
      "enum": [
        "healthcare",
        "medical",
        "pharmaceutical",
        "biotechnology",
        "education",
        "information_technology",
        "engineering",
        "finance",
        "government",
        "hospitality",
        "manufacturing",
        "sales",
        "marketing",
        "human_resources",
        "customer_support",
        "other"
      ]
    },
    "department": {
      "type": "string",
      "maxLength": 150
    },
    "specialization": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "organization": {
      "$ref": "#/$defs/organization"
    },
    "location": {
      "$ref": "#/$defs/location"
    },
    "workArrangement": {
      "type": "string",
      "enum": [
        "on_site",
        "remote",
        "hybrid",
        "field_work",
        "flexible",
        "not_specified"
      ]
    },
    "eligibility": {
      "$ref": "#/$defs/eligibility"
    },
    "compensation": {
      "$ref": "#/$defs/compensation"
    },
    "vacancy": {
      "$ref": "#/$defs/vacancy"
    },
    "application": {
      "$ref": "#/$defs/application"
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "benefits": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "responsibilities": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "documentsRequired": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 50,
      "items": {
        "type": "string",
        "enum": [
          "resume",
          "cover_letter",
          "identity_proof",
          "educational_certificates",
          "experience_certificate",
          "portfolio",
          "registration_certificate",
          "license",
          "recommendation_letter",
          "photograph",
          "other"
        ]
      }
    },
    "applicationMethod": {
      "type": "string",
      "enum": [
        "medorbits",
        "external_website",
        "email",
        "walk_in",
        "official_portal",
        "not_applicable"
      ]
    },
    "applicationUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "maxLength": 2048
    },
    "applicationEmail": {
      "type": [
        "string",
        "null"
      ],
      "format": "email",
      "maxLength": 254
    },
    "applicationInstructions": {
      "type": "string",
      "maxLength": 10000
    },
    "applicationStartDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "applicationDeadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "selectionProcess": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "examDetails": {
      "$ref": "#/$defs/examDetails"
    },
    "governmentDetails": {
      "$ref": "#/$defs/governmentDetails"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Server-managed editorial flag."
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Server-managed verification flag. Never infer verification from submission alone."
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "published",
        "paused",
        "closed",
        "expired",
        "rejected",
        "archived"
      ],
      "default": "draft"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "unlisted",
        "private"
      ],
      "default": "public"
    },
    "seo": {
      "$ref": "#/$defs/seo"
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "closedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "updatedBy": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "metadata": {
      "type": "object",
      "maxProperties": 30,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  },
  "required": [
    "id",
    "slug",
    "title",
    "summary",
    "description",
    "category",
    "employmentType",
    "experienceLevel",
    "organization",
    "location",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "enum": [
            "private_company",
            "government_department",
            "public_sector",
            "hospital",
            "clinic",
            "college",
            "university",
            "school",
            "ngo",
            "recruitment_agency",
            "startup",
            "other"
          ]
        },
        "website": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "logoUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "verified": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "city": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "district": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "postalCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "workplaceDescription": {
          "type": "string",
          "maxLength": 1000
        },
        "isRemoteEligible": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "country"
      ]
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumAge": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 14,
          "maximum": 100
        },
        "maximumAge": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 14,
          "maximum": 100
        },
        "minimumExperienceMonths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 720,
          "default": 0
        },
        "maximumExperienceMonths": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 720
        },
        "educationLevels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "class_10",
              "class_12",
              "iti",
              "diploma",
              "undergraduate",
              "graduate",
              "postgraduate",
              "doctorate",
              "professional_degree",
              "any"
            ]
          }
        },
        "qualifications": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "requiredDegrees": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        },
        "requiredCertifications": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "requiredLicenses": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "eligibleCountries": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "eligibleStates": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "eligibleCategories": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "additionalConditions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "salary",
            "stipend",
            "hourly",
            "daily",
            "monthly",
            "annual",
            "commission",
            "unpaid",
            "not_disclosed"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code, for example INR."
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "period": {
          "type": "string",
          "enum": [
            "hour",
            "day",
            "month",
            "year",
            "project",
            "one_time",
            "not_applicable"
          ]
        },
        "negotiable": {
          "type": "boolean",
          "default": false
        },
        "includesBenefits": {
          "type": "boolean",
          "default": false
        },
        "displayText": {
          "type": "string",
          "maxLength": 250
        }
      },
      "required": [
        "type"
      ]
    },
    "vacancy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numberOfPositions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000000
        },
        "department": {
          "type": "string",
          "maxLength": 150
        },
        "jobCode": {
          "type": "string",
          "maxLength": 100
        },
        "requisitionId": {
          "type": "string",
          "maxLength": 128
        },
        "shift": {
          "type": "string",
          "enum": [
            "day",
            "night",
            "rotational",
            "flexible",
            "not_specified"
          ]
        },
        "workingDays": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          }
        },
        "hoursPerWeek": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 168
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "medorbits",
            "external_website",
            "email",
            "walk_in",
            "official_portal",
            "not_applicable"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email",
          "maxLength": 254
        },
        "startDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "instructions": {
          "type": "string",
          "maxLength": 10000
        },
        "requiresAccount": {
          "type": "boolean",
          "default": true
        },
        "allowResumeUpload": {
          "type": "boolean",
          "default": true
        },
        "allowCoverLetterUpload": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "method"
      ]
    },
    "examDetails": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "examName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "conductingAuthority": {
          "type": "string",
          "maxLength": 200
        },
        "examDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "registrationUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "syllabusUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "admitCardUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "resultUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        }
      },
      "required": [
        "examName"
      ]
    },
    "governmentDetails": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "recruitmentAuthority": {
          "type": "string",
          "maxLength": 250
        },
        "officialNotificationNumber": {
          "type": "string",
          "maxLength": 150
        },
        "officialNotificationUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "officialWebsite": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "advertisementNumber": {
          "type": "string",
          "maxLength": 150
        },
        "payLevel": {
          "type": "string",
          "maxLength": 100
        },
        "reservationPolicyReference": {
          "type": "string",
          "maxLength": 1000
        },
        "officialSourceVerifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "employer",
            "government",
            "official_portal",
            "recruitment_partner",
            "editorial",
            "user_submission",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 250
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "referenceId": {
          "type": "string",
          "maxLength": 150
        },
        "checkedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "type"
      ]
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metaTitle": {
          "type": "string",
          "maxLength": 70
        },
        "metaDescription": {
          "type": "string",
          "maxLength": 170
        },
        "canonicalUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "indexable": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
