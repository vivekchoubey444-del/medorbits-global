{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/api/schemas/career.schema.json",
  "title": "MedOrbits Career Schema",
  "description": "Validation schema for MedOrbits career opportunities, career guidance, job assistance, recruitment services, internships, apprenticeships, and professional development resources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "slug",
    "careerType",
    "description",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 250,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "maxLength": 1500
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 30000,
      "pattern": "\\S"
    },
    "careerType": {
      "type": "string",
      "enum": [
        "job",
        "government-job",
        "private-job",
        "fresher-job",
        "experienced-job",
        "internship",
        "apprenticeship",
        "fellowship",
        "scholarship",
        "career-guidance",
        "career-counselling",
        "recruitment",
        "job-assistance",
        "skill-development",
        "professional-development",
        "resume-building",
        "interview-preparation",
        "other"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "healthcare",
        "medical",
        "dental",
        "nursing",
        "pharmacy",
        "paramedical",
        "biotechnology",
        "life-sciences",
        "engineering",
        "information-technology",
        "management",
        "finance",
        "education",
        "research",
        "government",
        "administration",
        "hospitality",
        "sales",
        "marketing",
        "human-resources",
        "legal",
        "skilled-trades",
        "other"
      ]
    },
    "industry": {
      "type": "string",
      "maxLength": 150
    },
    "employmentSector": {
      "type": "string",
      "enum": [
        "government",
        "private",
        "public-sector",
        "non-profit",
        "international",
        "self-employment",
        "not-applicable",
        "other"
      ]
    },
    "experienceLevel": {
      "type": "string",
      "enum": [
        "student",
        "fresher",
        "entry-level",
        "junior",
        "mid-level",
        "senior",
        "manager",
        "executive",
        "all-levels",
        "not-applicable"
      ]
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumYears": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "maximumYears": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "acceptsFreshers": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "employer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "slug": {
          "type": "string",
          "maxLength": 180,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "organizationType": {
          "type": "string",
          "enum": [
            "government-department",
            "public-sector-enterprise",
            "private-company",
            "hospital",
            "clinic",
            "university",
            "educational-institution",
            "research-organization",
            "non-profit",
            "recruitment-agency",
            "international-organization",
            "other"
          ]
        },
        "website": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "officialNotificationUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "verified": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workMode": {
          "type": "string",
          "enum": [
            "on-site",
            "remote",
            "hybrid",
            "field-based",
            "flexible",
            "not-applicable"
          ]
        },
        "country": {
          "type": "string",
          "maxLength": 100
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "state": {
          "type": "string",
          "maxLength": 100
        },
        "district": {
          "type": "string",
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "postalCode": {
          "type": "string",
          "maxLength": 20
        },
        "address": {
          "type": "string",
          "maxLength": 500
        },
        "multipleLocations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "country": {
                "type": "string",
                "maxLength": 100
              },
              "state": {
                "type": "string",
                "maxLength": 100
              },
              "city": {
                "type": "string",
                "maxLength": 100
              },
              "locationName": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disclosed": {
          "type": "boolean",
          "default": false
        },
        "minimum": {
          "type": "number",
          "minimum": 0
        },
        "maximum": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "INR"
        },
        "period": {
          "type": "string",
          "enum": [
            "hourly",
            "daily",
            "weekly",
            "monthly",
            "annual",
            "one-time",
            "stipend",
            "unpaid",
            "not-applicable"
          ]
        },
        "salaryDescription": {
          "type": "string",
          "maxLength": 1500
        },
        "benefits": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 10000
        },
        "minimumAge": {
          "type": "integer",
          "minimum": 14,
          "maximum": 100
        },
        "maximumAge": {
          "type": "integer",
          "minimum": 14,
          "maximum": 100
        },
        "minimumEducation": {
          "type": "string",
          "enum": [
            "below-class-10",
            "class-10",
            "class-12",
            "certificate",
            "diploma",
            "undergraduate",
            "postgraduate",
            "doctoral",
            "professional-qualification",
            "any",
            "other"
          ]
        },
        "qualifications": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 250
          }
        },
        "requiredSkills": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 150
          }
        },
        "requiredExams": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 150
          }
        },
        "nationalityRequirements": {
          "type": "string",
          "maxLength": 2000
        },
        "experienceRequired": {
          "type": "boolean"
        },
        "documentsRequired": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 250
          }
        }
      }
    },
    "vacancies": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicationRequired": {
          "type": "boolean",
          "default": true
        },
        "applicationMethod": {
          "type": "string",
          "enum": [
            "official-website",
            "official-portal",
            "email",
            "in-person",
            "medorbits-referral",
            "external-platform",
            "not-applicable",
            "other"
          ]
        },
        "applicationUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "applicationEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "applicationStartDate": {
          "type": "string",
          "format": "date"
        },
        "applicationDeadline": {
          "type": "string",
          "format": "date"
        },
        "applicationFee": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "INR"
        },
        "instructions": {
          "type": "string",
          "maxLength": 10000
        },
        "externalApplication": {
          "type": "boolean",
          "default": false
        },
        "officialNotificationUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "applicationStatus": {
          "type": "string",
          "enum": [
            "not-open",
            "open",
            "closing-soon",
            "closed",
            "extended",
            "cancelled",
            "not-applicable"
          ]
        }
      }
    },
    "internship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isInternship": {
          "type": "boolean",
          "default": false
        },
        "durationWeeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 520
        },
        "paid": {
          "type": "boolean"
        },
        "stipend": {
          "type": "number",
          "minimum": 0
        },
        "certificateProvided": {
          "type": "boolean"
        },
        "academicCreditAvailable": {
          "type": "boolean"
        }
      }
    },
    "apprenticeship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isApprenticeship": {
          "type": "boolean",
          "default": false
        },
        "trade": {
          "type": "string",
          "maxLength": 200
        },
        "durationMonths": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "trainingProvider": {
          "type": "string",
          "maxLength": 250
        },
        "officialPortalUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "careerServices": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "career-counselling",
          "job-assistance",
          "recruitment-support",
          "resume-writing",
          "cover-letter-writing",
          "interview-preparation",
          "mock-interviews",
          "skill-assessment",
          "career-planning",
          "job-search-support",
          "internship-placement",
          "apprenticeship-guidance",
          "professional-development",
          "exam-guidance",
          "study-abroad-career-guidance",
          "other"
        ]
      }
    },
    "applicationCount": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "viewCount": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thumbnailUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "bannerUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "imageUrls": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        },
        "altText": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceType": {
          "type": "string",
          "enum": [
            "official-government",
            "official-employer",
            "official-institution",
            "verified-partner",
            "recruitment-agency",
            "user-submitted",
            "editorial",
            "other"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "lastVerifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "unverified",
            "pending-review",
            "verified",
            "rejected",
            "expired"
          ],
          "default": "unverified"
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metaTitle": {
          "type": "string",
          "maxLength": 70
        },
        "metaDescription": {
          "type": "string",
          "maxLength": 320
        },
        "keywords": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "indexable": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending-review",
        "published",
        "suspended",
        "rejected",
        "expired",
        "archived"
      ],
      "default": "draft"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "urgent": {
      "type": "boolean",
      "default": false
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "createdBy": {
      "type": "string",
      "maxLength": 128
    },
    "updatedBy": {
      "type": "string",
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}