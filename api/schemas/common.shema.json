
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/api/schemas/common.shema.json",
  "title": "MedOrbits Common Schema",
  "description": "Reusable JSON Schema definitions for common MedOrbits API data structures and responses.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reference": {
      "$ref": "#/$defs/reference"
    },
    "pagination": {
      "$ref": "#/$defs/pagination"
    },
    "apiError": {
      "$ref": "#/$defs/apiError"
    },
    "validationError": {
      "$ref": "#/$defs/validationError"
    },
    "apiResponse": {
      "$ref": "#/$defs/apiResponse"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "currencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "limit",
        "totalItems",
        "totalPages",
        "hasNextPage",
        "hasPreviousPage"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "totalItems": {
          "type": "integer",
          "minimum": 0
        },
        "totalPages": {
          "type": "integer",
          "minimum": 0
        },
        "hasNextPage": {
          "type": "boolean"
        },
        "hasPreviousPage": {
          "type": "boolean"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "previousCursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      }
    },
    "fieldError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "message"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rejectedValue": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "validationError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "errors"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "errors": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/fieldError"
          }
        },
        "requestId": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "apiError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "error"
      ],
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "message": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "details": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "$ref": "#/$defs/fieldError"
              }
            },
            "requestId": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "timestamp": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "apiResponse": {
      "type": "object",
      "required": [
        "success"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "data": {},
        "pagination": {
          "$ref": "#/$defs/pagination"
        },
        "timestamp": {
          "$ref": "#/$defs/dateTime"
        },
        "requestId": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "auditMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/dateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "createdBy": {
          "$ref": "#/$defs/identifier"
        },
        "updatedBy": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "recordStatus": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "active",
        "inactive",
        "published",
        "archived",
        "rejected",
        "suspended",
        "deleted",
        "expired",
        "completed",
        "cancelled"
      ]
    },
    "sortOrder": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "metadata": {
      "type": "object",
      "maxProperties": 30,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
        "maxLength": 100
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  }
}
