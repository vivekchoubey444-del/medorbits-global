{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/api/schemas/common.schema.json",
  "title": "MedOrbits Common Schema",
  "description": "Reusable JSON Schema definitions for common API identifiers, text, dates, URLs, pagination, sorting, API errors, audit metadata, and standard response envelopes.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "phone": {
      "type": "string",
      "minLength": 7,
      "maxLength": 20,
      "pattern": "^[0-9+() .-]+$"
    },
    "e164Phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nullableDateTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "currencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "Three-letter currency code. Validate supported currencies in application logic."
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Two-letter country code."
    },
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "nonNegativeAmount": {
      "type": "number",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "paginationQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "sortOrder": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "default": "desc"
        },
        "search": {
          "type": "string",
          "maxLength": 200,
          "pattern": ".*\\S.*"
        }
      }
    },
    "auditMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/dateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "createdBy": {
          "$ref": "#/$defs/identifier"
        },
        "updatedBy": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "paginationMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "limit",
        "total"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "totalPages": {
          "type": "integer",
          "minimum": 0
        },
        "hasNextPage": {
          "type": "boolean"
        },
        "hasPreviousPage": {
          "type": "boolean"
        }
      }
    },
    "apiError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Z0-9_-]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "details": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/validationError"
          }
        },
        "requestId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "validationError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "field": {
          "type": "string",
          "maxLength": 500
        },
        "keyword": {
          "type": "string",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "successResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "data"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "data": {},
        "meta": {
          "type": "object"
        },
        "requestId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "error"
      ],
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/apiError"
        },
        "requestId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "active",
        "inactive",
        "published",
        "archived",
        "approved",
        "rejected",
        "cancelled",
        "completed",
        "failed",
        "expired"
      ]
    },
    "languageCode": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "maxLength": 35
    },
    "metadata": {
      "type": "object",
      "maxProperties": 30,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "description": "Non-sensitive metadata only. Restrict keys and values according to the endpoint."
    }
  }
}