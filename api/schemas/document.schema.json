{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/api/schemas/document.schema.json",
  "title": "MedOrbits Document Schema",
  "description": "Validation schema for secure document metadata, education certificates, identity documents, admission records, employment documents, and application attachments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "documentType",
    "originalFilename",
    "mimeType",
    "sizeBytes",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Server-generated unique document identifier."
    },
    "userId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Owning user identifier. Verify ownership on every document operation."
    },
    "applicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Optional related application identifier."
    },
    "documentType": {
      "type": "string",
      "enum": [
        "PHOTO",
        "IDENTITY_PROOF",
        "PASSPORT",
        "CLASS_10_MARKSHEET",
        "CLASS_12_MARKSHEET",
        "DIPLOMA_CERTIFICATE",
        "GRADUATION_CERTIFICATE",
        "POSTGRADUATE_CERTIFICATE",
        "ENTRANCE_SCORECARD",
        "TRANSFER_CERTIFICATE",
        "MIGRATION_CERTIFICATE",
        "CATEGORY_CERTIFICATE",
        "INCOME_CERTIFICATE",
        "DOMICILE_CERTIFICATE",
        "EXPERIENCE_CERTIFICATE",
        "RESUME",
        "COVER_LETTER",
        "OFFER_LETTER",
        "PAYSLIP",
        "OTHER"
      ]
    },
    "originalFilename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\\\u0000-\\u001F\\u007F]+$",
      "description": "Original display filename only; never use it directly as a filesystem path."
    },
    "storedFilename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "description": "Server-generated storage key or filename. Do not expose internal storage paths to clients."
    },
    "mimeType": {
      "type": "string",
      "enum": [
        "application/pdf",
        "image/jpeg",
        "image/png",
        "image/webp",
        "text/plain",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ]
    },
    "extension": {
      "type": "string",
      "enum": [
        ".pdf",
        ".jpg",
        ".jpeg",
        ".png",
        ".webp",
        ".txt",
        ".doc",
        ".docx"
      ]
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 26214400,
      "description": "Document size in bytes; maximum 25 MiB."
    },
    "checksumSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$",
      "description": "Optional SHA-256 checksum calculated by the trusted server."
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "local",
            "s3",
            "azure-blob",
            "gcs",
            "other"
          ]
        },
        "objectKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Private storage object key. Never return internal keys to unauthorized clients."
        },
        "bucket": {
          "type": "string",
          "maxLength": 255
        },
        "region": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending-upload",
        "uploaded",
        "scanning",
        "available",
        "quarantined",
        "rejected",
        "pending-review",
        "approved",
        "verification-required",
        "expired",
        "deleted"
      ]
    },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uploadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "securityScan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "scanning",
            "clean",
            "infected",
            "error",
            "not-required"
          ]
        },
        "scannedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "scanner": {
          "type": "string",
          "maxLength": 100
        },
        "signatureVerified": {
          "type": "boolean"
        },
        "detectedContentType": {
          "type": "string",
          "maxLength": 150
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-required",
            "pending",
            "in-review",
            "approved",
            "rejected",
            "changes-requested"
          ]
        },
        "reviewerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reasonCode": {
          "type": "string",
          "maxLength": 100
        },
        "comments": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "issuingAuthority": {
          "type": "string",
          "maxLength": 200
        },
        "issueDate": {
          "type": "string",
          "format": "date"
        },
        "expiryDate": {
          "type": "string",
          "format": "date"
        },
        "academicYear": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{4})?$"
        },
        "documentNumberMasked": {
          "type": "string",
          "maxLength": 100,
          "description": "Masked document number only; do not store unnecessary sensitive identifiers."
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "application-reviewers",
            "organization",
            "public"
          ],
          "default": "private"
        },
        "downloadAllowed": {
          "type": "boolean",
          "default": false
        },
        "shareExpiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "createdBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "updatedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}