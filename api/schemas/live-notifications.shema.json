
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/api/schemas/live-notifications.shema.json",
  "title": "MedOrbits Live Notification",
  "description": "Validation schema for live notifications delivered by the MedOrbits platform.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Unique notification identifier generated by the server."
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Identifier used to correlate a notification with its source event."
    },
    "type": {
      "type": "string",
      "enum": [
        "system",
        "announcement",
        "admission",
        "application",
        "document",
        "payment",
        "subscription",
        "career",
        "job",
        "security",
        "account",
        "support",
        "reminder",
        "message",
        "maintenance"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "summary": {
      "type": "string",
      "maxLength": 300
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "sent",
        "delivered",
        "partially_delivered",
        "failed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Server-managed notification processing status."
    },
    "recipient": {
      "$ref": "#/$defs/recipient"
    },
    "targeting": {
      "$ref": "#/$defs/targeting"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "in_app",
          "web_push",
          "email",
          "sms"
        ]
      },
      "default": [
        "in_app"
      ]
    },
    "action": {
      "$ref": "#/$defs/action"
    },
    "media": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    },
    "readState": {
      "$ref": "#/$defs/readState"
    },
    "realtime": {
      "$ref": "#/$defs/realtime"
    },
    "schedule": {
      "$ref": "#/$defs/schedule"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "metadata": {
      "type": "object",
      "maxProperties": 30,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "description": "Non-sensitive application-defined metadata. Never store secrets or authentication tokens here."
    }
  },
  "required": [
    "id",
    "eventId",
    "type",
    "title",
    "body",
    "status",
    "recipient",
    "channels",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": [
            "student",
            "applicant",
            "counsellor",
            "consultant",
            "employer",
            "recruiter",
            "content_manager",
            "support_agent",
            "admin"
          ]
        },
        "organizationId": {
          "type": "string",
          "maxLength": 128
        }
      },
      "anyOf": [
        {
          "required": [
            "userId"
          ]
        },
        {
          "required": [
            "email"
          ]
        },
        {
          "required": [
            "role"
          ]
        },
        {
          "required": [
            "organizationId"
          ]
        }
      ]
    },
    "targeting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string",
          "enum": [
            "individual",
            "role",
            "organization",
            "segment",
            "all_users"
          ]
        },
        "userIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "student",
              "applicant",
              "counsellor",
              "consultant",
              "employer",
              "recruiter",
              "content_manager",
              "support_agent",
              "admin"
            ]
          }
        },
        "organizationIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "segment": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "audience"
      ]
    },
    "action": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "description": "Prefer approved same-origin HTTPS URLs or validated internal routes."
        },
        "route": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^/"
        },
        "resourceType": {
          "type": "string",
          "enum": [
            "application",
            "job",
            "course",
            "college",
            "document",
            "payment",
            "support_ticket",
            "announcement",
            "profile",
            "subscription"
          ]
        },
        "resourceId": {
          "type": "string",
          "maxLength": 128
        },
        "requiresAuthentication": {
          "type": "boolean",
          "default": true
        }
      },
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "route"
          ]
        },
        {
          "required": [
            "resourceType",
            "resourceId"
          ]
        }
      ]
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "image",
            "icon",
            "document"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "alt": {
          "type": "string",
          "maxLength": 250
        },
        "mimeType": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "lastAttemptAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "nextAttemptAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "deliveredAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "failedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "failureCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "failureReason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "providerMessageId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "readState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isRead": {
          "type": "boolean",
          "default": false
        },
        "readAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "isArchived": {
          "type": "boolean",
          "default": false
        },
        "archivedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "isDismissed": {
          "type": "boolean",
          "default": false
        },
        "dismissedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "isRead",
        "isArchived",
        "isDismissed"
      ]
    },
    "realtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "transport": {
          "type": "string",
          "enum": [
            "websocket",
            "server_sent_events",
            "polling"
          ],
          "default": "websocket"
        },
        "topic": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9:_-]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "deduplicationKey": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "schedule": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "sendAt": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "IANA time zone identifier, validated by application logic."
        },
        "recurrence": {
          "type": "string",
          "enum": [
            "none",
            "daily",
            "weekly",
            "monthly"
          ],
          "default": "none"
        }
      },
      "required": [
        "sendAt"
      ]
    }
  }
}
