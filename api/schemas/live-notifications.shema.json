{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/api/schemas/live-notifications.shema.json",
  "title": "MedOrbits Live Notifications Schema",
  "description": "Validates real-time notification events delivered through WebSockets, Server-Sent Events (SSE), or other authenticated live-update channels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "notification",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Unique event identifier used for deduplication."
    },
    "eventType": {
      "type": "string",
      "enum": [
        "notification.created",
        "notification.updated",
        "notification.read",
        "notification.deleted",
        "notification.delivered",
        "notification.failed",
        "notification.published",
        "notification.archived",
        "heartbeat",
        "connection.ready",
        "connection.error"
      ]
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "default": "1.0.0"
    },
    "notification": {
      "oneOf": [
        {
          "$ref": "#/$defs/notificationPayload"
        },
        {
          "type": "null"
        }
      ],
      "description": "Notification data for notification events. Connection and heartbeat events may omit it or set it to null."
    },
    "recipient": {
      "$ref": "#/$defs/recipient"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC or offset-aware timestamp indicating when the event occurred."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional monotonically increasing sequence number scoped to the relevant stream."
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    },
    "connection": {
      "$ref": "#/$defs/connection"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "description": "Non-sensitive event metadata. Do not include credentials, tokens, personal documents, or secret values."
    }
  },
  "$defs": {
    "notificationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "message",
        "type",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "\\S"
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "type": {
          "type": "string",
          "enum": [
            "system",
            "announcement",
            "admission",
            "counselling",
            "application",
            "application-status",
            "document",
            "job",
            "internship",
            "apprenticeship",
            "career",
            "course",
            "college",
            "scholarship",
            "payment",
            "security",
            "reminder",
            "maintenance",
            "other"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ],
          "default": "normal"
        },
        "read": {
          "type": "boolean",
          "default": false
        },
        "readAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "url"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Must be validated separately as an approved HTTPS URL or safe application-relative path."
            },
            "target": {
              "type": "string",
              "enum": [
                "self",
                "blank"
              ],
              "default": "self"
            }
          }
        },
        "relatedResource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceType",
            "resourceId"
          ],
          "properties": {
            "resourceType": {
              "type": "string",
              "enum": [
                "application",
                "job",
                "college",
                "course",
                "scholarship",
                "document",
                "payment",
                "user",
                "announcement",
                "other"
              ]
            },
            "resourceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "role": {
          "type": "string",
          "maxLength": 100
        },
        "channel": {
          "type": "string",
          "enum": [
            "in-app",
            "email",
            "sms",
            "push",
            "whatsapp",
            "websocket",
            "sse"
          ]
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "queued",
            "sent",
            "delivered",
            "acknowledged",
            "failed",
            "retrying"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "deliveredAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "acknowledgedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "transport": {
          "type": "string",
          "enum": [
            "websocket",
            "sse"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "connected",
            "reconnecting",
            "disconnected"
          ]
        },
        "heartbeatIntervalSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Z0-9_-]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "retryable": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}