
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/api/schemas/document.shema.json",
  "title": "MedOrbits Document Schema",
  "description": "Validates metadata for securely uploaded MedOrbits admission, education, career, recruitment, and administrative documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "documentType",
    "originalFileName",
    "storageKey",
    "mimeType",
    "fileSize",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Unique document identifier generated by the server."
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "User ID of the document owner."
    },
    "applicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "documentType": {
      "type": "string",
      "enum": [
        "PHOTO",
        "IDENTITY_PROOF",
        "ADDRESS_PROOF",
        "CLASS_10_MARKSHEET",
        "CLASS_10_CERTIFICATE",
        "CLASS_12_MARKSHEET",
        "CLASS_12_CERTIFICATE",
        "DIPLOMA_CERTIFICATE",
        "GRADUATION_MARKSHEET",
        "GRADUATION_CERTIFICATE",
        "POSTGRADUATION_CERTIFICATE",
        "ENTRANCE_SCORECARD",
        "ENTRANCE_ADMIT_CARD",
        "NEET_SCORECARD",
        "NEET_ADMIT_CARD",
        "TRANSFER_CERTIFICATE",
        "MIGRATION_CERTIFICATE",
        "CHARACTER_CERTIFICATE",
        "CATEGORY_CERTIFICATE",
        "CASTE_CERTIFICATE",
        "INCOME_CERTIFICATE",
        "DOMICILE_CERTIFICATE",
        "DISABILITY_CERTIFICATE",
        "GAP_CERTIFICATE",
        "PASSPORT",
        "RESUME",
        "CV",
        "COVER_LETTER",
        "EXPERIENCE_LETTER",
        "OFFER_LETTER",
        "APPOINTMENT_LETTER",
        "PAYMENT_RECEIPT",
        "SIGNATURE",
        "OTHER"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "originalFileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S",
      "description": "Original filename supplied by the uploader; never use it directly as a filesystem path."
    },
    "storageKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_./-]+$",
      "description": "Server-generated private storage key, not a public download URL."
    },
    "mimeType": {
      "type": "string",
      "enum": [
        "application/pdf",
        "image/jpeg",
        "image/png",
        "image/webp",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.ms-excel",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      ]
    },
    "fileExtension": {
      "type": "string",
      "enum": [
        ".pdf",
        ".jpg",
        ".jpeg",
        ".png",
        ".webp",
        ".doc",
        ".docx",
        ".xls",
        ".xlsx"
      ]
    },
    "fileSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760,
      "description": "File size in bytes. Maximum 10 MiB."
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$",
      "description": "Optional SHA-256 checksum calculated by the server."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending-upload",
        "uploaded",
        "pending-scan",
        "scanning",
        "verified",
        "rejected",
        "quarantined",
        "deleted",
        "expired"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isVerified": {
          "type": "boolean",
          "default": false
        },
        "verifiedBy": {
          "type": "string",
          "maxLength": 128
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 1000
        },
        "verificationNotes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "malwareScanStatus": {
          "type": "string",
          "enum": [
            "pending",
            "clean",
            "infected",
            "error",
            "not-scanned"
          ],
          "default": "pending"
        },
        "scannedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "encryptionAtRest": {
          "type": "boolean",
          "default": true
        },
        "sensitive": {
          "type": "boolean",
          "default": true
        },
        "retentionUntil": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "application-review",
            "admin-only"
          ],
          "default": "private"
        },
        "allowedRoles": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 30,
          "items": {
            "type": "string",
            "enum": [
              "student",
              "applicant",
              "counsellor",
              "recruiter",
              "employer",
              "reviewer",
              "admin",
              "superadmin"
            ]
          }
        },
        "downloadAllowed": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 30,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
        "maxLength": 100
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "uploadedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verifiedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
