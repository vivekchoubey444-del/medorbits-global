# ------------------------------------------------------------
# 07. ENVIRONMENT FILES
# ------------------------------------------------------------

# Templates are reviewable text files.
*.env.example   text eol=lf
.env.example    text eol=lf
.env.*.example  text eol=lf

# Do not add real secret-bearing environment files to the repository.
# Use .gitignore and secret scanning for that purpose.
# Attributes do not protect secrets or prevent them from being committed.


# ------------------------------------------------------------
# 08. PACKAGE MANAGER LOCKFILES
# ------------------------------------------------------------

package-lock.json   text eol=lf diff
npm-shrinkwrap.json text eol=lf diff
yarn.lock           text eol=lf diff
pnpm-lock.yaml      text eol=lf diff
bun.lock            text eol=lf diff

# Lockfiles intentionally remain text and diffable.
# Resolve conflicts using the relevant package manager and validate
# the resulting dependency tree. Do not use merge=ours.


