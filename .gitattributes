# ------------------------------------------------------------
# 15. GENERATED CONTENT -- TARGETED RULES ONLY
# ------------------------------------------------------------

# Uncomment only when these paths contain generated output and
# the team intentionally wants GitHub to classify them as generated.
#
# public/generated/** linguist-generated=true
# docs/api/generated/** linguist-generated=true
# src/generated/** linguist-generated=true
#
# Do not broadly classify assets, API schemas, or source files as
# generated without reviewing the repository's contribution workflow.


# ------------------------------------------------------------
# 16. DIFF AND MERGE POLICY
# ------------------------------------------------------------

# Preserve normal text diffs for source, schemas, documentation,
# configuration, and lockfiles.
#
# Avoid:
#   * merge=ours on lockfiles or security-sensitive configuration
#   * diff=off on files where changes need review
#   * export-ignore rules without release-package review
#
# Git attributes do not replace code review, secret scanning,
# file validation, or dependency security checks.


