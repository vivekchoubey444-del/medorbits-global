  "settings": {
    "enabled": false,
    "environment": "production",
    "request_timeout_ms": 15000,
    "connect_timeout_ms": 5000,
    "max_response_bytes": 5242880,
    "max_redirects": 3,
    "max_sources_per_run": 18,
    "max_records_per_source": 500,
    "max_total_records_per_run": 5000,
    "max_concurrent_sources": 3,
    "refresh_interval_minutes": 1440,
    "user_agent": "MedOrbits-Live-Source-Importer/2.0",
    "require_https": true,
    "verify_tls_certificates": true,
    "follow_redirects": true,
    "allow_unlisted_hosts": false,
    "allow_private_networks": false,
    "block_loopback_addresses": true,
    "block_link_local_addresses": true,
    "block_private_ipv4_ranges": true,
    "block_private_ipv6_ranges": true,
    "block_cloud_metadata_endpoints": true,
    "validate_dns_addresses": true,
    "revalidate_dns_on_each_request": true,
    "validate_redirect_destinations": true,
    "reject_redirect_to_different_host": true,
    "reject_url_credentials": true,
    "reject_non_standard_ports": true,
    "allowed_ports": [
      443
    ],
    "respect_robots_txt": true,
    "reject_compressed_response_over_limit": true,
    "fail_closed_on_security_validation_error": true,
    "dry_run_by_default": true
  },
  "validation": {
    "enabled": true,
    "allowed_formats": [
      "json"
    ],
    "require_json_object_or_array": true,
    "reject_empty_responses": true,
    "reject_invalid_json": true,
    "reject_unknown_categories": true,
    "require_source_attribution": true,
    "require_canonical_url": true,
    "require_stable_record_identifier": true,
    "validate_before_import": true,
    "validate_before_publication": true,
    "reject_duplicate_records": true,
    "quarantine_invalid_records": true,
    "reject_unknown_fields": false,
    "reject_html_instead_of_json": true,
    "reject_non_finite_numbers": true,
    "maximum_json_depth": 30,
    "maximum_title_length": 500,
    "maximum_description_length": 20000,
    "maximum_url_length": 2048,
    "maximum_tags_per_record": 50,
    "maximum_array_items": 5000,
    "allowed_url_schemes": [
      "https"
    ],
    "allowed_content_types": [
      "application/json",
      "application/*+json"
    ],
    "sanitize_html": true,
    "escape_output_by_default": true,
    "reject_control_characters": true,
    "require_valid_dates": true,
    "require_timezone_for_timestamps": true,
    "reject_expired_deadlines_only_when_schema_requires": true
  },
  "deduplication": {
    "enabled": true,
    "match_fields": [
      "id",
      "slug",
      "canonicalUrl",
      "url"
    ],
    "normalize_urls_before_comparison": true,
    "normalize_unicode": true,
    "trim_whitespace": true,
    "case_insensitive_slug_matching": true,
    "use_content_hash": true,
    "hash_algorithm": "sha256",
    "preserve_existing_record_ids": true,
    "update_changed_records": true,
    "delete_missing_records": false,
    "scope": "source_and_category",
    "conflict_resolution": "quarantine_for_review",
    "preserve_manual_edits": true,
    "reject_identifier_collisions": true
  },
  "publication": {
    "enabled": true,
    "mode": "review_required",
    "auto_publish": false,
    "require_human_approval": true,
    "require_verified_source": true,
    "require_validated_record": true,
    "preserve_manual_edits": true,
    "allow_imported_records_to_overwrite_manual_records": false,
    "default_status": "pending_review",
    "publish_only_after_validation": true,
    "require_approval_for_material_changes": true,
    "require_approval_for_deadline_changes": true,
    "require_approval_for_status_changes": true,
    "prevent_unverified_source_publication": true,
    "record_approver_identity": true,
    "record_approval_timestamp": true,
    "support_rollback": true,
    "never_publish_quarantined_records": true
  },
  "retry": {
    "enabled": true,
    "max_attempts": 3,
    "initial_delay_ms": 1000,
    "max_delay_ms": 30000,
    "backoff_multiplier": 2,
    "add_random_jitter": true,
    "respect_retry_after": true,
    "retry_status_codes": [
      408,
      425,
      429,
      500,
      502,
      503,
      504
    ],
    "retry_connection_errors": true,
    "retry_invalid_json": false,
    "retry_tls_errors": false,
    "retry_policy_errors": false
  },
  "rate_limit": {
    "requests_per_minute_per_host": 10,
    "minimum_delay_ms": 1000,
    "maximum_concurrent_requests_per_host": 2,
    "stop_after_repeated_rate_limits": true,
    "rate_limit_cooldown_minutes": 30,
    "maximum_consecutive_failures": 5,
    "circuit_breaker_enabled": true,
    "circuit_breaker_open_minutes": 15,
    "half_open_test_requests": 1
  },
  "change_detection": {
    "enabled": true,
    "compare_content_hash": true,
    "track_first_seen": true,
    "track_last_seen": true,
    "track_last_changed": true,
    "retain_change_history": true,
    "important_fields": [
      "title",
      "description",
      "status",
      "applicationDeadline",
      "registrationStartDate",
      "registrationEndDate",
      "examDate",
      "resultDate",
      "officialUrl"
    ],
    "notify_on_important_changes": true,
    "detect_removed_records": true,
    "mark_missing_records_inactive": false,
    "require_confirmation_before_deactivation": true,
    "ignore_volatile_fields_in_hash": [
      "lastSeenAt",
      "lastCheckedAt",
      "importedAt",
      "updatedAt"
    ]
  },
  "storage": {
    "store_raw_responses": false,
    "store_normalized_records": true,
    "store_content_hashes": true,
    "store_source_metadata": true,
    "store_request_headers": false,
    "store_response_headers_allowlist": [
      "content-type",
      "etag",
      "last-modified",
      "retry-after"
    ],
    "store_personal_data": false,
    "encrypt_sensitive_metadata_at_rest": true,
    "retention_days": 90,
    "quarantine_retention_days": 30,
    "change_history_retention_days": 365,
    "delete_expired_data_automatically": true,
    "support_conditional_requests": true,
    "use_etag_when_available": true,
    "use_last_modified_when_available": true
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "log_request_bodies": false,
    "log_response_bodies": false,
    "log_full_urls_with_query_strings": false,
    "redact_authorization_headers": true,
    "redact_cookies": true,
    "redact_tokens_and_secrets": true,
    "audit_imports": true,
    "audit_approvals": true,
    "audit_rollbacks": true,
    "alert_on_repeated_failures": true,
    "alert_on_validation_failures": true,
    "alert_on_source_domain_changes": true,
    "alert_on_redirect_policy_violations": true,
    "include_correlation_id": true,
    "include_source_id": true,
    "include_duration_ms": true,
    "include_record_counts": true,
    "never_log_personal_data": true
  },
  "monitoring": {
    "enabled": true,
    "track_source_health": true,
    "track_last_successful_import": true,
    "track_last_failed_import": true,
    "track_import_duration": true,
    "track_records_created": true,
    "track_records_updated": true,
    "track_records_unchanged": true,
    "track_records_quarantined": true,
    "track_validation_failures": true,
    "alert_on_stale_source": true,
    "stale_source_threshold_hours": 72,
    "alert_on_unexpected_record_drop": true,
    "unexpected_record_drop_threshold_percent": 50,
    "alert_on_repeated_failures": true
  },
  "security": {
    "fail_closed": true,
    "require_source_allowlist": true,
    "require_verified_source_before_enable": true,
    "validate_url_before_request": true,
    "validate_resolved_ip_before_connect": true,
    "validate_each_redirect": true,
    "prevent_dns_rebinding": true,
    "disable_automatic_redirects_when_validation_unavailable": true,
    "limit_response_size_while_streaming": true,
    "limit_decompression_ratio": true,
    "reject_malformed_content_length": true,
    "reject_unsupported_content_encoding": true,
    "protect_against_parser_resource_exhaustion": true,
    "never_execute_imported_content": true,
    "never_render_untrusted_html_without_sanitization": true,
    "never_import_credentials_from_source_records": true
  },
  "validation_rules": {
    "require_unique_source_ids": true,
    "require_unique_source_urls": true,
    "require_allowed_host_for_every_source": true,
    "require_https_for_every_source": true,
    "require_known_category_for_every_source": true,
    "require_valid_json_configuration": true,
    "reject_placeholder_hosts_in_production": true,
    "reject_enabled_unverified_sources": true,
    "reject_auto_publish_without_explicit_approval_policy": true,
    "reject_invalid_or_negative_limits": true,
    "reject_conflicting_security_settings": true
  }
}
