{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/schemas/document-analysis.schema.json",
  "title": "MedOrbits Document Analysis Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["text"],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000
    },
    "mimeType": {
      "type": "string",
      "enum": [
        "application/pdf",
        "text/plain",
        "text/markdown"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "default": "summarize"
    }
  }
}
