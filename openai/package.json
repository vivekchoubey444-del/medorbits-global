{
  "name": "@medorbits/openai-integration",
  "version": "1.0.0",
  "private": true,
  "description": "Secure server-side OpenAI integration modules for MedOrbits.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs",
  "main": "clients/openai.client.js",
  "scripts": {
    "download:openapi": "node scripts/download-openapi.js",
    "validate:openapi": "node scripts/validate-openapi.js",
    "check:version": "node scripts/check-api-version.js",
    "test": "node --test tests/*.test.js",
    "test:client": "node --test tests/openai-client.test.js",
    "test:assistant": "node --test tests/ai-assistant.test.js",
    "test:security": "node --test tests/api-security.test.js",
    "check": "npm run validate:openapi && npm test"
  },
  "dependencies": {
    "openai": "^6.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.7",
    "express-rate-limit": "^8.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0"
  }
}
