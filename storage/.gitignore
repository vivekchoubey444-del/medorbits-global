
# MedOrbits -- Runtime Storage Security
# Ignore all runtime files by default.

*

# Preserve Git ignore rules and directory placeholders.
!.gitignore
!.gitkeep
!README.md

# Preserve runtime directory structure.
!uploads/
!documents/
!applications/
!profiles/
!employer-documents/
!generated/
!exports/
!quarantine/
!backups/

# Ignore all runtime contents.
uploads/*
documents/*
applications/*
profiles/*
employer-documents/*
generated/*
exports/*
quarantine/*
backups/*

# Preserve directory placeholders.
!uploads/.gitkeep
!documents/.gitkeep
!applications/.gitkeep
!profiles/.gitkeep
!employer-documents/.gitkeep
!generated/.gitkeep
!exports/.gitkeep
!quarantine/.gitkeep
!backups/.gitkeep
