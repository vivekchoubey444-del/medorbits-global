{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "files"
  ],
  "properties": {
    "files": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "css",
              "env",
              "html",
              "js",
              "json",
              "markdown",
              "python",
              "text"
            ]
          },
          "content": {
            "type": "string"
          },
          "data": {}
        }
      }
    }
  }
}
