
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medorbits.in/schemas/local-agent/file-batch.schema.json",
  "title": "MedOrbits Local Agent File Batch",
  "description": "Validates batches of file definitions for controlled repository operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files"
  ],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:)(?!.*//)[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "css",
            "env",
            "html",
            "js",
            "json",
            "markdown",
            "python",
            "text"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 2000000
        },
        "data": {},
        "overwrite": {
          "type": "boolean",
          "default": false
        },
        "createDirectories": {
          "type": "boolean",
          "default": false
        }
      },
      "oneOf": [
        {
          "required": [
            "content"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        },
        {
          "required": [
            "data"
          ],
          "not": {
            "required": [
              "content"
            ]
          }
        }
      ]
    }
  }
}
