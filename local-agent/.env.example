
# ==============================================================================
# MedOrbits Local Agent -- Environment Configuration Template
# File: /local-agent/.env.example
# Version: 1.0.0
# Runtime: Node.js 20+
#
# Copy to .env for local development.
# Never commit real credentials or production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=MedOrbits Local Agent
APP_VERSION=1.0.0
HOST=127.0.0.1
PORT=4173
LOG_LEVEL=info
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# Repository
# ------------------------------------------------------------------------------
# Absolute path to the repository the agent is allowed to inspect.
# Leave empty to let the application determine its configured repository root.
MEDORBITS_REPO_ROOT=

# Optional agent directory relative to the repository root.
MEDORBITS_AGENT_DIR=local-agent

# Restrict operations to the configured repository root.
MEDORBITS_ENFORCE_REPO_ROOT=true

# Safe defaults: inspection and validation only.
MEDORBITS_AGENT_MODE=safe
MEDORBITS_READ_ONLY=true
MEDORBITS_ALLOW_FILE_WRITES=false
MEDORBITS_ALLOW_FILE_DELETES=false
MEDORBITS_ALLOW_SHELL_COMMANDS=false
MEDORBITS_ALLOW_REMOTE_EXECUTION=false

# ------------------------------------------------------------------------------
# HTTP API and security
# ------------------------------------------------------------------------------
# Bind to loopback for local use. Do not expose the agent publicly by default.
API_HOST=127.0.0.1
API_PORT=4173

# Set a long, random secret only if the server implementation requires it.
# Generate locally; never put a real value in this template.
SESSION_SECRET=

# Optional API token. Configure only if token authentication is implemented.
API_TOKEN=

# Comma-separated exact origins; keep localhost-only for local development.
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Enable request throttling when supported by the server.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Request limits
REQUEST_TIMEOUT_MS=30000
MAX_REQUEST_BODY_BYTES=1048576
MAX_TASK_DESCRIPTION_LENGTH=2000
MAX_CONCURRENT_TASKS=2
TASK_TIMEOUT_MS=120000

# ------------------------------------------------------------------------------
# Python tools
# ------------------------------------------------------------------------------
PYTHON_EXECUTABLE=python
PYTHON_MIN_VERSION=3.10
TOOLS_MAX_FILES=10000
TOOLS_MAX_FILE_BYTES=5000000
TOOLS_SKIP_HIDDEN_FILES=true

# ------------------------------------------------------------------------------
# AI provider
# ------------------------------------------------------------------------------
# AI is optional. Keep disabled unless the provider is configured.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_API_KEY=
AI_API_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2

# Do not send repository contents, secrets, or private documents to external
# providers unless explicitly authorized and reviewed.
AI_ALLOW_REPOSITORY_CONTEXT=false
AI_REDACT_SECRETS=true

# ------------------------------------------------------------------------------
# Ollama
# ------------------------------------------------------------------------------
OLLAMA_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# Task storage
# ------------------------------------------------------------------------------
# Supported only if implemented by the agent.
TASK_STORAGE=memory
TASK_DATA_DIR=local-agent/data
TASK_RETENTION_DAYS=7
TASK_MAX_HISTORY=500

# ------------------------------------------------------------------------------
# Logging and audit
# ------------------------------------------------------------------------------
LOG_TO_FILE=false
LOG_DIR=local-agent/logs
LOG_MAX_FILE_BYTES=5242880
LOG_MAX_FILES=5
AUDIT_ENABLED=true
AUDIT_LOG_SENSITIVE_VALUES=false

# ------------------------------------------------------------------------------
# Health and monitoring
# ------------------------------------------------------------------------------
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false
HEARTBEAT_INTERVAL_MS=15000

# ------------------------------------------------------------------------------
# Feature flags
# ------------------------------------------------------------------------------
FEATURE_TASK_PLANNER=true
FEATURE_REPOSITORY_AUDIT=true
FEATURE_SYNTAX_CHECK=true
FEATURE_SECURITY_SCAN=true
FEATURE_AI_REPAIR=false

# ------------------------------------------------------------------------------
# Production safeguards
# ------------------------------------------------------------------------------
# Keep disabled unless production deployment has been security-reviewed.
PRODUCTION_PUBLIC_BIND=false
PRODUCTION_MUTATIONS_ENABLED=false
