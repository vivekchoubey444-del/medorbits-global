
# ==============================================================================
# MedOrbits Local Agent -- Git Ignore Rules
# Version: 1.0.0
# ==============================================================================

# Environment secrets
.env
.env.*
!.env.example
!.env.*.example

# Credentials and private keys
*.pem
*.key
*.p12
*.pfx
*.keystore
credentials.json
secrets.json
service-account*.json

# Runtime logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local runtime data
data/
runtime/
tmp/
temp/
*.pid
*.pid.lock
*.seed

# Local agent state and task history
.agent-state/
.agent-cache/
.agent-runtime/
task-history.json
task-history.jsonl
agent-state.json
agent-state.json.tmp

# Generated reports and catalogs
repository-catalog.json
security-audit-report.json
validation-report.json
syntax-report.json
audit-report.json
coverage/
reports/generated/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.venv/
venv/
env/
ENV/
htmlcov/

# Node.js artifacts
node_modules/
npm-cache/
.npm/
.pnpm-store/
.nyc_output/
dist/
build/
.next/
.turbo/

# Test and coverage output
test-results/
playwright-report/
coverage-final.json
junit.xml

# Editor and operating-system files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/extensions.json

# Temporary and backup files
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*.old

# Local AI model data
models/
*.gguf
*.safetensors
*.onnx

# Database files created locally
*.sqlite
*.sqlite3
*.db

# Certificates and local TLS material
certs/
certificates/
localhost-key.pem
localhost-cert.pem

# Preserve placeholder files in otherwise-empty directories
!.gitkeep
!.gitkeep.*
!.env.example
