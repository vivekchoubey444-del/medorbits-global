{
  "name": "medorbits",
  "version": "1.0.0",
  "private": true,
  "description": "MedOrbits - Education consultancy, admissions guidance, career opportunities, recruitment and student services platform.",
  "author": "MedOrbits",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:production": "cross-env NODE_ENV=production node server.js",
    "check:node": "node --version && npm --version",
    "check:env": "node scripts/check-env.js",
    "check:security": "node scripts/security-check.js",
    "check:json": "node scripts/validate-json.js --strict",
    "check:data": "node scripts/validate-data.js assets/data",
    "data:import:universities": "node scripts/import-ugc-universities.js",
    "releases:sync": "node scripts/sync-official-releases.js",
    "releases:sync:dry-run": "node scripts/sync-official-releases.js --dry-run",
    "brand:pdfs": "node scripts/brand-pdfs.js",
    "site:autobot": "node scripts/site-autobot.js",
    "site:autobot:watch": "node scripts/site-autobot.js --watch",
    "images:mbbs": "node scripts/create-mbbs-jpeg.js",
    "check:db": "node scripts/check-db.js",
    "check:health": "node scripts/health-check.js",
    "lint": "eslint . --ignore-pattern 'tools/medorbits-local-agent/**'",
    "lint:fix": "eslint . --ignore-pattern 'tools/medorbits-local-agent/**' --fix",
    "lint:check": "eslint . --ignore-pattern 'tools/medorbits-local-agent/**' --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --passWithNoTests",
    "test:ci": "jest --coverage --runInBand --passWithNoTests tests/unit",
    "test:unit": "jest --runInBand --passWithNoTests tests/unit",
    "test:university-directory": "node --test tests/unit/public-university-directory.test.mjs",
    "test:integration": "jest --runInBand --passWithNoTests tests/integration",
    "test:api": "jest --runInBand --passWithNoTests tests/api",
    "test:database": "jest --runInBand --passWithNoTests tests/database",
    "test:security": "jest --runInBand --passWithNoTests tests/security",
    "test:e2e": "jest --runInBand --passWithNoTests tests/e2e",
    "test:accessibility": "jest --runInBand --passWithNoTests tests/accessibility",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "security:audit": "npm audit",
    "security:audit:production": "npm audit --omit=dev --audit-level=high",
    "security:audit:fix": "npm audit fix",
    "prepare": "husky || true"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "connect-mongo": "^5.1.0",
    "connect-redis": "^8.0.2",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "morgan": "^1.10.1",
    "mysql2": "^3.14.4",
    "nodemailer": "^7.0.5",
    "pdf-lib": "^1.17.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "rate-limit-redis": "^4.2.1",
    "redis": "^5.8.2",
    "rss-parser": "^3.13.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "sharp": "^0.35.4",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/?(*.)+(test|spec).js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.config.js",
      "!src/**/index.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "clearMocks": true,
    "restoreMocks": true
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf"
  }
}
