{
"name": "medorbits",
"version": "0.1.0",
"private": true,
"description": "MedOrbits -- Education, Admissions, Careers, and Recruitment",
"type": "module",
"engines": {
"node": ">=20"
},
"scripts": {
"check:json": "node scripts/check-json.mjs",
"check:json:strict": "node scripts/check-json.mjs –strict",
"check:syntax": "node –check scripts/check-json.mjs",
"check:python": "python -m pytest",
"lint:python": "python -m ruff check .",
"format:python:check": "python -m ruff format –check .",
"check": "npm run check:syntax && npm run check:json"
}
}