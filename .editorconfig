EditorConfig configuration for MedOrbits

https://editorconfig.org

Keep formatting consistent across editors, operating systems, and contributors.

root = true

Default rules for text files

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

Markdown and documentation

[*.{md,mdx,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

JavaScript and TypeScript

[*.{js,cjs,mjs,jsx,ts,tsx,mts,cts}]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true

JSON and JSON-based configuration

[*.{json,jsonc,json5,jsonld,ndjson}]
indent_style = space
indent_size = 2
end_of_line = lf

YAML configuration and workflows

[*.{yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf

HTML, templates, stylesheets, XML, and vector graphics

[*.{html,htm,xhtml,css,scss,sass,less,xml,svg}]
indent_style = space
indent_size = 2
end_of_line = lf

Shell scripts

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2
end_of_line = lf

Python

[*.{py,pyi}]
indent_style = space
indent_size = 4
end_of_line = lf

SQL and database migrations

[*.sql]
indent_style = space
indent_size = 2
end_of_line = lf

TOML, INI, and configuration files

[*.{toml,ini,conf,properties}]
indent_style = space
indent_size = 2
end_of_line = lf

Environment files

[.env*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = unset
indent_size = unset

Docker configuration

[Dockerfile]
indent_style = space
indent_size = 2
end_of_line = lf

[docker-compose.yml]
indent_style = space
indent_size = 2
end_of_line = lf

[compose.yml]
indent_style = space
indent_size = 2
end_of_line = lf

Git configuration

[.gitignore]
indent_style = space
indent_size = 2
end_of_line = lf

[.gitattributes]
indent_style = space
indent_size = 2
end_of_line = lf

Editor and tool configuration

[*.{editorconfig,prettierrc,eslintrc}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{lock}]
indent_style = space
indent_size = 2
end_of_line = lf

JSON package-manager lockfile

[package-lock.json]
indent_style = space
indent_size = 2
end_of_line = lf

Makefiles require tabs for recipe indentation

[Makefile]
indent_style = tab
end_of_line = lf
insert_final_newline = true

Windows command scripts

[*.{bat,cmd}]
end_of_line = crlf
insert_final_newline = true

PowerShell scripts

[.ps1,.psm1,*.psd1]
indent_style = space
indent_size = 2
end_of_line = crlf
insert_final_newline = true

Binary and generated assets: do not apply text-file formatting rules

[*.{jpg,jpeg,png,gif,webp,ico,pdf,zip,woff,woff2,ttf,eot,otf,mp4,webm,mp3,wav,ogg,sqlite,db,wasm}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset