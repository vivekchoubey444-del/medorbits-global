MedOrbits -- EditorConfig

Standardize formatting across editors and development environments.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,mjs,cjs,jsx,ts,tsx,json,yml,yaml,html,css,scss,md,xml,svg}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,webp,ico,pdf,zip,woff,woff2,ttf,eot}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[package-lock.json]
indent_size = 2

[*.min.{js,css}]
trim_trailing_whitespace = unset
insert_final_newline = unset